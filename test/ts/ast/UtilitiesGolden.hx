package ts.ast;

import haxe.ds.ObjectMap;
import haxe.ds.StringMap;

// TestUtilitiesGolden: replays test/ts/ast/utilities.golden.txt, written by the Go reference
// program tools/gen/ast/goref/utilref (run tools/gen/ast/goref/utilref.sh). The function tables
// are in UtilitiesGoldenTable.hx (generated by the same script, same order as the Go side):
// - every func(Kind) of utilities.go/precedence.go for Kind -1 .. KindCount+1;
// - GetOperatorPrecedence(k, k, flags 0..3) for every kind, and for the expression kinds of the
//   Go reference x every operator kind x flags 0..2;
// - every node function (func(*Node, bool.../parent) bool | int | string | *Node | []*Node) on the
//   node of every NodeFactory.New* case (same cases and arguments as factory.golden.txt), once
//   without parent ("free") and once inside Block > ExpressionStatement > node after
//   SetParentInChildren ("tree", on the node and on each direct child).
// See the header of tools/gen/ast/goref/utilref/main.go for the format.
class UtilitiesGolden {
	public static function run() {
		T.run("TestUtilitiesGolden", TestUtilitiesGolden);
	}

	static final NODE_FLAGS_ARG:NodeFlags = NodeFlagsOptionalChain | NodeFlagsLet;
	static final TOKEN_FLAGS_ARG:TokenFlags = TokenFlagsUnterminated | TokenFlagsScientific | TokenFlagsContainsInvalidEscape | TokenFlagsSingleQuote
		| TokenFlagsHexSpecifier;

	static final OPERATOR_FLAG_NODE_KINDS:Array<Kind> = [
		KindBinaryExpression, KindPrefixUnaryExpression, KindPostfixUnaryExpression, KindNewExpression, KindCallExpression,
		KindPropertyAccessExpression, KindElementAccessExpression
	];

	// mismatches per function name (or section), and the first few diffs
	static var mismatches:StringMap<Int>;
	static var mismatchOrder:Array<String>;
	static var diffs:Array<String>;
	static var compared = 0;
	static var badcasts = 0;
	static var panicsSkipped = 0;

	static function fb(b:Bool):String
		return b ? "1" : "0";

	static function fi(i:Int):String
		return Std.string(i);

	static function fs(s:String):String
		return '"' + StringTools.replace(s, "\u{FFFE}", "\\xFE") + '"';

	static function safe(f:() -> String):String {
		try {
			return f();
		} catch (e:Dynamic) {
			return "panic";
		}
	}

	// Compares one value; `run` computes the Haxe result (exceptions become "panic").
	static function compare(name:String, context:String, expected:String, run:() -> String) {
		// Go panicked in a failed As*() cast; Haxe As*() casts are unchecked (PORTING.md 3b).
		if (expected == "badcast") {
			badcasts++;
			return;
		}
		#if cpp
		// hxcpp (without HXCPP_CHECK_POINTER) does not turn a null access into an exception:
		// it crashes. Go panics are checked on JS only.
		if (expected == "panic") {
			panicsSkipped++;
			return;
		}
		#end
		final actual = safe(run);
		compared++;
		T.checks++;
		if (expected != actual) {
			if (!mismatches.exists(name)) {
				mismatches.set(name, 0);
				mismatchOrder.push(name);
			}
			mismatches.set(name, mismatches.get(name) + 1);
			if (diffs.length < 40)
				diffs.push('$name [$context] expected <$expected> actual <$actual>');
		}
	}

	static function compareNames(section:String, expected:Array<String>, actual:Array<String>) {
		T.eq(expected.length, actual.length);
		for (i in 0...(expected.length < actual.length ? expected.length : actual.length)) {
			final a = actual[i];
			compare(section, "names", expected[i], () -> a);
		}
	}

	static function TestUtilitiesGolden() {
		mismatches = new StringMap();
		mismatchOrder = [];
		diffs = [];
		compared = 0;
		badcasts = 0;
		panicsSkipped = 0;
		final lines = sys.io.File.getContent("test/ts/ast/utilities.golden.txt").split("\n");
		final kindFuncs = UtilitiesGoldenTable.kindFuncs(fb, fi);
		final kindNames = UtilitiesGoldenTable.kindFuncNames;
		final nodeNames = UtilitiesGoldenTable.nodeFuncNames;
		var nodeFuncs:Array<(Node) -> String> = null;
		var lb:ObjectMap<Node, String> = null;
		function label(n:Node):String {
			if (n == null)
				return "nil";
			final s = lb.get(n);
			return s != null ? s : "?" + n.Kind.String();
		}
		function labels(ns:Array<Node>):String {
			if (ns == null)
				return "nil";
			return "[" + [for (n in ns) label(n)].join(",") + "]";
		}
		nodeFuncs = UtilitiesGoldenTable.nodeFuncs(fb, fi, fs, label, labels);
		T.eq(nodeNames.length, nodeFuncs.length);
		T.eq(kindNames.length, kindFuncs.length);

		var caseHeader = "";
		var free:Node = null;
		var tree:Node = null;
		var treeChildren:Array<Node> = null;
		var freeLabels:ObjectMap<Node, String> = null;
		var treeLabels:ObjectMap<Node, String> = null;
		var cases = 0, kindLines = 0, opLines = 0, nodeLines = 0;

		function compareNode(n:Node, context:String, fields:Array<String>, start:Int) {
			final count = fields.length - start;
			T.eq(nodeFuncs.length, count);
			for (i in 0...nodeFuncs.length) {
				final f = nodeFuncs[i];
				compare(nodeNames[i], context, i + start < fields.length ? fields[i + start] : "<missing>", () -> f(n));
			}
			nodeLines++;
		}

		var childIndex = 0;
		for (line in lines) {
			if (line == "")
				continue;
			if (StringTools.startsWith(line, "case ")) {
				caseHeader = line;
				cases++;
				final built = buildCase(line);
				free = built.node;
				freeLabels = built.labels;
				final built2 = buildCase(line);
				tree = built2.node;
				treeLabels = built2.labels;
				final wf = Ast.NewNodeFactory(new NodeFactoryHooks());
				final stmt = wf.NewExpressionStatement(tree);
				final block = wf.NewBlock(wf.NewNodeList([stmt]), true);
				treeLabels.set(stmt, "stmt");
				treeLabels.set(block, "block");
				Ast.SetParentInChildren(block);
				treeChildren = [];
				tree.ForEachChild(function(c:Node):Bool {
					treeChildren.push(c);
					return false;
				});
				childIndex = 0;
				continue;
			}
			final fields = line.split("\t");
			switch (fields[0]) {
				case "kfuncs":
					compareNames("kfuncs", fields.slice(1), kindNames);
				case "nfuncs":
					compareNames("nfuncs", fields.slice(1), nodeNames);
				case "kind":
					final k:Kind = Std.parseInt(fields[1]);
					for (i in 0...kindFuncs.length) {
						final f = kindFuncs[i];
						compare(kindNames[i], 'kind ${fields[1]}', i + 2 < fields.length ? fields[i + 2] : "<missing>", () -> f(k));
					}
					kindLines++;
				case "opk":
					final k:Kind = Std.parseInt(fields[1]);
					for (flags in 0...4) {
						compare("GetOperatorPrecedence", 'opk ${fields[1]} $flags', fields[flags + 2],
							() -> fi(Ast.GetOperatorPrecedence(k, k, (flags : OperatorPrecedenceFlags))));
					}
					opLines++;
				case "opb":
					final nk:Kind = Std.parseInt(fields[1]);
					final flags:OperatorPrecedenceFlags = Std.parseInt(fields[2]);
					T.eq(fields.length - 3, (KindCount : Int));
					for (op in 0...(KindCount : Int)) {
						compare("GetOperatorPrecedence", 'opb ${fields[1]} ${fields[2]} $op', fields[op + 3],
							() -> fi(Ast.GetOperatorPrecedence(nk, (op : Kind), flags)));
					}
					opLines++;
				case "free":
					lb = freeLabels;
					compareNode(free, caseHeader + " free", fields, 2);
				case "tree":
					lb = treeLabels;
					if (fields[1] == "n") {
						compareNode(tree, caseHeader + " tree n", fields, 2);
					} else {
						final c = childIndex < treeChildren.length ? treeChildren[childIndex] : null;
						childIndex++;
						T.eq(fields[1], label(c));
						if (c != null)
							compareNode(c, caseHeader + " tree " + fields[1], fields, 2);
					}
				default:
					T.fail("unexpected golden line: " + line.substr(0, 80));
			}
		}
		T.isTrue(cases > 200, "cases: " + cases);
		T.isTrue(kindLines > 350, "kind lines: " + kindLines);
		T.isTrue(nodeLines > 1000, "node lines: " + nodeLines);
		if (mismatchOrder.length > 0) {
			final summary = [for (name in mismatchOrder) '$name: ${mismatches.get(name)}'].join(", ");
			T.fail('${mismatchOrder.length} functions differ from the Go reference ($compared values compared, $badcasts failed casts and $panicsSkipped panics skipped): $summary\n  '
				+ diffs.join("\n  "));
		}
	}

	// Builds the node of a factory case header (`case <New*> <param types> <kind> <bool>`) like
	// tools/gen/ast/goref/utilref (children are identifiers "c<i>" labelled by parameter).
	static function buildCase(header:String):BuiltCase {
		final h = header.split(" ");
		final name = h[1];
		final types = h[2] == "" ? [] : h[2].split(",");
		final kind:Kind = Std.parseInt(h[3]);
		final boolValue = h[4] == "1";

		final childFactory = Ast.NewNodeFactory(new NodeFactoryHooks());
		final f = Ast.NewNodeFactory(new NodeFactoryHooks());
		final lb = new ObjectMap<Node, String>();
		var counter = 0;
		function newChild(label:String):Node {
			counter++;
			final c = childFactory.NewIdentifier("c" + counter);
			lb.set(c, label);
			return c;
		}
		final args:Array<Dynamic> = [];
		for (i in 0...types.length) {
			final p = "p" + i;
			switch (types[i]) {
				case "*ast.Node":
					args.push(newChild(p));
				case "*ast.NodeList":
					final a = newChild(p + ".0");
					final b = newChild(p + ".1");
					args.push(childFactory.NewNodeList([a, b]));
				case "*ast.ModifierList":
					final m0 = childFactory.NewToken(KindExportKeyword);
					final m1 = childFactory.NewToken(KindAsyncKeyword);
					lb.set(m0, p + ".0");
					lb.set(m1, p + ".1");
					args.push(childFactory.NewModifierList([m0, m1]));
				case "[]*ast.Node":
					final a = newChild(p + ".0");
					final b = newChild(p + ".1");
					args.push(([a, b] : Array<Node>));
				case "[]string":
					args.push([p + "a", p + "b"]);
				case "string":
					args.push("s" + p);
				case "bool":
					args.push(boolValue);
				case "int":
					args.push(7);
				case "ast.Kind":
					args.push((kind : Int));
				case "ast.NodeFlags":
					args.push((NODE_FLAGS_ARG : Int));
				case "ast.TokenFlags":
					args.push((TOKEN_FLAGS_ARG : Int));
				case "any":
					args.push(null);
				default:
					throw "unhandled param type " + types[i];
			}
		}
		final node:Node = Reflect.callMethod(f, Reflect.field(f, name), args);
		lb.set(node, "n");
		return new BuiltCase(node, lb);
	}
}

private class BuiltCase {
	public final node:Node;
	public final labels:ObjectMap<Node, String>;

	public function new(node:Node, labels:ObjectMap<Node, String>) {
		this.node = node;
		this.labels = labels;
	}
}
