// Haxe AST code generator: port of upstream tsc/_scripts/generate-go-ast.ts (it emits Haxe instead of Go).
// Reads upstream/tsc/_scripts/ast.json (key order preserved) and replaces ast_generated.go,
// kind_generated.go and kind_stringer_generated.go.
//
// Run from the project root:   tools/haxe -cp tools/gen/ast --run GenAst
//
// ── Generated-file layout ────────────────────────────────────────────────────────────────────
//
//   src/ts/ast/KindGenerated.hx   whole module (kind_generated.go + kind_stringer_generated.go):
//                                 enum abstract Kind with the Go values, markers, String() and the
//                                 kind union aliases (typedef TokenSyntaxKind = Kind, ...).
//   src/ts/ast/AstGenerated.hx    whole module (types of ast_generated.go): one interface per base
//                                 struct (DeclarationBase, ...), one class per node struct
//                                 (`class Identifier extends NodeDefault`, all embedded base fields
//                                 flattened), and the typedef aliases (IdentifierNode = Node, ...).
//   src/ts/ast/Ast.hx             hand-written; the generator only rewrites the marked regions
//                                     // BEGIN GENERATED (tools/gen/ast) — do not edit: <region>
//                                     // END GENERATED: <region>
//                                 regions: "is" (class Ast: Is*() functions and kind guards),
//                                 "as" (abstract Node: As*() casts), "factory" (class NodeFactory:
//                                 New*() / Update*() methods).
//
// Re-running the generator is idempotent: whole modules are rewritten with the same content and
// only the regions of Ast.hx change.
//
// ── Node model (see src/ts/ast/Ast.hx header) ────────────────────────────────────────────────
//
// Go embeds `Node` in every node data struct and calls the data through the `nodeData`
// interface. Here a node is ONE object: class NodeDefault holds the Go Node fields and the
// NodeDefault methods (the virtual nodeData methods), each node data struct is a subclass, and
// `Node` is an abstract over NodeDefault that carries the Go *Node methods (their names clash
// with data field names such as Expression, Type, Body).
//
// Go method promotion is resolved here: for each node class and each method that Ast.hx
// implements for a Go struct type `T` as `static function T_method(node:T, ...)` (the hand-written
// methods of ast.go), the generator finds the method Go would promote into the node struct
// (shallowest embedding depth wins; NodeDefault sits below NodeBase) and emits a delegating
// method (`override` when NodeDefault declares it). Generated methods (ForEachChild,
// VisitEachChild, Clone, computeSubtreeFacts, Name) sit at depth 0 like in Go.
//
// Go struct embedding is flattened: every field of every embedded base becomes a field of the
// node class. Fields that belong to a base struct are properties (inline get/set) so the base
// interfaces can expose them (Haxe interface vars are dynamic field accesses on hxcpp).

import Schema;
import sys.io.File;

using StringTools;

class FieldInfo {
	public final name:String;
	public final hxType:String;
	public final origin:String; // struct that declares the field
	public final depth:Int;

	public function new(name, hxType, origin, depth) {
		this.name = name;
		this.hxType = hxType;
		this.origin = origin;
		this.depth = depth;
	}
}

class HandMethod {
	public final typeName:String;
	public final method:String;
	public final params:String; // without the receiver
	public final args:String;
	public final ret:String;

	public function new(typeName, method, params, args, ret) {
		this.typeName = typeName;
		this.method = method;
		this.params = params;
		this.args = args;
		this.ret = ret;
	}
}

class CodeWriter {
	final lines:Array<String> = [];
	var indent = 0;

	public function new() {}

	public function write(line:String = "") {
		if (line == "")
			lines.push("");
		else
			lines.push([for (_ in 0...indent) "\t"].join("") + line);
	}

	public function push()
		indent++;

	public function pop()
		indent--;

	public function toString():String
		return lines.join("\n");
}

class GenAst {
	static inline final ROOT_AST_JSON = "upstream/tsc/_scripts/ast.json";
	static inline final OUT_DIR = "src/ts/ast/";
	static inline final HEADER = "// Code generated by tools/gen/ast/GenAst.hx from upstream tsc/_scripts/ast.json. DO NOT EDIT.";

	static var api:SchemaAPI;
	static var handMethods:Map<String, Array<HandMethod>>; // Go type name -> hand-written methods
	static var virtualMethods:Map<String, Bool>; // methods declared by NodeDefault
	static var kindLike:Map<String, Bool>; // Haxe types whose zero value is 0
	static var report:Array<String> = [];

	static final HAXE_KEYWORDS = [
		"abstract", "break", "case", "cast", "catch", "class", "continue", "default", "do", "dynamic", "else", "enum", "extends", "extern", "false",
		"final", "for", "function", "if", "implements", "import", "in", "inline", "interface", "is", "macro", "new", "null", "operator", "overload",
		"override", "package", "private", "public", "return", "static", "switch", "this", "throw", "true", "try", "typedef", "untyped", "using",
		"var", "while"
	];

	static function main() {
		final root = switch (JsonParser.parse(File.getContent(ROOT_AST_JSON))) {
			case JObj(o): o;
			default: throw "bad ast.json";
		}
		api = new SchemaAPI(root);
		kindLike = new Map();
		for (k in ["Kind", "NodeFlags", "TokenFlags", "ModifierFlags", "SubtreeFacts", "Int"])
			kindLike.set(k, true);
		for (a in api.kindAliases())
			kindLike.set(a.name, true);

		final astPath = OUT_DIR + "Ast.hx";
		var astSrc = File.getContent(astPath);
		scanHandWritten(astSrc);

		writeIfChanged(OUT_DIR + "KindGenerated.hx", generateKind());
		writeIfChanged(OUT_DIR + "AstGenerated.hx", generateNodes());

		astSrc = replaceRegion(astSrc, "is", generateIsRegion());
		astSrc = replaceRegion(astSrc, "as", generateAsRegion());
		astSrc = replaceRegion(astSrc, "factory", generateFactoryRegion());
		writeIfChanged(astPath, astSrc);

		for (r in report)
			Sys.println(r);
	}

	static function writeIfChanged(path:String, content:String) {
		final old = sys.FileSystem.exists(path) ? File.getContent(path) : null;
		if (old != content) {
			File.saveContent(path, content);
			Sys.println('wrote $path');
		} else {
			Sys.println('unchanged $path');
		}
	}

	// ── Hand-written input ───────────────────────────────────────────────────────────────────

	static function scanHandWritten(src:String) {
		handMethods = new Map();
		final known = new Map<String, Bool>();
		for (n in api.nodes())
			known.set(n.name, true);
		for (b in api.bases())
			known.set(b.name, true);
		final re = ~/^\t(?:public )?static function ([A-Z][A-Za-z0-9]*)_([A-Za-z][A-Za-z0-9]*)\(node:([A-Za-z0-9]+)(.*)\):([A-Za-z0-9<>]+) \{$/;
		final loose = ~/static function ([A-Z][A-Za-z0-9]*)_([A-Za-z][A-Za-z0-9]*)\(/;
		for (line in src.split("\n")) {
			if (!re.match(line)) {
				if (loose.match(line) && known.exists(loose.matched(1)))
					throw 'hand-written method not in the expected form `\tpublic static function T_m(node:T, ...):R {`: $line';
				continue;
			}
			final typeName = re.matched(1);
			if (!known.exists(typeName))
				continue;
			if (re.matched(3) != typeName)
				throw 'receiver type of ${typeName}_${re.matched(2)} must be $typeName';
			var rest = re.matched(4); // ", a:T, b:U"
			final params = rest.startsWith(", ") ? rest.substr(2) : "";
			final args = params == "" ? "" : [for (p in params.split(", ")) p.split(":")[0]].join(", ");
			var list = handMethods.get(typeName);
			if (list == null)
				handMethods.set(typeName, list = []);
			list.push(new HandMethod(typeName, re.matched(2), params, args, re.matched(5)));
		}
		// Virtual methods = methods of class NodeDefault (Go NodeDefault / nodeData interface).
		virtualMethods = new Map();
		final start = src.indexOf("\nclass NodeDefault ");
		if (start < 0)
			throw "class NodeDefault not found in Ast.hx";
		final end = src.indexOf("\n}", start);
		final mre = ~/^\tpublic function ([A-Za-z][A-Za-z0-9]*)\(/;
		for (line in src.substring(start, end).split("\n"))
			if (mre.match(line))
				virtualMethods.set(mre.matched(1), true);
	}

	static function replaceRegion(src:String, name:String, content:String):String {
		final beginMarker = '// BEGIN GENERATED (tools/gen/ast) — do not edit: $name';
		final endMarker = '// END GENERATED: $name';
		final b = src.indexOf(beginMarker);
		final e = src.indexOf(endMarker);
		if (b < 0 || e < 0 || e < b)
			throw 'region $name not found in Ast.hx';
		final lineStart = src.lastIndexOf("\n", b) + 1;
		final indent = src.substring(lineStart, b);
		final bodyStart = src.indexOf("\n", b) + 1;
		final endLineStart = src.lastIndexOf("\n", e) + 1;
		final lines = content.split("\n");
		final body = [for (l in lines) l == "" ? "" : indent + l].join("\n");
		return src.substring(0, bodyStart) + body + "\n" + src.substring(endLineStart);
	}

	// ── Type mapping ─────────────────────────────────────────────────────────────────────────

	// Go type reference (formatGoReference / goOnly raw type) → Haxe type.
	static function hx(goRef:String):String {
		if (goRef.startsWith("[]"))
			return 'Array<${hx(goRef.substr(2))}>';
		if (goRef.startsWith("*"))
			goRef = goRef.substr(1);
		return switch (goRef) {
			case "string": "String";
			case "bool" | "boolean": "Bool";
			case "int": "Int";
			case "atomic.Uint32": "Int";
			case "any": "Any";
			default: goRef;
		}
	}

	static function zero(hxType:String):String {
		if (kindLike.exists(hxType))
			return "0";
		return switch (hxType) {
			case "Bool": "false";
			case "String": '""';
			default: "null";
		}
	}

	static function ident(n:String):String
		return HAXE_KEYWORDS.indexOf(n) >= 0 ? n + "_" : n;

	static function param(m:MemberInfo):String
		return ident(m.goParamName());

	static function memberHxType(m:MemberInfo):String
		return hx(m.type.formatGoReference());

	// Members that participate in factory/visitor/clone (excludes noFactory)
	static function schemaMembers(node:NodeType):Array<MemberInfo>
		return [for (m in node.members) if (!m.noFactory) m];

	static function isTextContentType(type:SType):Bool {
		if (type.kind == "primitive")
			return (cast type : PrimitiveType).name == "string";
		if (type.kind == "list") {
			final l:ListType = cast type;
			return l.listKind == "raw" && l.elementType.kind == "primitive" && (cast l.elementType : PrimitiveType).name == "string";
		}
		return false;
	}

	static function hasTextContent(node:NodeType):Bool {
		if (node.members.length == 0)
			return false;
		return Lambda.exists(schemaMembers(node), m -> isTextContentType(m.type));
	}

	static function isNodeFlagsMember(m:MemberInfo):Bool {
		final t = m.type;
		return t.kind == "primitive" && (cast t : PrimitiveType).name == "NodeFlags";
	}

	// ── Struct layout (Go embedding) ─────────────────────────────────────────────────────────

	// Own fields of a struct (node or base), in Go declaration order, with their Go reference type.
	static function ownFields(t:NodeType):Array<{name:String, goType:String}> {
		final r = [];
		if (t.def != null) {
			for (m in t.members) {
				if (m.inherited || m.isKindParam() || m.noGo)
					continue;
				r.push({name: m.name, goType: m.goOnly ? SchemaAPI.s(m.rawType) : m.type.formatGoReference()});
			}
		} else if (t.name != "NodeBase") {
			for (f in t.fields) {
				if (f.noGo)
					continue;
				r.push({name: f.name, goType: f.goOnly ? SchemaAPI.s(f.rawType) : f.type.formatGoReference()});
			}
		}
		return r;
	}

	// All fields reachable through embedding (flattened), in Go struct order; for a name that is
	// reachable more than once, the shallowest occurrence wins (Go field selection).
	static function flattenFields(t:NodeType, notes:Array<String>):Array<FieldInfo> {
		final all:Array<FieldInfo> = [];
		function walk(s:NodeType, depth:Int) {
			for (ext in s.extendsKeys)
				walk(api.nodeType(ext), depth + 1);
			for (f in ownFields(s))
				all.push(new FieldInfo(f.name, hx(f.goType), s.name, depth));
		}
		walk(t, 0);
		final byName = new Map<String, Array<FieldInfo>>();
		final order:Array<String> = [];
		for (f in all) {
			if (!byName.exists(f.name)) {
				byName.set(f.name, []);
				order.push(f.name);
			}
			byName.get(f.name).push(f);
		}
		final r = [];
		for (n in order) {
			final occ = byName.get(n);
			var best = occ[0];
			for (f in occ)
				if (f.depth < best.depth)
					best = f;
			if (occ.length > 1) {
				final origins = [for (f in occ) '${f.origin}@${f.depth}'];
				notes.push('PORT: Go embeds ${occ.length} copies of field $n (${origins.join(", ")}, struct@depth); flattened to one field (upstream reads it only through DeclarationData() / Symbol()).');
			}
			r.push(best);
		}
		return r;
	}

	// Go method promotion: returns the struct type that provides `method` to node `t`, or null if
	// NodeDefault provides it (or nobody does).
	static function resolveMethod(t:NodeType, method:String, generated:Map<String, Bool>):Null<String> {
		// Breadth-first over the embedding tree; NodeBase embeds NodeDefault.
		var level:Array<String> = [t.name];
		var depth = 0;
		while (level.length > 0) {
			final providers:Array<String> = [];
			for (s in level) {
				if (s == "NodeDefault") {
					if (virtualMethods.exists(method))
						providers.push(s);
					continue;
				}
				if (depth == 0 && generated.exists(method)) {
					providers.push(s);
					continue;
				}
				final hm = handMethods.get(s);
				if (hm != null && Lambda.exists(hm, m -> m.method == method))
					providers.push(s);
			}
			if (providers.length == 1)
				return providers[0] == "NodeDefault" ? null : providers[0];
			if (providers.length > 1) {
				if (virtualMethods.exists(method))
					throw 'ambiguous promotion of $method in ${t.name}: ${providers.join(", ")}';
				return null;
			}
			final next = [];
			for (s in level) {
				if (s == "NodeDefault")
					continue;
				if (s == "NodeBase") {
					next.push("NodeDefault");
					continue;
				}
				for (ext in api.nodeType(s).extendsKeys)
					next.push(ext);
			}
			level = next;
			depth++;
		}
		return null;
	}

	static function generatedMethods(node:NodeType):Map<String, Bool> {
		final g = new Map<String, Bool>();
		g.set("Clone", true);
		if (Lambda.exists(schemaMembers(node), m -> m.isChild())) {
			g.set("ForEachChild", true);
			g.set("VisitEachChild", true);
		}
		if (node.generateSubtreeFacts)
			g.set("computeSubtreeFacts", true);
		final nameMember = Lambda.find(schemaMembers(node), m -> m.name == "name");
		if (nameMember != null && nameMember.isPrivate)
			g.set("Name", true);
		return g;
	}

	// ── Kind ─────────────────────────────────────────────────────────────────────────────────

	static function generateKind():String {
		final w = new CodeWriter();
		w.write(HEADER);
		w.write("// Replaces kind_generated.go and kind_stringer_generated.go.");
		w.write("");
		w.write("package ts.ast;");
		w.write("");
		w.write("// PORT: Go `type Kind int16` → enum abstract over Int with the Go values.");
		w.write("enum abstract Kind(Int) from Int to Int {");
		w.push();
		w.write("@:op(A < B) static function lt(a:Kind, b:Kind):Bool;");
		w.write("@:op(A <= B) static function lte(a:Kind, b:Kind):Bool;");
		w.write("@:op(A > B) static function gt(a:Kind, b:Kind):Bool;");
		w.write("@:op(A >= B) static function gte(a:Kind, b:Kind):Bool;");
		w.write("");
		final elements = api.kindElements();
		final markers = api.kindMarkers();
		final names:Array<String> = [];
		var value = 0;
		for (el in elements) {
			if (el.name == null) {
				w.write('// ${el.comment}');
				continue;
			}
			final trailing = el.comment != null ? ' // ${el.comment}' : "";
			w.write('var Kind${el.name} = $value;$trailing');
			names.push('Kind${el.name}');
			value++;
		}
		w.write('var KindCount = $value;');
		names.push("KindCount");
		for (m in markers)
			w.write('var Kind${m.name} = Kind${m.value};');
		w.write("");
		w.write("// --- kind_stringer_generated.go ---");
		w.write("");
		w.write("static final _Kind_name:Array<String> = [");
		w.push();
		for (n in names)
			w.write('"$n",');
		w.pop();
		w.write("];");
		w.write("");
		w.write("public function String():String {");
		w.push();
		w.write("final i:Int = this;");
		w.write("if (i < 0 || i >= _Kind_name.length) {");
		w.push();
		w.write('return "Kind(" + Std.string(i) + ")";');
		w.pop();
		w.write("}");
		w.write("return _Kind_name[i];");
		w.pop();
		w.write("}");
		w.write("");
		w.write("// PORT: for string interpolation and debugging.");
		w.write("public inline function toString():String {");
		w.push();
		w.write("return String();");
		w.pop();
		w.write("}");
		w.pop();
		w.write("}");
		w.write("");
		// Kind union aliases
		for (a in api.kindAliases()) {
			function expand(ms:Array<String>):Array<String> {
				var r = [];
				for (m in ms) {
					final al = api.getKindAlias(m);
					if (al != null)
						r = r.concat(expand(al.members));
					else
						r.push(m);
				}
				return r;
			}
			w.write('typedef ${a.name} = Kind; // ${[for (m in expand(a.members)) 'Kind$m'].join(" | ")}');
		}
		return w.toString() + "\n";
	}

	// ── Nodes module ─────────────────────────────────────────────────────────────────────────

	static function generateNodes():String {
		final w = new CodeWriter();
		w.write(HEADER);
		w.write("// Replaces the types of ast_generated.go (factory methods: Ast.hx region \"factory\").");
		w.write("");
		w.write("package ts.ast;");
		w.write("");
		w.write("// ──────────────────────────────────────────────────────────────────────");
		w.write("// Base struct interfaces");
		w.write("// ──────────────────────────────────────────────────────────────────────");
		w.write("");
		w.write("// PORT: a Go base struct (embedded in node data structs) → interface with one property per");
		w.write("// field; the node classes implement the interfaces of the bases they embed.");
		for (base in api.bases()) {
			if (base.name == "NodeBase")
				continue;
			final exts = [for (e in base.extendsKeys) if (e != "NodeBase") e];
			final ext = exts.length > 0 ? " extends " + exts.join(" extends ") : "";
			final fields = ownFields(base);
			if (fields.length == 0) {
				w.write('interface ${base.name}$ext {}');
			} else {
				w.write('interface ${base.name}$ext {');
				w.push();
				for (f in fields)
					w.write('var ${f.name}(get, set):${hx(f.goType)};');
				w.pop();
				w.write("}");
			}
			w.write("");
		}

		// Node type aliases
		w.write("// ──────────────────────────────────────────────────────────────────────");
		w.write("// Node type aliases");
		w.write("// ──────────────────────────────────────────────────────────────────────");
		w.write("");
		for (node in api.nodes())
			w.write('typedef ${node.name}Node = Node;');
		for (node in api.nodes())
			for (alias in node.instantiationAliases())
				w.write('typedef ${alias.name} = Node;');
		w.write("");
		for (la in api.listAliases())
			w.write('typedef ${la.name} = NodeList; // NodeList[*${la.elementTypeName()}]');
		w.write("");
		w.write("// ──────────────────────────────────────────────────────────────────────");
		w.write("// Node union aliases");
		w.write("// ──────────────────────────────────────────────────────────────────────");
		w.write("");
		for (alias in api.nodeAliases()) {
			var comment = "";
			if (alias.isBaseAlias() && alias.baseKey() != null)
				comment = 'Node with ${alias.baseKey()}';
			else if (alias.isUnion())
				comment = alias.unionMemberNames().join(" | ");
			w.write('typedef ${alias.name} = Node;${comment != "" ? ' // $comment' : ""}');
		}
		w.write("");

		for (node in api.nodes()) {
			if (node.handWritten)
				continue;
			w.write("// ──────────────────────────────────────────────────────────────────────");
			w.write('// ${node.name}');
			w.write("// ──────────────────────────────────────────────────────────────────────");
			w.write("");
			generateClass(w, node);
		}
		return w.toString() + "\n";
	}

	static function generateClass(w:CodeWriter, node:NodeType) {
		final exts = [for (e in node.extendsKeys) if (e != "NodeBase") e];
		final impl = [for (e in exts) ' implements $e'].join("");
		final notes = [];
		final fields = flattenFields(node, notes);
		for (n in notes)
			w.write('// $n');
		w.write('class ${node.name} extends NodeDefault$impl {');
		w.push();
		for (f in fields) {
			if (f.origin == node.name) {
				w.write('public var ${f.name}:${f.hxType} = ${zero(f.hxType)};');
			} else {
				w.write('@:isVar public var ${f.name}(get, set):${f.hxType} = ${zero(f.hxType)};');
			}
		}
		for (f in fields) {
			if (f.origin != node.name) {
				w.write('inline function get_${f.name}():${f.hxType} return ${f.name};');
				w.write('inline function set_${f.name}(v:${f.hxType}):${f.hxType} return ${f.name} = v;');
			}
		}
		w.write("");
		w.write("public function new() {");
		w.push();
		w.write("super();");
		w.pop();
		w.write("}");
		w.write("");
		generateForEachChild(w, node);
		generateVisitEachChild(w, node);
		generateClone(w, node);
		generateSubtreeFacts(w, node);
		generateNameAccessor(w, node);
		generatePromoted(w, node);
		w.pop();
		w.write("}");
		w.write("");
	}

	static function generateForEachChild(w:CodeWriter, node:NodeType) {
		final childMembers = [for (m in schemaMembers(node)) if (m.isChild()) m];
		if (childMembers.length == 0)
			return;
		w.write("override public function ForEachChild(v:Visitor):Bool {");
		w.push();
		if (node.handWrittenVisitor) {
			w.write('return Ast.forEachChild_${node.name}(this, v);');
		} else {
			final parts = [
				for (m in childMembers) {
					final access = 'this.${m.name}';
					switch (m.listKind) {
						case "raw": 'Ast.visitNodes(v, $access)';
						case "ModifierList": 'Ast.visitModifiers(v, $access)';
						case "NodeList": 'Ast.visitNodeList(v, $access)';
						default: 'Ast.visit(v, $access)';
					}
				}
			];
			if (parts.length <= 3) {
				w.write('return ${parts.join(" || ")};');
			} else {
				w.write('return ${parts[0]}');
				for (i in 1...parts.length - 1)
					w.write('\t|| ${parts[i]}');
				w.write('\t|| ${parts[parts.length - 1]};');
			}
		}
		w.pop();
		w.write("}");
		w.write("");
	}

	static function generateVisitEachChild(w:CodeWriter, node:NodeType) {
		final members = schemaMembers(node);
		if (!Lambda.exists(members, m -> m.isChild()))
			return;
		w.write("override public function VisitEachChild(v:NodeVisitor):Node {");
		w.push();
		if (node.handWrittenVisitor) {
			w.write('return Ast.visitEachChild_${node.name}(this, v);');
			w.pop();
			w.write("}");
			w.write("");
			return;
		}
		final updateMembers = [for (m in members) if (!m.isKindParam()) m];
		final rawListLocals = new Map<String, String>();
		for (m in updateMembers) {
			final t = m.type;
			if (m.isChild() && t.kind == "list" && (cast t : ListType).listKind == "raw") {
				final local = param(m);
				rawListLocals.set(m.name, local);
				w.write('final $local = Core.SameMap(this.${m.name}, (n:Node) -> v.visitNode(n));');
			}
		}
		final args = [
			for (m in updateMembers) {
				if (!m.isChild()) {
					'this.${m.name}';
				} else if (rawListLocals.exists(m.name)) {
					rawListLocals.get(m.name);
				} else {
					final access = 'this.${m.name}';
					final t = m.type;
					if (m.visit != null)
						'v.visit${api.capitalize(m.visit)}($access)';
					else if (m.listKind == "ModifierList")
						'v.visitModifiers($access)';
					else if (m.listKind == "NodeList")
						'v.visitNodes($access)';
					else if (t.kind == "primitive" && (cast t : PrimitiveType).name == "Token")
						'v.visitToken($access)';
					else
						'v.visitNode($access)';
				}
			}
		];
		w.write('return v.Factory.Update${node.name}(this, ${args.join(", ")});');
		w.pop();
		w.write("}");
		w.write("");
	}

	static function generateClone(w:CodeWriter, node:NodeType) {
		final members = schemaMembers(node);
		w.write("override public function Clone(f:NodeFactoryCoercible):Node {");
		w.push();
		final args = [
			for (m in members) {
				if (m.isKindParam()) {
					"this.Kind";
				} else {
					final dt = m.declaredType;
					if (m.inherited && dt.kind == "alias" && (cast dt : AliasType).name == "ModifierLike")
						"this.Modifiers()";
					else
						'this.${m.name}';
				}
			}
		].join(", ");
		if (node.kindAliases.length > 0) {
			w.write("switch (this.Kind) {");
			w.push();
			w.write('case ${api.kindType('SyntaxKind.${node.syntaxKindName}').formatGoConstant()}:');
			w.push();
			w.write('return Ast.cloneNode(f.AsNodeFactory().New${node.name}($args), this.AsNode(), f.AsNodeFactory().hooks);');
			w.pop();
			for (alias in node.kindAliases) {
				w.write('case Kind$alias:');
				w.push();
				w.write('return Ast.cloneNode(f.AsNodeFactory().New$alias($args), this.AsNode(), f.AsNodeFactory().hooks);');
				w.pop();
			}
			w.write("default:");
			w.push();
			w.write('throw "unexpected kind in ${node.name}.Clone: " + this.Kind.String();');
			w.pop();
			w.pop();
			w.write("}");
		} else {
			w.write('return Ast.cloneNode(f.AsNodeFactory().New${node.name}($args), this.AsNode(), f.AsNodeFactory().hooks);');
		}
		w.pop();
		w.write("}");
		w.write("");
	}

	static function subtreeFactsTerm(m:MemberInfo):String {
		final access = 'this.${m.name}';
		if (m.listKind == "ModifierList")
			return 'Ast.propagateModifierListSubtreeFacts($access)';
		if (m.type.kind == "list")
			return 'Ast.propagateNodeListSubtreeFacts($access, Ast.propagateSubtreeFactsFunc)';
		return 'Ast.propagateSubtreeFacts($access)';
	}

	static function generateSubtreeFacts(w:CodeWriter, node:NodeType) {
		if (!node.generateSubtreeFacts)
			return;
		final childMembers = [for (m in schemaMembers(node)) if (m.isChild()) m];
		w.write("override public function computeSubtreeFacts():SubtreeFacts {");
		w.push();
		if (childMembers.length == 0) {
			w.write("return SubtreeFactsNone;");
		} else {
			for (i in 0...childMembers.length) {
				final term = subtreeFactsTerm(childMembers[i]);
				final last = i == childMembers.length - 1;
				if (i == 0)
					w.write('return $term${last ? ";" : ""}');
				else
					w.write('\t| $term${last ? ";" : ""}');
			}
		}
		w.pop();
		w.write("}");
		w.write("");
	}

	static function generateNameAccessor(w:CodeWriter, node:NodeType) {
		final nameMember = Lambda.find(schemaMembers(node), m -> m.name == "name");
		if (nameMember == null || !nameMember.isPrivate)
			return;
		w.write("override public function Name():DeclarationName {");
		w.push();
		w.write("return this.name;");
		w.pop();
		w.write("}");
		w.write("");
	}

	// Delegations for hand-written methods (Ast.T_method) that Go promotes into this node struct.
	static function generatePromoted(w:CodeWriter, node:NodeType) {
		final generated = generatedMethods(node);
		final candidates = new Map<String, HandMethod>();
		final order:Array<String> = [];
		function collect(s:String) {
			final hm = handMethods.get(s);
			if (hm != null)
				for (m in hm)
					if (!candidates.exists(m.method)) {
						candidates.set(m.method, m);
						order.push(m.method);
					}
			if (s != "NodeBase")
				for (ext in api.nodeType(s).extendsKeys)
					collect(ext);
		}
		collect(node.name);
		order.sort((a, b) -> a < b ? -1 : a > b ? 1 : 0);
		for (method in order) {
			final provider = resolveMethod(node, method, generated);
			if (provider == null || (provider == node.name && generated.exists(method)))
				continue;
			final hm = Lambda.find(handMethods.get(provider), m -> m.method == method);
			final ov = virtualMethods.exists(method) ? "override " : "";
			final args = hm.args == "" ? "this" : 'this, ${hm.args}';
			final ret = hm.ret == "Void" ? "" : "return ";
			w.write('${ov}public function ${method}(${hm.params}):${hm.ret} {');
			w.push();
			w.write('${ret}Ast.${provider}_$method($args);');
			w.pop();
			w.write("}");
			w.write("");
		}
	}

	// ── Ast.hx regions ───────────────────────────────────────────────────────────────────────

	static function generateIsRegion():String {
		final w = new CodeWriter();
		w.write("// --- ast_generated.go: Is*() type guards ---");
		w.write("");
		for (node in api.nodes())
			generateIsFunction(w, node);
		w.write("// --- ast_generated.go: kind alias guards ---");
		w.write("");
		generateKindAliasGuards(w);
		return w.toString().trim();
	}

	static function generateIsFunction(w:CodeWriter, node:NodeType) {
		final kindTypes = node.kindTypes();
		if (node.kindType.kind == "typeParameter") {
			w.write('public static function Is${node.name}(node:Node):Bool {');
			w.push();
			w.write("switch (node.Kind) {");
			w.push();
			w.write('case ${[for (k in kindTypes) k.formatGoConstant()].join(" | ")}:');
			w.push();
			w.write("return true;");
			w.pop();
			w.write("default:");
			w.pop();
			w.write("}");
			w.write("return false;");
			w.pop();
			w.write("}");
			w.write("");
			return;
		}
		if (node.isMultiKind()) {
			for (kind in kindTypes) {
				w.write('public static function Is${kind.name}(node:Node):Bool {');
				w.push();
				w.write('return node.Kind == ${kind.formatGoConstant()};');
				w.pop();
				w.write("}");
				w.write("");
			}
			return;
		}
		w.write('public static function Is${node.name}(node:Node):Bool {');
		w.push();
		w.write('return node.Kind == ${api.kindType('SyntaxKind.${node.syntaxKindName}').formatGoConstant()};');
		w.pop();
		w.write("}");
		w.write("");
		for (alias in node.kindAliases) {
			w.write('public static function Is$alias(node:Node):Bool {');
			w.push();
			w.write('return node.Kind == Kind$alias;');
			w.pop();
			w.write("}");
			w.write("");
		}
	}

	static function generateKindAliasGuards(w:CodeWriter) {
		// JSDocSyntaxKind → "IsJSDocKind" conflicts with the hand-written IsJSDocKind in utilities.go.
		final skipGuards = ["IsJSDocKind"];
		for (a in api.kindAliases()) {
			final funcName = "Is" + a.name.replace("Syntax", "");
			if (skipGuards.indexOf(funcName) >= 0)
				continue;
			if (a.range != null) {
				w.write('public static function $funcName(kind:Kind):Bool {');
				w.push();
				w.write('return kind >= Kind${a.range[0]} && kind <= Kind${a.range[1]};');
				w.pop();
				w.write("}");
				w.write("");
			} else {
				final expanded = api.expandKindAliasMembers(a.name);
				w.write('public static function $funcName(kind:Kind):Bool {');
				w.push();
				w.write("switch (kind) {");
				w.push();
				w.write('case ${[for (m in expanded) m.formatGoConstant()].join(" | ")}:');
				w.push();
				w.write("return true;");
				w.pop();
				w.write("default:");
				w.pop();
				w.write("}");
				w.write("return false;");
				w.pop();
				w.write("}");
				w.write("");
			}
		}
	}

	static function generateAsRegion():String {
		final w = new CodeWriter();
		w.write("// --- ast_generated.go: As*() cast methods ---");
		w.write("// PORT: Go `n.data.(*X)` → unchecked cast (the node object is the data object).");
		w.write("");
		for (node in api.nodes()) {
			w.write('public inline function As${node.name}():${node.name} {');
			w.push();
			w.write("return cast this;");
			w.pop();
			w.write("}");
			w.write("");
		}
		return w.toString().trim();
	}

	static function generateFactoryRegion():String {
		final w = new CodeWriter();
		w.write("// --- ast_generated.go: New*() / Update*() factory methods ---");
		w.write("");
		for (node in api.nodes()) {
			if (node.handWritten)
				continue;
			generateNewFactory(w, node);
			generateUpdateFactory(w, node);
		}
		return w.toString().trim();
	}

	static function generateNewFactory(w:CodeWriter, node:NodeType) {
		final members = schemaMembers(node);
		final kindMember = Lambda.find(members, m -> m.isKindParam());
		final nodeFlagsMembers = [for (m in members) if (isNodeFlagsMember(m)) m];
		emitNewFactory(w, 'New${node.name}', node.syntaxKindName, node, members, kindMember, nodeFlagsMembers);
		for (alias in node.kindAliases)
			emitNewFactory(w, 'New$alias', alias, node, members, kindMember, nodeFlagsMembers);
	}

	static function emitNewFactory(w:CodeWriter, funcName:String, kindName:String, node:NodeType, members:Array<MemberInfo>, kindMember:Null<MemberInfo>,
			nodeFlagsMembers:Array<MemberInfo>) {
		final params = [for (m in members) '${param(m)}:${memberHxType(m)}'].join(", ");
		w.write('public function $funcName($params):Node {');
		w.push();
		w.write('final data = new ${node.name}();');
		for (m in members) {
			if (m.isKindParam() || isNodeFlagsMember(m))
				continue;
			final value = m.bitmask != null ? '${param(m)} & ${m.bitmask}' : param(m);
			w.write('data.${m.name} = $value;');
		}
		if (hasTextContent(node))
			w.write("this.textCount++;");
		final kindArg = kindMember != null ? param(kindMember) : 'Kind$kindName';
		if (nodeFlagsMembers.length > 0) {
			w.write('final node = this.newNode($kindArg, data);');
			for (m in nodeFlagsMembers) {
				if (m.bitmask != null)
					w.write('node.Flags |= ${param(m)} & ${m.bitmask};');
				else
					w.write('node.Flags = ${param(m)};');
			}
			w.write("return node;");
		} else {
			w.write('return this.newNode($kindArg, data);');
		}
		w.pop();
		w.write("}");
		w.write("");
	}

	static function generateUpdateFactory(w:CodeWriter, node:NodeType) {
		final members = schemaMembers(node);
		final updateMembers = [for (m in members) if (!m.isKindParam()) m];
		if (updateMembers.length == 0)
			return;
		if (!Lambda.exists(updateMembers, m -> m.isChild()))
			return;
		final params = ['node:${node.name}'].concat([for (m in updateMembers) '${param(m)}:${memberHxType(m)}']).join(", ");
		w.write('public function Update${node.name}($params):Node {');
		w.push();
		final comparisons = [
			for (m in updateMembers) {
				final t = m.type;
				if (t.kind == "list" && (cast t : ListType).listKind == "raw")
					'!Core.Same(${param(m)}, node.${m.name})';
				else
					'${param(m)} != node.${m.name}';
			}
		];
		w.write('if (${comparisons.join(" || ")}) {');
		w.push();
		final newArgs = [for (m in members) m.isKindParam() ? "node.Kind" : param(m)].join(", ");
		if (node.kindAliases.length > 0) {
			w.write("switch (node.Kind) {");
			w.push();
			w.write('case ${api.kindType('SyntaxKind.${node.syntaxKindName}').formatGoConstant()}:');
			w.push();
			w.write('return Ast.updateNode(this.New${node.name}($newArgs), node.AsNode(), this.hooks);');
			w.pop();
			for (alias in node.kindAliases) {
				w.write('case Kind$alias:');
				w.push();
				w.write('return Ast.updateNode(this.New$alias($newArgs), node.AsNode(), this.hooks);');
				w.pop();
			}
			w.write("default:");
			w.push();
			w.write('throw "unexpected kind in Update${node.name}: " + node.Kind.String();');
			w.pop();
			w.pop();
			w.write("}");
		} else {
			w.write('return Ast.updateNode(this.New${node.name}($newArgs), node.AsNode(), this.hooks);');
		}
		w.pop();
		w.write("}");
		w.write("return node.AsNode();");
		w.pop();
		w.write("}");
		w.write("");
	}
}
