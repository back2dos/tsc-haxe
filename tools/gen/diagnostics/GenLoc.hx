// Generates the localized diagnostic messages, as upstream
// internal/diagnostics/generate.go (generateLocalizations) does.
//
// Inputs (read, never edited):
//   src/ts/diagnostics/diagnosticMessages.json, src/ts/diagnostics/extraDiagnosticMessages.json
//     (copies of the upstream files; they give the known keys)
//   upstream/tsc/_submodules/TypeScript/src/loc/lcl/*/diagnosticMessages/diagnosticMessages.generated.json.lcl
// Outputs:
//   src/ts/diagnostics/loc/<TgtCul>.json.gz   (Go: internal/diagnostics/loc/<TgtCul>.json.gz)
//   src/ts/diagnostics/LocGenerated.hx         (Go: internal/diagnostics/loc_generated.go)
//
// The gzip payload (the JSON) is byte-identical to upstream's: keys sorted, only '"', '\' and
// control characters escaped (internal/json, as in the upstream files). The compressed bytes
// differ (zlib instead of Go's compress/flate); only the payload is compared.
//
// Run from the project root:
//   haxe -cp tools/gen/diagnostics --run GenLoc
import haxe.io.Bytes;
import sys.FileSystem;
import sys.io.File;

using StringTools;

class GenLoc {
	static inline final LCL = "upstream/tsc/_submodules/TypeScript/src/loc/lcl";
	static inline final OUT_DIR = "src/ts/diagnostics/loc";
	static inline final OUT_HX = "src/ts/diagnostics/LocGenerated.hx";

	static function main() {
		final knownKeys = readKnownKeys();

		// Remove and recreate the loc directory for a clean state.
		if (FileSystem.exists(OUT_DIR)) {
			for (f in FileSystem.readDirectory(OUT_DIR))
				FileSystem.deleteFile(OUT_DIR + "/" + f);
		} else {
			FileSystem.createDirectory(OUT_DIR);
		}

		final localeFiles = [
			for (d in FileSystem.readDirectory(LCL))
				if (FileSystem.exists('$LCL/$d/diagnosticMessages/diagnosticMessages.generated.json.lcl'))
					'$LCL/$d/diagnosticMessages/diagnosticMessages.generated.json.lcl'
		];
		if (localeFiles.length == 0)
			throw "no locale files found in " + LCL;
		localeFiles.sort(byteCompare);

		final locales:Array<{varName:String, tgtCul:String, filename:String}> = [];
		for (localeFile in localeFiles) {
			final r = readLocalizedMessages(localeFile);
			final localizedMessages = r.messages;
			if (!localizedMessages.iterator().hasNext())
				continue;

			// Filter to only known keys.
			for (key in [for (k in localizedMessages.keys()) k])
				if (!knownKeys.exists(key))
					localizedMessages.remove(key);
			if (!localizedMessages.iterator().hasNext())
				continue;

			final tgtCul = r.tgtCul;
			final localeVar = tgtCul.replace("-", "").replace("_", "");
			final filename = '$tgtCul.json.gz';

			final keys = [for (k in localizedMessages.keys()) k];
			keys.sort(byteCompare);
			final json = new StringBuf();
			json.add("{");
			for (i in 0...keys.length) {
				if (i > 0)
					json.add(",");
				json.add(quote(keys[i]));
				json.add(":");
				json.add(quote(localizedMessages.get(keys[i])));
			}
			json.add("}");
			File.saveBytes('$OUT_DIR/$filename', gzip(Bytes.ofString(json.toString())));
			locales.push({varName: localeVar, tgtCul: tgtCul, filename: filename});
		}

		final b = new StringBuf();
		b.add("// Code generated by tools/gen/diagnostics/GenLoc.hx; do not edit.\n");
		b.add("// Port of internal/diagnostics/loc_generated.go (generateLocalizations).\n");
		b.add("package ts.diagnostics;\n\n");
		b.add("import go.text.language.Language;\n\n");
		b.add("class LocGenerated {\n");
		b.add("\t// PORT: Go package-level var; built on first use (static initialization order).\n");
		b.add("\tstatic var matcher_:Matcher = null;\n\n");
		b.add("\tpublic static var matcher(get, never):Matcher;\n\n");
		b.add("\tstatic function get_matcher():Matcher {\n");
		b.add("\t\tif (matcher_ == null)\n");
		b.add("\t\t\tmatcher_ = Language.NewMatcher([\n");
		b.add("\t\t\t\tLanguage.English,\n");
		for (loc in locales)
			b.add('\t\t\t\tLanguage.MustParse("${loc.tgtCul}"),\n');
		b.add("\t\t\t]);\n");
		b.add("\t\treturn matcher_;\n");
		b.add("\t}\n\n");
		b.add("\tpublic static final localeFuncs:Array<Null<() -> haxe.ds.StringMap<String>>> = [\n");
		b.add("\t\tnull, // English (default)\n");
		for (loc in locales)
			b.add('\t\t${loc.varName},\n');
		b.add("\t];\n\n");
		b.add("\t// PORT: Go embeds the .json.gz with //go:embed; we embed it as a haxe.Resource (DiagnosticsMacro.embedLoc).\n");
		b.add("\tstatic function loadLocaleData(data:haxe.io.Bytes):haxe.ds.StringMap<String> {\n");
		b.add("\t\t// PORT: Go gzip.NewReader + json.UnmarshalRead. The member header is the fixed one GenLoc writes.\n");
		b.add("\t\tif (data.length < 18 || data.get(0) != 0x1f || data.get(1) != 0x8b || data.get(3) != 0)\n");
		b.add("\t\t\tthrow \"failed to create gzip reader: invalid header\";\n");
		b.add("\t\tfinal raw = inflateRaw(new haxe.io.BytesInput(data, 10, data.length - 18));\n");
		b.add("\t\tfinal obj:haxe.DynamicAccess<String> = haxe.Json.parse(raw.toString());\n");
		b.add("\t\tfinal result = new haxe.ds.StringMap<String>();\n");
		b.add("\t\tfor (k => v in obj)\n");
		b.add("\t\t\tresult.set(k, v);\n");
		b.add("\t\treturn result;\n");
		b.add("\t}\n\n");
		b.add("\t// Raw deflate data (no zlib header) to bytes.\n");
		b.add("\tpublic static function inflateRaw(input:haxe.io.Input):haxe.io.Bytes {\n");
		b.add("\t\tfinal inf = new haxe.zip.InflateImpl(input, false, false);\n");
		b.add("\t\tfinal out = new haxe.io.BytesBuffer();\n");
		b.add("\t\tfinal buf = haxe.io.Bytes.alloc(65536);\n");
		b.add("\t\twhile (true) {\n");
		b.add("\t\t\tfinal n = inf.readBytes(buf, 0, buf.length);\n");
		b.add("\t\t\tout.addBytes(buf, 0, n);\n");
		b.add("\t\t\tif (n < buf.length)\n");
		b.add("\t\t\t\tbreak;\n");
		b.add("\t\t}\n");
		b.add("\t\treturn out.getBytes();\n");
		b.add("\t}\n");
		for (loc in locales) {
			b.add('\n\tstatic var ${loc.varName}Value:haxe.ds.StringMap<String> = null;\n\n');
			b.add('\tstatic function ${loc.varName}():haxe.ds.StringMap<String> {\n');
			b.add('\t\tif (${loc.varName}Value == null)\n');
			b.add('\t\t\t${loc.varName}Value = loadLocaleData(haxe.Resource.getBytes(DiagnosticsMacro.embedLoc("${loc.filename}")));\n');
			b.add('\t\treturn ${loc.varName}Value;\n');
			b.add("\t}\n");
		}
		b.add("}\n");
		File.saveContent(OUT_HX, b.toString());
		Sys.println('wrote ${locales.length} locales');
	}

	// gzip container around zlib's deflate stream (header: no name, no mtime; OS unknown).
	static function gzip(data:Bytes):Bytes {
		final z = haxe.zip.Compress.run(data, 9);
		final out = new haxe.io.BytesOutput();
		for (x in [0x1f, 0x8b, 8, 0, 0, 0, 0, 0, 2, 255])
			out.writeByte(x);
		out.writeFullBytes(z, 2, z.length - 6); // strip the zlib header and the adler32 trailer
		out.writeInt32(haxe.crypto.Crc32.make(data));
		out.writeInt32(data.length);
		return out.getBytes();
	}

	// internal/json (json v2) string escaping: '"', '\' and control characters only.
	static function quote(s:String):String {
		final b = new StringBuf();
		b.add('"');
		for (i in 0...s.length) {
			final c = s.fastCodeAt(i);
			switch c {
				case '"'.code: b.add('\\"');
				case '\\'.code: b.add('\\\\');
				case '\n'.code: b.add('\\n');
				case '\r'.code: b.add('\\r');
				case '\t'.code: b.add('\\t');
				case 8: b.add('\\b');
				case 12: b.add('\\f');
				case _ if (c < 0x20): b.add('\\u00' + StringTools.hex(c, 2).toLowerCase());
				case _: b.addChar(c);
			}
		}
		b.add('"');
		return b.toString();
	}

	static function byteCompare(a:String, b:String):Int {
		return a < b ? -1 : (a > b ? 1 : 0); // ASCII paths and keys
	}

	static function readKnownKeys():Map<String, Bool> {
		// Same merge as generate.go: by code, extra messages override.
		final byCode = new Map<Int, String>();
		for (file in ["src/ts/diagnostics/diagnosticMessages.json", "src/ts/diagnostics/extraDiagnosticMessages.json"]) {
			final raw:Dynamic = haxe.Json.parse(File.getContent(file));
			for (key in Reflect.fields(raw))
				byCode.set(Reflect.field(raw, key).code, key);
		}
		final known = new Map<String, Bool>();
		for (code => key in byCode)
			known.set(convertPropertyName(key, code), true);
		return known;
	}

	// Key part of generate.go convertPropertyName (same as DiagnosticsMacro.convertPropertyName).
	static function convertPropertyName(origName:String, code:Int):String {
		final b = new StringBuf();
		for (i in 0...origName.length) {
			final c = origName.charAt(i);
			switch c {
				case "*": b.add("_Asterisk");
				case "/": b.add("_Slash");
				case ":": b.add("_Colon");
				case _: b.add(~/^[A-Za-z0-9]$/.match(c) ? c : "_"); // keys are ASCII (checked by DiagnosticsTest)
			}
		}
		var varName = b.toString();
		varName = ~/_+/g.replace(varName, "_");
		varName = ~/^_+([^0-9])/.replace(varName, "$1");
		varName = ~/_$/.replace(varName, "");
		var key = varName;
		if (key.length > 100)
			key = key.substr(0, 100);
		return key + "_" + code;
	}

	// readLocalizedMessages: LCX/Item(root)/Item(string table)/Item -> Str/Val, Str/Tgt/Val.
	static function readLocalizedMessages(p:String):{messages:Map<String, String>, tgtCul:String} {
		var text = File.getContent(p);
		if (text.charCodeAt(0) == 0xFEFF)
			text = text.substr(1);
		final lcx = Xml.parse(text).firstElement();
		final messages = new Map<String, String>();
		for (rootItem in lcx.elementsNamed("Item")) {
			for (stringTable in rootItem.elementsNamed("Item")) {
				for (item in stringTable.elementsNamed("Item")) {
					var itemId = item.get("ItemId");
					if (itemId.startsWith(";"))
						itemId = itemId.substr(1);
					// Go xml.Unmarshal into a non-slice field: every <Str> decodes into the same value.
					var val = "";
					var tgt:Null<String> = null;
					for (str in item.elementsNamed("Str")) {
						for (v in str.elementsNamed("Val"))
							val = charData(v);
						for (t in str.elementsNamed("Tgt")) {
							tgt = "";
							for (v in t.elementsNamed("Val"))
								tgt = charData(v);
						}
					}
					messages.set(itemId, tgt != null && tgt != "" ? tgt : val);
				}
			}
		}
		return {messages: messages, tgtCul: lcx.get("TgtCul")};
	}

	// Go encoding/xml character data of an element: text and CDATA, with "\r\n" and "\r" as "\n".
	static function charData(e:Xml):String {
		final b = new StringBuf();
		for (c in e) {
			switch c.nodeType {
				case CData: b.add(c.nodeValue);
				case PCData: b.add(htmlUnescape(c.nodeValue));
				case _:
			}
		}
		return b.toString().replace("\r\n", "\n").replace("\r", "\n");
	}

	static function htmlUnescape(s:String):String {
		if (s.indexOf("&") < 0)
			return s;
		throw "entity in character data not handled: " + s;
	}
}
