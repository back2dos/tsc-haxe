// Generates the Haxe versions of the golang.org/x/text/language tables used by the locale
// matcher of internal/diagnostics (loc_generated.go) and internal/locale.
//
// Inputs (read, never edited), from the Go module cache (version pinned by upstream go.mod):
//   golang.org/x/text@v0.38.0/internal/language/tables.go
//   golang.org/x/text@v0.38.0/internal/language/compact/tables.go
//   golang.org/x/text@v0.38.0/language/tables.go
// Outputs:
//   src/go/text/internal/language/Tables.hx
//   src/go/text/internal/language/compact/Tables.hx
//   src/go/text/language/Tables.hx
//
// Every integer constant is emitted as is. Every table becomes a flat Array<Int>:
//   - arrays of structs: one row per element, fields in struct declaration order
//     (NAME_STRIDE = number of fields; bool is 0/1); keyed and indexed literals are honoured,
//     missing elements are zero (Go zero value);
//   - [N]uint64: two arrays NAME_hi / NAME_lo (32-bit halves);
//   - tag.Index / string constants: their bytes;
//   - map[string]uint8: NAME_keys:Array<String> and NAME_vals:Array<Int>.
// Tables listed in SKIP are not used by the port and are left out.
//
// Run from the project root:
//   haxe -cp tools/gen/diagnostics --run GenLanguageTables "$(cd upstream/tsc && GOTOOLCHAIN=go1.26.9 go env GOMODCACHE)/golang.org/x/text@v0.38.0"
import sys.io.File;

using StringTools;

class GenLanguageTables {
	static final SKIP = ["parents", "regionInclusionNext"];

	static function main() {
		final args = Sys.args();
		if (args.length < 1)
			throw "usage: GenLanguageTables <dir of golang.org/x/text@v0.38.0>";
		final root = args[0];
		gen(root + "/internal/language/tables.go", "go.text.internal.language", "src/go/text/internal/language/Tables.hx",
			"golang.org/x/text/internal/language/tables.go");
		gen(root + "/internal/language/compact/tables.go", "go.text.internal.language.compact", "src/go/text/internal/language/compact/Tables.hx",
			"golang.org/x/text/internal/language/compact/tables.go");
		gen(root + "/language/tables.go", "go.text.language", "src/go/text/language/Tables.hx", "golang.org/x/text/language/tables.go");
	}

	static var structs:Map<String, Array<String>>;

	static function gen(src:String, pack:String, out:String, srcName:String) {
		final text = File.getContent(src).replace("\r\n", "\n");
		final lines = text.split("\n");
		structs = new Map();
		final b = new StringBuf();
		b.add("// Code generated by tools/gen/diagnostics/GenLanguageTables.hx; do not edit.\n");
		b.add('// Source: $srcName (golang.org/x/text v0.38.0)\n');
		b.add('package $pack;\n\n');
		b.add("class Tables {\n");

		// Struct declarations (field order).
		var i = 0;
		while (i < lines.length) {
			final re = ~/^type (\w+) struct \{$/;
			if (re.match(lines[i])) {
				final fields = [];
				i++;
				while (lines[i] != "}") {
					final f = ~/^\s+(\w+)\s+(\S+)/;
					if (f.match(lines[i]))
						fields.push(f.matched(1));
					i++;
				}
				structs.set(re.matched(1), fields);
			}
			i++;
		}

		i = 0;
		var inConst = false;
		while (i < lines.length) {
			final line = lines[i];
			final single = ~/^const (\w+) = (-?(?:0x[0-9a-fA-F]+|\d+))$/;
			final strConst = ~/^const (\w+) (?:tag\.Index|string) = (.*)$/;
			final varDecl = ~/^var (\w+) = (\S+)\{/;
			if (line == "const (") {
				inConst = true;
			} else if (inConst && line == ")") {
				inConst = false;
			} else if (inConst) {
				final m = ~/^\s+(\w+)\s*=\s*(-?(?:0x[0-9a-fA-F]+|\d+))/;
				if (m.match(line))
					b.add('\tpublic static inline final ${m.matched(1)} = ${m.matched(2)};\n');
			} else if (single.match(line)) {
				b.add('\tpublic static inline final ${single.matched(1)} = ${single.matched(2)};\n');
			} else if (strConst.match(line)) {
				// String literal concatenation, possibly over several lines.
				var lit = strConst.matched(2);
				while (~/\+\s*(\/\/.*)?$/.match(lit)) {
					i++;
					lit += "\n" + lines[i];
				}
				final bytes = decodeGoStrings(lit);
				b.add('\tpublic static final ${strConst.matched(1)}:Array<Int> = ${intArray(bytes)};\n');
			} else if (varDecl.match(line)) {
				final name = varDecl.matched(1);
				final typ = varDecl.matched(2);
				// Collect the literal body up to the matching closing brace.
				var body = new StringBuf();
				var depth = 0;
				var j = i;
				var started = false;
				var done = false;
				while (!done) {
					var l = lines[j];
					final c = l.indexOf("//");
					if (c >= 0 && l.indexOf('"') < 0)
						l = l.substr(0, c);
					for (k in 0...l.length) {
						final ch = l.charAt(k);
						if (ch == "{") {
							depth++;
							if (!started) {
								started = true;
								continue;
							}
						} else if (ch == "}") {
							depth--;
							if (started && depth == 0) {
								done = true;
								break;
							}
						}
						if (started)
							body.add(ch);
					}
					body.add("\n");
					j++;
				}
				i = j - 1;
				if (SKIP.indexOf(name) < 0)
					emitVar(b, name, typ, body.toString());
			}
			i++;
		}
		b.add("}\n");
		File.saveContent(out, b.toString());
		Sys.println("wrote " + out);
	}

	static function emitVar(b:StringBuf, name:String, typ:String, body:String) {
		final arr = ~/^\[(\d*)\](.*)$/;
		if (typ.startsWith("map[string]")) {
			final keys = [];
			final vals = [];
			for (e in splitTop(body)) {
				final m = ~/^"([^"]*)"\s*:\s*(\S+)$/;
				if (!m.match(e))
					throw "bad map entry " + e;
				keys.push(m.matched(1));
				vals.push(parseInt(m.matched(2)));
			}
			b.add('\tpublic static final ${name}_keys:Array<String> = [${[for (k in keys) '"$k"'].join(", ")}];\n');
			b.add('\tpublic static final ${name}_vals:Array<Int> = ${intArray(vals)};\n');
			return;
		}
		if (!arr.match(typ))
			throw "unsupported type " + typ + " for " + name;
		final n = arr.matched(1) == "" ? -1 : Std.parseInt(arr.matched(1));
		final elem = arr.matched(2);
		final fields:Array<String> = structs.exists(elem) ? structs.get(elem) : (elem.startsWith("[") ? null : ["_"]);
		final elems = splitTop(body);
		final rows = new Map<Int, Array<Float>>();
		var next = 0;
		var maxIdx = -1;
		var stride = fields != null ? fields.length : 0;
		for (e in elems) {
			var v = e;
			final idx = ~/^(\d+)\s*:\s*([\s\S]*)$/;
			var at = next;
			if (idx.match(v)) {
				at = Std.parseInt(idx.matched(1));
				v = idx.matched(2).trim();
			}
			final row:Array<Float> = [];
			if (v.startsWith("[")) { // [3]uint16{a, b, c}
				final inner = v.substring(v.indexOf("{") + 1, v.lastIndexOf("}"));
				for (x in splitTop(inner))
					row.push(parseNum(x));
				stride = row.length;
			} else if (v.startsWith("{")) {
				final inner = v.substring(1, v.lastIndexOf("}"));
				final parts = splitTop(inner);
				final vals = [for (_ in fields) 0.0];
				for (pi in 0...parts.length) {
					final kv = ~/^(\w+)\s*:\s*(.*)$/;
					if (kv.match(parts[pi]) && fields.indexOf(kv.matched(1)) >= 0)
						vals[fields.indexOf(kv.matched(1))] = parseNum(kv.matched(2).trim());
					else
						vals[pi] = parseNum(parts[pi]);
				}
				for (x in vals)
					row.push(x);
			} else {
				row.push(parseNum(v));
			}
			rows.set(at, row);
			if (at > maxIdx)
				maxIdx = at;
			next = at + 1;
		}
		final len = n >= 0 ? n : maxIdx + 1;
		if (elem == "uint64") {
			final hi = [];
			final lo = [];
			for (k in 0...len) {
				final v = rows.exists(k) ? rows.get(k)[0] : 0.0;
				hi.push(Std.int(v / 4294967296.0));
				final l = v - Math.ffloor(v / 4294967296.0) * 4294967296.0;
				lo.push(l >= 2147483648.0 ? Std.int(l - 4294967296.0) : Std.int(l));
			}
			b.add('\tpublic static final ${name}_hi:Array<Int> = ${intArray(hi)};\n');
			b.add('\tpublic static final ${name}_lo:Array<Int> = ${intArray(lo)};\n');
			return;
		}
		final flat = [];
		for (k in 0...len) {
			final row = rows.exists(k) ? rows.get(k) : [for (_ in 0...stride) 0.0];
			if (row.length != stride)
				throw 'row width mismatch in $name';
			for (x in row)
				flat.push(Std.int(x));
		}
		if (fields != null && structs.exists(elem))
			b.add('\t// $name: ${len} x {${fields.join(", ")}}\n');
		if (stride != 1)
			b.add('\tpublic static inline final ${name}_STRIDE = $stride;\n');
		b.add('\tpublic static final $name:Array<Int> = ${intArray(flat)};\n');
	}

	// Split on top-level commas (outside braces and strings); empty parts dropped.
	static function splitTop(s:String):Array<String> {
		final out = [];
		var depth = 0;
		var inStr = false;
		var cur = new StringBuf();
		for (k in 0...s.length) {
			final ch = s.charAt(k);
			if (inStr) {
				cur.add(ch);
				if (ch == '"')
					inStr = false;
				continue;
			}
			switch ch {
				case '"':
					inStr = true;
					cur.add(ch);
				case "{":
					depth++;
					cur.add(ch);
				case "}":
					depth--;
					cur.add(ch);
				case "," if (depth == 0):
					final t = cur.toString().trim();
					if (t != "")
						out.push(t);
					cur = new StringBuf();
				case _:
					cur.add(ch);
			}
		}
		final t = cur.toString().trim();
		if (t != "")
			out.push(t);
		return out;
	}

	static function parseNum(s:String):Float {
		s = s.trim();
		if (s == "true")
			return 1;
		if (s == "false")
			return 0;
		if (s.startsWith("0x")) {
			var v = 0.0;
			for (k in 2...s.length)
				v = v * 16 + Std.parseInt("0x" + s.charAt(k));
			return v;
		}
		final v = Std.parseFloat(s);
		if (Math.isNaN(v))
			throw "bad number " + s;
		return v;
	}

	static function parseInt(s:String):Int {
		return Std.int(parseNum(s));
	}

	static function decodeGoStrings(lit:String):Array<Int> {
		final out = [];
		var k = 0;
		while (k < lit.length) {
			final ch = lit.charAt(k);
			if (ch == "/" && lit.charAt(k + 1) == "/") {
				while (k < lit.length && lit.charAt(k) != "\n")
					k++;
				continue;
			}
			if (ch != '"') {
				k++;
				continue;
			}
			k++;
			while (lit.charAt(k) != '"') {
				final c = lit.charAt(k);
				if (c == "\\") {
					final e = lit.charAt(k + 1);
					switch e {
						case "x":
							out.push(Std.parseInt("0x" + lit.substr(k + 2, 2)));
							k += 4;
						case "\\" | '"':
							out.push(e.charCodeAt(0));
							k += 2;
						case _:
							throw "unsupported escape \\" + e;
					}
				} else {
					final code = c.charCodeAt(0);
					if (code > 127)
						throw "non-ASCII in string literal";
					out.push(code);
					k++;
				}
			}
			k++;
		}
		return out;
	}

	static function intArray(a:Array<Int>):String {
		final b = new StringBuf();
		b.add("[");
		for (k in 0...a.length) {
			if (k % 16 == 0)
				b.add("\n\t\t");
			b.add(a[k]);
			b.add(",");
		}
		b.add("\n\t]");
		return b.toString();
	}
}
