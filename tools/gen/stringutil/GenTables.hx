// Generates the Haxe versions of the stringutil Unicode tables.
//
// Inputs (read, never edited):
//   upstream/tsc/internal/stringutil/identifier_parts_generated.go
//   upstream/tsc/internal/stringutil/js_case_generated.go
//   $GOROOT/src/unicode/tables.go  (Go stdlib case tables: CaseRanges, caseOrbit, asciiFold;
//                                   needed by go.Unicode.ToLower / SimpleFold / go.Strings.EqualFold)
// Outputs:
//   src/ts/stringutil/IdentifierPartsGenerated.hx
//   src/ts/stringutil/JsCaseGenerated.hx
//   src/go/UnicodeTables.hx
//
// Run from the project root:
//   haxe -cp tools/gen/stringutil --run GenTables [GOROOT]
// GOROOT defaults to the env var GOROOT; use the pinned toolchain:
//   haxe -cp tools/gen/stringutil --run GenTables "$(cd upstream/tsc && GOTOOLCHAIN=go1.26.9 go env GOROOT)"
import sys.io.File;

using StringTools;

class GenTables {
	static inline final HEADER = "// Code generated by tools/gen/stringutil/GenTables.hx; do not edit.\n";
	static inline final UPSTREAM = "upstream/tsc/internal/stringutil/";

	static function main() {
		final args = Sys.args();
		var goroot = args.length > 0 ? args[0] : Sys.getEnv("GOROOT");
		if (goroot == null || goroot == "")
			throw "usage: GenTables <GOROOT> (or set GOROOT)";

		final ident = File.getContent(UPSTREAM + "identifier_parts_generated.go");
		final jsCase = File.getContent(UPSTREAM + "js_case_generated.go");
		final tables = File.getContent(goroot + "/src/unicode/tables.go");

		File.saveContent("src/ts/stringutil/IdentifierPartsGenerated.hx", genIdentifier(ident));
		File.saveContent("src/ts/stringutil/JsCaseGenerated.hx", genJsCase(jsCase));
		File.saveContent("src/go/UnicodeTables.hx", genGoTables(tables));
		Sys.println("ok");
	}

	// ---- helpers ----

	// Lines of the block that starts at the line beginning with `start` and ends at the next "}" line.
	static function block(src:String, start:String):Array<String> {
		final lines = src.split("\n");
		var i = 0;
		while (i < lines.length && !lines[i].startsWith(start))
			i++;
		if (i == lines.length)
			throw "not found: " + start;
		final out = [];
		i++;
		while (i < lines.length && lines[i] != "}") {
			out.push(lines[i]);
			i++;
		}
		return out;
	}

	static function hex(s:String):Int {
		final v = Std.parseInt(s);
		if (v == null)
			throw "bad number: " + s;
		return v;
	}

	static function intArray(values:Array<Int>, perLine:Int):String {
		final b = new StringBuf();
		b.add("[");
		for (i in 0...values.length) {
			if (i % perLine == 0)
				b.add("\n\t\t");
			else
				b.add(" ");
			b.add(values[i]);
			if (i < values.length - 1)
				b.add(",");
		}
		b.add("\n\t]");
		return b.toString();
	}

	// Parses a Go `&unicode.RangeTable{...}` var into Haxe `new RangeTable(r16, r32, latinOffset)`.
	static function rangeTable(src:String, name:String):String {
		final lines = block(src, 'var $name = &unicode.RangeTable{');
		final r16 = [], r32 = [];
		var latinOffset = 0;
		var cur:Array<Int> = null;
		final triple = ~/^\s*\{(0x[0-9A-Fa-f]+), (0x[0-9A-Fa-f]+), ([0-9]+)\},$/;
		final latin = ~/^\s*LatinOffset: ([0-9]+),$/;
		for (l in lines) {
			if (l.indexOf("R16:") >= 0)
				cur = r16;
			else if (l.indexOf("R32:") >= 0)
				cur = r32;
			else if (latin.match(l))
				latinOffset = Std.parseInt(latin.matched(1));
			else if (triple.match(l)) {
				cur.push(hex(triple.matched(1)));
				cur.push(hex(triple.matched(2)));
				cur.push(hex(triple.matched(3)));
			} else if (~/^\s*\},?$/.match(l)) {
				cur = null;
			} else
				throw 'unexpected line in $name: $l';
		}
		return 'new RangeTable(${intArray(r16, 12)}, ${intArray(r32, 12)}, $latinOffset)';
	}

	// Decodes a Go string literal made of \uXXXX / \UXXXXXXXX escapes into code points.
	static function goEscapes(s:String):Array<Int> {
		final out = [];
		var i = 0;
		while (i < s.length) {
			if (s.charAt(i) != "\\")
				throw "unexpected literal: " + s;
			final n = s.charAt(i + 1) == "u" ? 4 : (s.charAt(i + 1) == "U" ? 8 : throw "unexpected escape: " + s);
			out.push(hex("0x" + s.substr(i + 2, n)));
			i += 2 + n;
		}
		return out;
	}

	// ---- identifier_parts_generated.go ----

	static function genIdentifier(src:String):String {
		final b = new StringBuf();
		b.add(HEADER);
		b.add("// Source: upstream/tsc/internal/stringutil/identifier_parts_generated.go\n");
		b.add("package ts.stringutil;\n\nimport go.Unicode.RangeTable;\n\n");
		b.add("// PORT: package-level vars of identifier_parts_generated.go live in this module, not in class Stringutil.\n");
		b.add("class IdentifierPartsGenerated {\n");
		for (name in ["unicodeESNextIdentifierStart", "unicodeESNextIdentifierPart"])
			b.add('\tpublic static final $name = ${rangeTable(src, name)};\n\n');
		b.add("}\n");
		return b.toString();
	}

	// ---- js_case_generated.go ----

	static function genJsCase(src:String):String {
		// Flat encoding per entry: cp, condition, nLower, lower..., nUpper, upper..., nCondLower, condLower...
		final data = [];
		final entry = ~/^\s+(0x[0-9A-F]+):\s+\{lower: "([^"]*)", upper: "([^"]*)",(?: conditionalLower: "([^"]*)",)? condition: specialCasingCondition(None|FinalSigma)\},$/;
		var count = 0;
		for (l in block(src, "var specialCasingMappings = map[rune]specialCasingMapping{")) {
			if (!entry.match(l))
				throw "unexpected mapping line: " + l;
			data.push(hex(entry.matched(1)));
			data.push(entry.matched(5) == "FinalSigma" ? 1 : 0);
			for (g in [2, 3, 4]) {
				final s = entry.matched(g);
				final cps = s == null ? [] : goEscapes(s);
				data.push(cps.length);
				for (c in cps)
					data.push(c);
			}
			count++;
		}

		final b = new StringBuf();
		b.add(HEADER);
		b.add("// Source: upstream/tsc/internal/stringutil/js_case_generated.go\n");
		b.add("package ts.stringutil;\n\nimport go.Unicode.RangeTable;\n\n");
		b.add("// PORT: Haxe type names must start with an upper-case letter (Go: specialCasingCondition).\n");
		b.add("enum abstract SpecialCasingCondition(Int) {\n");
		b.add("\tvar specialCasingConditionNone = 0;\n");
		b.add("\tvar specialCasingConditionFinalSigma = 1;\n");
		b.add("}\n\n");
		b.add("// PORT: Haxe type names must start with an upper-case letter (Go: specialCasingMapping).\n");
		b.add("final class SpecialCasingMapping {\n");
		b.add("\tpublic final lower:String;\n");
		b.add("\tpublic final upper:String;\n");
		b.add("\tpublic final conditionalLower:String;\n");
		b.add("\tpublic final condition:SpecialCasingCondition;\n\n");
		b.add("\tpublic function new(lower:String, upper:String, conditionalLower:String, condition:SpecialCasingCondition) {\n");
		b.add("\t\tthis.lower = lower;\n\t\tthis.upper = upper;\n\t\tthis.conditionalLower = conditionalLower;\n\t\tthis.condition = condition;\n\t}\n");
		b.add("}\n\n");
		b.add("// PORT: package-level vars of js_case_generated.go live in this module, not in class Stringutil.\n");
		b.add("class JsCaseGenerated {\n");
		b.add('\t// $count entries. Go map[rune]specialCasingMapping, built on first use from mappingData.\n');
		b.add("\tstatic var mappings:haxe.ds.IntMap<SpecialCasingMapping> = null;\n\n");
		b.add("\tpublic static function specialCasingMappings():haxe.ds.IntMap<SpecialCasingMapping> {\n");
		b.add("\t\tif (mappings == null)\n\t\t\tmappings = build();\n\t\treturn mappings;\n\t}\n\n");
		b.add("\tstatic function str(data:Array<Int>, i:Int, n:Int):String {\n");
		b.add("\t\tfinal b = new StringBuf();\n");
		b.add("\t\tfor (k in 0...n)\n\t\t\tb.add(go.Utf16.RuneString(data[i + k]));\n");
		b.add("\t\treturn b.toString();\n\t}\n\n");
		b.add("\tstatic function build():haxe.ds.IntMap<SpecialCasingMapping> {\n");
		b.add("\t\tfinal m = new haxe.ds.IntMap<SpecialCasingMapping>();\n");
		b.add("\t\tfinal data = mappingData;\n");
		b.add("\t\tvar i = 0;\n");
		b.add("\t\twhile (i < data.length) {\n");
		b.add("\t\t\tfinal cp = data[i];\n");
		b.add("\t\t\tfinal condition:SpecialCasingCondition = cast data[i + 1];\n");
		b.add("\t\t\ti += 2;\n");
		b.add("\t\t\tfinal lower = str(data, i + 1, data[i]);\n\t\t\ti += 1 + data[i];\n");
		b.add("\t\t\tfinal upper = str(data, i + 1, data[i]);\n\t\t\ti += 1 + data[i];\n");
		b.add("\t\t\tfinal conditionalLower = str(data, i + 1, data[i]);\n\t\t\ti += 1 + data[i];\n");
		b.add("\t\t\tm.set(cp, new SpecialCasingMapping(lower, upper, conditionalLower, condition));\n");
		b.add("\t\t}\n\t\treturn m;\n\t}\n\n");
		b.add('\tstatic final mappingData:Array<Int> = ${intArray(data, 20)};\n\n');
		for (name in ["unicodeCasedRanges", "unicodeCaseIgnorableRanges"])
			b.add('\tpublic static final $name = ${rangeTable(src, name)};\n\n');
		b.add("}\n");
		return b.toString();
	}

	// ---- Go stdlib unicode/tables.go ----

	static function genGoTables(src:String):String {
		final version = ~/const Version = "([^"]+)"/;
		if (!version.match(src))
			throw "no Version in tables.go";

		final caseRanges = [];
		final cr = ~/^\s+\{(0x[0-9A-F]+), (0x[0-9A-F]+), d\{(-?[0-9]+|UpperLower), (-?[0-9]+|UpperLower), (-?[0-9]+|UpperLower)\}\},$/;
		for (l in block(src, "var _CaseRanges = []CaseRange{")) {
			if (!cr.match(l))
				throw "unexpected CaseRange line: " + l;
			caseRanges.push(hex(cr.matched(1)));
			caseRanges.push(hex(cr.matched(2)));
			for (g in 3...6) {
				final d = cr.matched(g);
				caseRanges.push(d == "UpperLower" ? 0x10FFFF + 1 : Std.parseInt(d));
			}
		}

		final orbit = [];
		final fp = ~/^\s+\{(0x[0-9A-F]+), (0x[0-9A-F]+)\},$/;
		for (l in block(src, "var caseOrbit = []foldPair{")) {
			if (!fp.match(l))
				throw "unexpected foldPair line: " + l;
			orbit.push(hex(fp.matched(1)));
			orbit.push(hex(fp.matched(2)));
		}

		final ascii = [];
		final num = ~/^\s+(0x[0-9A-F]+),$/;
		for (l in block(src, "var asciiFold = [MaxASCII + 1]uint16{")) {
			if (!num.match(l))
				throw "unexpected asciiFold line: " + l;
			ascii.push(hex(num.matched(1)));
		}
		if (ascii.length != 128)
			throw "asciiFold must have 128 entries";

		final b = new StringBuf();
		b.add(HEADER);
		b.add('// Source: Go toolchain src/unicode/tables.go (Unicode ${version.matched(1)}).\n');
		b.add("package go;\n\n");
		b.add("class UnicodeTables {\n");
		b.add('\tpublic static inline final Version = "${version.matched(1)}";\n\n');
		b.add("\t// CaseRanges: flat [Lo, Hi, Delta[UpperCase], Delta[LowerCase], Delta[TitleCase]] per range.\n");
		b.add('\tpublic static final CaseRanges:Array<Int> = ${intArray(caseRanges, 15)};\n\n');
		b.add("\t// caseOrbit: flat [From, To] per pair.\n");
		b.add('\tpublic static final caseOrbit:Array<Int> = ${intArray(orbit, 16)};\n\n');
		b.add('\tpublic static final asciiFold:Array<Int> = ${intArray(ascii, 16)};\n');
		b.add("}\n");
		return b.toString();
	}
}
