package ts.printer;

// Port of generatedidentifierflags.go.

enum abstract GeneratedIdentifierFlags(Int) from Int to Int {
	@:op(A | B) static function or(a:GeneratedIdentifierFlags, b:GeneratedIdentifierFlags):GeneratedIdentifierFlags;
	@:op(A & B) static function and(a:GeneratedIdentifierFlags, b:GeneratedIdentifierFlags):GeneratedIdentifierFlags;
	@:op(~A) static function not(a:GeneratedIdentifierFlags):GeneratedIdentifierFlags;

	// Kind

	var GeneratedIdentifierFlagsNone = 0; // Not automatically generated.
	var GeneratedIdentifierFlagsAuto = 1; // Automatically generated identifier.
	var GeneratedIdentifierFlagsLoop = 2; // Automatically generated identifier with a preference for '_i'.
	var GeneratedIdentifierFlagsUnique = 3; // Unique name based on the 'text' property.
	var GeneratedIdentifierFlagsNode = 4; // Unique name based on the node in the 'Node' property.
	var GeneratedIdentifierFlagsKindMask = 7; // Mask to extract the kind of identifier from its flags.

	// Flags

	var GeneratedIdentifierFlagsReservedInNestedScopes = 1 << 3; // Reserve the generated name in nested scopes
	var GeneratedIdentifierFlagsOptimistic = 1 << 4; // First instance won't use '_#' if there's no conflict
	var GeneratedIdentifierFlagsFileLevel = 1 << 5; // Use only the file identifiers list and not generated names to search for conflicts
	var GeneratedIdentifierFlagsAllowNameSubstitution = 1 << 6; // Used by `module.ts` to indicate generated nodes which can have substitutions performed upon them (as they were generated by an earlier transform phase)

	public inline function Kind():GeneratedIdentifierFlags {
		return this & GeneratedIdentifierFlagsKindMask;
	}

	public inline function IsAuto():Bool {
		return Kind() == GeneratedIdentifierFlagsAuto;
	}

	public inline function IsLoop():Bool {
		return Kind() == GeneratedIdentifierFlagsLoop;
	}

	public inline function IsUnique():Bool {
		return Kind() == GeneratedIdentifierFlagsUnique;
	}

	public inline function IsNode():Bool {
		return Kind() == GeneratedIdentifierFlagsNode;
	}

	public inline function IsReservedInNestedScopes():Bool {
		return this & GeneratedIdentifierFlagsReservedInNestedScopes != 0;
	}

	public inline function IsOptimistic():Bool {
		return this & GeneratedIdentifierFlagsOptimistic != 0;
	}

	public inline function IsFileLevel():Bool {
		return this & GeneratedIdentifierFlagsFileLevel != 0;
	}

	public inline function HasAllowNameSubstitution():Bool {
		return this & GeneratedIdentifierFlagsAllowNameSubstitution != 0;
	}
}
