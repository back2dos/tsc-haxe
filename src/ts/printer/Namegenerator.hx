package ts.printer;

import haxe.ds.IntMap;
import haxe.ds.StringMap;

// Port of namegenerator.go (types and methods; nextContainer and isUniqueLocalName are package
// statics in class Printer).

// Flags enum to track count of temp variables and a few dedicated names
// PORT: unexported Go type `tempFlags` → TempFlags (PORTING.md §1).
enum abstract TempFlags(Int) from Int to Int {
	@:op(A | B) static function or(a:TempFlags, b:TempFlags):TempFlags;
	@:op(A & B) static function and(a:TempFlags, b:TempFlags):TempFlags;

	var tempFlagsAuto = 0x00000000; // No preferred name
	var tempFlagsCountMask = 0x0FFFFFFF; // Temp variable counter
	var tempFlags_i = 0x10000000; // Use/preference flag for '_i'
}

class NameGenerator {
	public var Context:EmitContext = null;
	public var IsFileLevelUniqueNameInCurrentFile:(std.String, Bool) -> Bool = null; // callback for Printer.isFileLevelUniqueNameInCurrentFile
	public var GetTextOfNode:(Node) -> std.String = null; // callback for Printer.getTextOfNode

	var nodeIdToGeneratedName:IntMap<std.String> = null; // Map of generated names for specific nodes
	var nodeIdToGeneratedPrivateName:IntMap<std.String> = null; // Map of generated private names for specific nodes
	var autoGeneratedIdToGeneratedName:IntMap<std.String> = null; // Map of generated names for temp and loop variables
	var nameGenerationScope:NameGenerationScope = null;
	var privateNameGenerationScope:NameGenerationScope = null;
	var generatedNames:Set<std.String> = new Set<std.String>(); // NOTE: Used to match Strada, but should be moved to nameGenerationScope after port is complete.

	public function new() {}

	public function PushScope(reuseTempVariableScope:Bool):Void {
		final s = new NameGenerationScope();
		s.next = privateNameGenerationScope;
		privateNameGenerationScope = s;
		if (!reuseTempVariableScope) {
			final t = new NameGenerationScope();
			t.next = nameGenerationScope;
			nameGenerationScope = t;
		}
	}

	public function PopScope(reuseTempVariableScope:Bool):Void {
		if (privateNameGenerationScope != null) {
			privateNameGenerationScope = privateNameGenerationScope.next;
		}
		if (!reuseTempVariableScope && nameGenerationScope != null) {
			nameGenerationScope = nameGenerationScope.next;
		}
	}

	// PORT: pointer — Go `getScope(privateName) **nameGenerationScope` → a getter and a setter.
	inline function getScope(privateName:Bool):NameGenerationScope {
		return privateName ? privateNameGenerationScope : nameGenerationScope;
	}

	inline function setScope(privateName:Bool, scope:NameGenerationScope):Void {
		if (privateName) {
			privateNameGenerationScope = scope;
		} else {
			nameGenerationScope = scope;
		}
	}

	// PORT: pointer — `if *scope == nil { *scope = &nameGenerationScope{} }`.
	function ensureScope(privateName:Bool):NameGenerationScope {
		var scope = getScope(privateName);
		if (scope == null) {
			scope = new NameGenerationScope();
			setScope(privateName, scope);
		}
		return scope;
	}

	function getTempFlags(privateName:Bool):TempFlags {
		final scope = getScope(privateName);
		if (scope != null) {
			return scope.tempFlags;
		}
		return tempFlagsAuto;
	}

	function setTempFlags(privateName:Bool, flags:TempFlags):Void {
		final scope = ensureScope(privateName);
		scope.tempFlags = flags;
	}

	// Gets the TempFlags to use in the current nameGenerationScope for the given key
	function getTempFlagsForFormattedName(privateName:Bool, formattedNameKey:std.String):TempFlags {
		final scope = getScope(privateName);
		if (scope != null) {
			if (scope.formattedNameTempFlags != null && scope.formattedNameTempFlags.exists(formattedNameKey)) {
				return scope.formattedNameTempFlags.get(formattedNameKey);
			}
		}
		return tempFlagsAuto;
	}

	// Sets the TempFlags to use in the current nameGenerationScope for the given key
	function setTempFlagsForFormattedName(privateName:Bool, formattedNameKey:std.String, flags:TempFlags):Void {
		final scope = ensureScope(privateName);
		if (scope.formattedNameTempFlags == null) {
			scope.formattedNameTempFlags = new StringMap<TempFlags>();
		}
		scope.formattedNameTempFlags.set(formattedNameKey, flags);
	}

	function reserveName(name:std.String, privateName:Bool, scoped:Bool, temp:Bool):Void {
		final scope = ensureScope(privateName);
		if (privateName || scoped) {
			scope.reservedNames.Add(name);
		} else if (!temp) {
			generatedNames.Add(name); // NOTE: Matches Strada, but is incorrect.
			// (*scope).generatedNames.Add(name) // TODO: generated names should be scoped after Strada port is complete.
		}
	}

	// Generate the text for a generated identifier or private identifier
	public function GenerateName(name:Node):std.String {
		if (Context != null) {
			final autoGenerate = Context.autoGenerate == null ? null : Context.autoGenerate.get(name);
			if (autoGenerate != null) {
				if (autoGenerate.Flags.IsNode()) {
					// Node names generate unique names based on their original node
					// and are cached based on that node's id.
					return generateNameForNodeCached(Context.GetNodeForGeneratedName(name), Ast.IsPrivateIdentifier(name), autoGenerate.Flags,
						autoGenerate.Prefix, autoGenerate.Suffix);
				} else {
					// Auto, Loop, and Unique names are cached based on their unique autoGenerateId.
					if (autoGeneratedIdToGeneratedName != null && autoGeneratedIdToGeneratedName.exists(autoGenerate.Id)) {
						return autoGeneratedIdToGeneratedName.get(autoGenerate.Id);
					}
					if (autoGeneratedIdToGeneratedName == null) {
						autoGeneratedIdToGeneratedName = new IntMap<std.String>();
					}
					final autoGeneratedName = makeName(name);
					autoGeneratedIdToGeneratedName.set(autoGenerate.Id, autoGeneratedName);
					return autoGeneratedName;
				}
			}
		}
		return GetTextOfNode(name);
	}

	function generateNameForNodeCached(node:Node, privateName:Bool, flags:GeneratedIdentifierFlags, prefix:std.String, suffix:std.String):std.String {
		final nodeId = Ast.GetNodeId(node);
		// PORT: pointer — Go `cache := core.IfElse(privateName, &g.nodeIdToGeneratedPrivateName, &g.nodeIdToGeneratedName)`.
		var cache = privateName ? nodeIdToGeneratedPrivateName : nodeIdToGeneratedName;
		if (cache == null) {
			cache = new IntMap<std.String>();
			if (privateName) {
				nodeIdToGeneratedPrivateName = cache;
			} else {
				nodeIdToGeneratedName = cache;
			}
		}

		if (cache.exists(nodeId)) {
			return cache.get(nodeId);
		}

		final name = generateNameForNode(node, privateName, flags, prefix, suffix);
		cache.set(nodeId, name);
		return name;
	}

	function generateNameForNode(node:Node, privateName:Bool, flags:GeneratedIdentifierFlags, prefix:std.String, suffix:std.String):std.String {
		switch (node.Kind) {
			case KindIdentifier | KindPrivateIdentifier:
				return makeUniqueName(GetTextOfNode(node), null /*checkFn*/, flags.IsOptimistic(), flags.IsReservedInNestedScopes(), privateName, prefix, suffix);
			case KindModuleDeclaration | KindEnumDeclaration:
				if (privateName || prefix.length > 0 || suffix.length > 0) {
					throw "Generated name for a module or enum cannot be private and may have neither a prefix nor suffix";
				}
				return generateNameForModuleOrEnum(node);
			case KindImportDeclaration | KindJSImportDeclaration | KindExportDeclaration:
				if (privateName || prefix.length > 0 || suffix.length > 0) {
					throw "Generated name for an import or export cannot be private and may have neither a prefix nor suffix";
				}
				return generateNameForImportOrExportDeclaration(node);
			case KindFunctionDeclaration | KindClassDeclaration:
				if (privateName || prefix.length > 0 || suffix.length > 0) {
					throw "Generated name for a class or function declaration cannot be private and may have neither a prefix nor suffix";
				}
				final name = node.Name();
				if (name != null && !(Context == null && Context.HasAutoGenerateInfo(name))) {
					return generateNameForNode(name, false /*privateName*/, flags, "" /*prefix*/, "" /*suffix*/);
				}
				return generateNameForExportDefault();
			case KindExportAssignment:
				if (privateName || prefix.length > 0 || suffix.length > 0) {
					throw "Generated name for an export assignment cannot be private and may have neither a prefix nor suffix";
				}
				return generateNameForExportDefault();
			case KindClassExpression:
				if (privateName || prefix.length > 0 || suffix.length > 0) {
					throw "Generated name for a class expression cannot be private and may have neither a prefix nor suffix";
				}
				return generateNameForClassExpression();
			case KindMethodDeclaration | KindGetAccessor | KindSetAccessor:
				return generateNameForMethodOrAccessor(node, privateName, prefix, suffix);
			case KindComputedPropertyName:
				return makeTempVariableName(tempFlagsAuto, true /*reservedInNestedScopes*/, privateName, prefix, suffix);
			default:
				return makeTempVariableName(tempFlagsAuto, false /*reservedInNestedScopes*/, privateName, prefix, suffix);
		}
	}

	function generateNameForModuleOrEnum(node:Node /* ModuleDeclaration | EnumDeclaration */):std.String {
		final name = GetTextOfNode(node.Name());
		// Use module/enum name itself if it is unique, otherwise make a unique variation
		if (Printer.isUniqueLocalName(name, node)) {
			return name;
		} else {
			return makeUniqueName(name, null /*checkFn*/, false /*optimistic*/, false /*scoped*/, false /*privateName*/, "" /*prefix*/, "" /*suffix*/);
		}
	}

	function generateNameForImportOrExportDeclaration(node:Node /* ImportDeclaration | ExportDeclaration */):std.String {
		final expr = Ast.GetExternalModuleName(node);
		var baseName = "module";
		if (Ast.IsStringLiteral(expr)) {
			baseName = Printer.makeIdentifierFromModuleName(expr.Text());
		}
		return makeUniqueName(baseName, null /*checkFn*/, false /*optimistic*/, false /*scoped*/, false /*privateName*/, "" /*prefix*/, "" /*suffix*/);
	}

	function generateNameForExportDefault():std.String {
		return makeUniqueName("default", null /*checkFn*/, false /*optimistic*/, false /*scoped*/, false /*privateName*/, "" /*prefix*/, "" /*suffix*/);
	}

	function generateNameForClassExpression():std.String {
		return makeUniqueName("class", null /*checkFn*/, false /*optimistic*/, false /*scoped*/, false /*privateName*/, "" /*prefix*/, "" /*suffix*/);
	}

	function generateNameForMethodOrAccessor(node:Node /* MethodDeclaration | AccessorDeclaration */, privateName:Bool, prefix:std.String,
			suffix:std.String):std.String {
		if (Ast.IsIdentifier(node.Name())) {
			return generateNameForNodeCached(node.Name(), privateName, GeneratedIdentifierFlagsNone, prefix, suffix);
		}
		return makeTempVariableName(tempFlagsAuto, false /*reservedInNestedScopes*/, privateName, prefix, suffix);
	}

	function makeName(name:Node):std.String {
		if (Context != null) {
			final autoGenerate = Context.autoGenerate == null ? null : Context.autoGenerate.get(name);
			if (autoGenerate != null) {
				switch (autoGenerate.Flags.Kind()) {
					case GeneratedIdentifierFlagsAuto:
						return makeTempVariableName(tempFlagsAuto, autoGenerate.Flags.IsReservedInNestedScopes(), Ast.IsPrivateIdentifier(name),
							autoGenerate.Prefix, autoGenerate.Suffix);
					case GeneratedIdentifierFlagsLoop:
						Debug.Assert(Ast.IsIdentifier(name));
						return makeTempVariableName(tempFlags_i, autoGenerate.Flags.IsReservedInNestedScopes(), false /*privateName*/, autoGenerate.Prefix,
							autoGenerate.Suffix);
					case GeneratedIdentifierFlagsUnique:
						return makeUniqueName(name.Text(), autoGenerate.Flags.IsFileLevel() ? IsFileLevelUniqueNameInCurrentFile : null,
							autoGenerate.Flags.IsOptimistic(), autoGenerate.Flags.IsReservedInNestedScopes(), Ast.IsPrivateIdentifier(name),
							autoGenerate.Prefix, autoGenerate.Suffix);
					default:
				}
			}
		}
		return GetTextOfNode(name);
	}

	// Return the next available name in the pattern _a ... _z, _0, _1, ...
	// TempFlags._i may be used to express a preference for that dedicated name.
	// Note that names generated by makeTempVariableName and makeUniqueName will never conflict.
	function makeTempVariableName(flags:TempFlags, reservedInNestedScopes:Bool, privateName:Bool, prefix:std.String, suffix:std.String):std.String {
		var tempFlags:TempFlags = tempFlagsAuto;
		var key = "";
		final simple = prefix.length == 0 && suffix.length == 0;
		if (simple) {
			tempFlags = getTempFlags(privateName);
		} else {
			// Generate a key to use to acquire a TempFlags counter based on the fixed portions of the generated name.
			key = Printer.FormatGeneratedName(privateName, prefix, "" /*base*/, suffix);
			if (privateName) {
				key = Printer.ensureLeadingHash(key);
			}
			tempFlags = getTempFlagsForFormattedName(privateName, key);
		}

		if ((flags : Int) != 0 && (tempFlags & flags : Int) == 0) {
			final fullName = Printer.FormatGeneratedName(privateName, prefix, "_i", suffix);
			if (isUniqueName(fullName, privateName)) {
				tempFlags |= flags;
				reserveName(fullName, privateName, reservedInNestedScopes, true /*temp*/);
				if (simple) {
					setTempFlags(privateName, tempFlags);
				} else {
					setTempFlagsForFormattedName(privateName, key, tempFlags);
				}
				return fullName;
			}
		}

		while (true) {
			final count:Int = tempFlags & tempFlagsCountMask;
			tempFlags = (tempFlags : Int) + 1;
			// Skip over 'i' and 'n'
			if (count != 8 && count != 13) {
				var name:std.String;
				if (count < 26) {
					name = "_" + std.String.fromCharCode("a".code + count);
				} else {
					name = "_" + (count - 26);
				}
				final fullName = Printer.FormatGeneratedName(privateName, prefix, name, suffix);
				if (isUniqueName(fullName, privateName)) {
					reserveName(fullName, privateName, reservedInNestedScopes, true /*temp*/);
					if (simple) {
						setTempFlags(privateName, tempFlags);
					} else {
						setTempFlagsForFormattedName(privateName, key, tempFlags);
					}
					return fullName;
				}
			}
		}
	}

	// Generate a name that is unique within the current file and doesn't conflict with any names
	// in global scope. The name is formed by adding an '_n' suffix to the specified base name,
	// where n is a positive integer. Note that names generated by makeTempVariableName and
	// makeUniqueName are guaranteed to never conflict.
	// If `optimistic` is set, the first instance will use 'baseName' verbatim instead of 'baseName_1'
	function makeUniqueName(baseName:std.String, checkFn:(name:std.String, privateName:Bool) -> Bool, optimistic:Bool, scoped:Bool, privateName:Bool,
			prefix:std.String, suffix:std.String):std.String {
		baseName = Printer.removeLeadingHash(baseName);
		if (optimistic) {
			final fullName = Printer.FormatGeneratedName(privateName, prefix, baseName, suffix);
			if (checkUniqueName(fullName, privateName, checkFn)) {
				reserveName(fullName, privateName, scoped, false /*temp*/);
				return fullName;
			}
		}

		// Find the first unique 'name_n', where n is a positive integer
		if (baseName.length > 0 && StringTools.fastCodeAt(baseName, baseName.length - 1) != "_".code) {
			baseName += "_";
		}

		var i = 1;
		while (true) {
			final fullName = Printer.FormatGeneratedName(privateName, prefix, baseName + i, suffix);
			if (checkUniqueName(fullName, privateName, checkFn)) {
				reserveName(fullName, privateName, scoped, false /*temp*/);
				return fullName;
			}
			i++;
		}
	}

	public function MakeFileLevelOptimisticUniqueName(name:std.String):std.String {
		return makeUniqueName(name, IsFileLevelUniqueNameInCurrentFile, true /*optimistic*/, false /*scoped*/, false /*privateName*/, "" /*prefix*/,
			"" /*suffix*/);
	}

	function checkUniqueName(name:std.String, privateName:Bool, checkFn:(name:std.String, privateName:Bool) -> Bool):Bool {
		if (checkFn != null) {
			return checkFn(name, privateName);
		} else {
			return isUniqueName(name, privateName);
		}
	}

	function isUniqueName(name:std.String, privateName:Bool):Bool {
		return (IsFileLevelUniqueNameInCurrentFile == null || IsFileLevelUniqueNameInCurrentFile(name, privateName))
			&& !isReservedName(name, privateName);
	}

	function isReservedName(name:std.String, privateName:Bool):Bool {
		var scope = getScope(privateName);

		// NOTE: The following matches Strada, but is incorrect.
		if (generatedNames.Has(name)) {
			return true;
		}

		// TODO: generated names should be scoped after Strada port is complete.
		////if *scope != nil {
		////	if (*scope).generatedNames.Has(name) {
		////		return true
		////	}
		////}

		while (scope != null) {
			if (scope.reservedNames.Has(name)) {
				return true;
			}
			scope = scope.next;
		}
		return false;
	}
}

// PORT: unexported Go type `nameGenerationScope` → NameGenerationScope (PORTING.md §1).
class NameGenerationScope {
	public var next:NameGenerationScope = null; // The next nameGenerationScope in the stack
	public var tempFlags:TempFlags = tempFlagsAuto; // TempFlags for the current name generation scope.
	public var formattedNameTempFlags:StringMap<TempFlags> = null; // TempFlags for the current name generation scope.
	public var reservedNames:Set<std.String> = new Set<std.String>(); // Names reserved in nested name generation scopes.

	// generatedNames         collections.Set[string] // NOTE: generated names should be scoped after Strada port is complete.

	public function new() {}
}
