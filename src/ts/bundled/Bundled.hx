package ts.bundled;

import go.Errors.Error;
import go.Fs.FileMode;
import go.Tuple.ValueOk;
import haxe.ds.StringMap;
import ts.tspath.Tspath;
import ts.vfs.Vfs;

// Package bundled provides access to files bundled with TypeScript.
// Port of bundled.go, embed.go (the default `!noembed` build), libs_generated.go and
// embed_generated.go. The generated parts (LibNames, libsEntries) and the embedded lib files
// (haxe.Resource "bundled/libs/<name>") come from BundledMacro. The types of embed.go are in Embed.hx.
// PORT: the `noembed` variant (noembed.go: libs on disk next to the executable) is not ported.
@:build(ts.bundled.BundledMacro.build())
class Bundled {
	// --- bundled.go ---

	// Define the below here to consolidate documentation.

	// Embedded is true if the bundled files are implemented through an embedded FS.
	public static inline final Embedded = embedded;

	// WrapFS returns an FS which redirects embedded paths to the embedded file system.
	// If the embedded file system is not available, it returns the original FS.
	public static function WrapFS(fs:FS):FS {
		return wrapFS(fs);
	}

	// LibPath returns the path to the directory containing the bundled lib.d.ts files.
	// If embedding is not enabled, this is a path on disk, and must be accessed through
	// a real OS filesystem.
	public static function LibPath():String {
		return libPath();
	}

	// PORT: runtime.Caller(0) → the directory of Bundled.hx, recorded at compile time.
	static function bundledSourceDir():String {
		return go.Filepath.Dir(go.Filepath.FromSlash(bundledSourceDirValue + "/Bundled.hx"));
	}

	static var testingLibPathValue:Null<String> = null;

	// PORT: sync.OnceValue → lazy field. testing.Testing() has no Haxe equivalent: not checked.
	static function testingLibPath():String {
		if (testingLibPathValue == null) {
			testingLibPathValue = Tspath.NormalizeSlashes(go.Filepath.Join([bundledSourceDir(), "libs"]));
		}
		return testingLibPathValue;
	}

	// TestingLibPath returns the path to the source bundled libs directory.
	// It's only valid to use in tests where the source code is available.
	public static function TestingLibPath():String {
		return testingLibPath();
	}

	// --- embed.go ---

	static inline final embedded = true;

	@:allow(ts.bundled)
	static inline final scheme = "bundled:///";

	// (rest, ok)
	@:allow(ts.bundled)
	static function splitPath(path:String):ValueOk<String> {
		if (StringTools.startsWith(path, scheme)) {
			return new ValueOk(path.substring(scheme.length), true);
		}
		return new ValueOk(path, false);
	}

	static function libPath():String {
		return scheme + "libs";
	}

	public static function IsBundled(path:String):Bool {
		return splitPath(path).ok;
	}

	static function wrapFS(fs:FS):FS {
		return new ts.bundled.Embed.WrappedFS(fs);
	}

	@:allow(ts.bundled)
	static final rootEntries:Array<go.Fs.DirEntry> = [go.Fs.Fs.FileInfoToDirEntry(new ts.bundled.Embed.FileInfo(ModeDir, "libs", 0)),];

	// --- embed_generated.go ---

	// PORT: Go initializes the map of embedded strings at startup; here it is filled on first
	// use from the haxe.Resource of each lib. libsEntries is generated by BundledMacro.
	static var embeddedContentsValue:Null<StringMap<String>> = null;

	@:allow(ts.bundled)
	static var embeddedContents(get, never):StringMap<String>;

	static function get_embeddedContents():StringMap<String> {
		if (embeddedContentsValue == null) {
			final m = new StringMap<String>();
			for (name in LibNames) {
				m.set("libs/" + name, haxe.Resource.getString("bundled/libs/" + name));
			}
			embeddedContentsValue = m;
		}
		return embeddedContentsValue;
	}
}
