package go.text.internal.language;

import go.Errors;
import go.Errors.Error;
import go.Tuple.Pair;
import go.Tuple.ValueError as VE;
import go.text.internal.language.Tables.*;

// Port of golang.org/x/text/internal/language (v0.38.0, the version pinned by upstream go.mod):
// the parts that language.Parse, language.NewMatcher and Matcher.Match use.
// Tables (tables.go) are generated by tools/gen/diagnostics/GenLanguageTables.hx.
// Also holds the used parts of golang.org/x/text/internal/tag (Index, FixCase, Compare).
// PORT: not ported (unused by tsc): Builder (compose.go), Parent, minimize, ParseExtension,
// ParseBase/ParseScript/ParseVariant, ISO3, TLD, coverage.
class Language {
	// --- parse.go ---

	// isAlpha returns true if the byte is not a digit.
	// b must be an ASCII letter or digit.
	static inline function isAlpha(b:Int):Bool {
		return b > '9'.code;
	}

	// ErrSyntax is returned by any of the parsing functions when the
	// input is not well-formed, according to BCP 47.
	public static final ErrSyntax:Error = Errors.New("language: tag is not well-formed");

	// ErrDuplicateKey is returned when a tag contains the same key twice with
	// different values in the -u section.
	public static final ErrDuplicateKey:Error = Errors.New("language: different values for same key in -u extension");

	// NewValueError creates a new ValueError.
	public static function NewValueError(tag:ByteSlice):ValueError {
		final e = new ValueError();
		final n = tag.len < 8 ? tag.len : 8;
		for (i in 0...n)
			e.v[i] = tag.get(i);
		return e;
	}

	static function makeScannerString(s:ByteSlice):Scanner {
		final scan = new Scanner();
		if (s.len <= max99thPercentileSize) {
			// scan.b = scan.bytes[:copy(scan.bytes[:], s)]
			final bytes = ByteSlice.make(max99thPercentileSize);
			scan.b = bytes.to(ByteSlice.copy(bytes, s));
		} else {
			// PORT: Go's []byte(s) may round the capacity up; capacity never changes the result.
			scan.b = ByteSlice.make(s.len);
			ByteSlice.copy(scan.b, s);
		}
		scan.init();
		return scan;
	}

	// makeScanner returns a scanner using b as the input buffer.
	// b is not copied and may be modified by the scanner routines.
	static function makeScanner(b:ByteSlice):Scanner {
		final scan = new Scanner();
		scan.b = b;
		scan.init();
		return scan;
	}

	// Parse parses the given BCP 47 string and returns a valid Tag. If parsing
	// failed it returns an error and any part of the tag that could be parsed.
	// If parsing succeeded but an unknown value was found, it returns
	// ValueError. The Tag returned in this case is just stripped of the unknown
	// value. All other values are preserved.
	public static function Parse(s:String):VE<Tag> {
		// TODO: consider supporting old-style locale key-value pairs.
		if (s == "")
			return new VE(Und(), ErrSyntax);
		try {
			final sb = ByteSlice.ofString(s);
			if (sb.len <= maxAltTaglen) {
				final b = [for (_ in 0...maxAltTaglen) 0];
				// for i, c := range s: i is the byte offset of rune c.
				var i = 0;
				while (i < sb.len) {
					final r = decodeRune(sb, i);
					var c = r.a;
					// Generating invalid UTF-8 is okay as it won't match.
					if ('A'.code <= c && c <= 'Z'.code) {
						c += 'a'.code - 'A'.code;
					} else if (c == '_'.code) {
						c = '-'.code;
					}
					b[i] = c & 0xff;
					i += r.b;
				}
				final g = grandfathered(b);
				if (g.ok)
					return new VE(g.value, null);
			}
			final scan = makeScannerString(sb);
			return parse(scan, sb);
		} catch (e:Dynamic) {
			// defer recover(): t = Und, err = ErrSyntax
			return new VE(Und(), ErrSyntax);
		}
	}

	// utf8.DecodeRuneInString on the UTF-8 bytes (input comes from a valid UTF-16 string).
	static function decodeRune(s:ByteSlice, i:Int):Pair<Int, Int> {
		final c0 = s.get(i);
		if (c0 < 0x80)
			return new Pair(c0, 1);
		if (c0 < 0xE0 && i + 1 < s.len)
			return new Pair(((c0 & 0x1F) << 6) | (s.get(i + 1) & 0x3F), 2);
		if (c0 < 0xF0 && i + 2 < s.len)
			return new Pair(((c0 & 0x0F) << 12) | ((s.get(i + 1) & 0x3F) << 6) | (s.get(i + 2) & 0x3F), 3);
		if (i + 3 < s.len)
			return new Pair(((c0 & 0x07) << 18) | ((s.get(i + 1) & 0x3F) << 12) | ((s.get(i + 2) & 0x3F) << 6) | (s.get(i + 3) & 0x3F), 4);
		return new Pair(0xFFFD, 1);
	}

	static function parse(scan:Scanner, s:ByteSlice):VE<Tag> {
		var t = Und();
		var end = 0;
		final n0 = scan.tokenLen();
		if (n0 <= 1) {
			scan.toLower(0, scan.b.len);
			if (n0 == 0 || scan.token.get(0) != 'x'.code)
				return new VE(t, ErrSyntax);
			end = parseExtensions(scan);
		} else if (n0 >= 4) {
			return new VE(Und(), ErrSyntax);
		} else { // the usual case
			final r = parseTag(scan, true);
			t = r.a;
			end = r.b;
			if (scan.tokenLen() == 1) {
				t.pExt = end & 0xffff;
				end = parseExtensions(scan);
			} else if (end < scan.b.len) {
				scan.setError(ErrSyntax);
				scan.b = scan.b.to(end);
			}
		}
		if (t.pVariant < scan.b.len) {
			if (end < s.len)
				s = s.to(end);
			if (s.len > 0 && ByteSlice.compare(s, scan.b) == 0) {
				t.str = s.toString();
			} else {
				t.str = scan.b.toString();
			}
		} else {
			t.pVariant = 0;
			t.pExt = 0;
		}
		return new VE(t, scan.err);
	}

	// parseTag parses language, script, region and variants.
	// It returns a Tag and the end position in the input that was parsed.
	// If doNorm is true, then <lang>-<extlang> will be normalized to <extlang>.
	static function parseTag(scan:Scanner, doNorm:Bool):Pair<Tag, Int> {
		final t = new Tag();
		var e:Null<Error> = null;
		// TODO: set an error if an unknown lang, script or region is encountered.
		var r = getLangID(scan.token);
		t.LangID = r.value;
		e = r.err;
		scan.setError(e);
		scan.replace(t.LangID.String());
		final langStart = scan.start;
		var end = scan.scan();
		while (scan.tokenLen() == 3 && isAlpha(scan.token.get(0))) {
			// From http://tools.ietf.org/html/bcp47, <lang>-<extlang> tags are equivalent
			// to a tag of the form <extlang>.
			if (doNorm) {
				final r2 = getLangID(scan.token);
				final lang = r2.value;
				if (lang != 0) {
					t.LangID = lang;
					final langStr = lang.String();
					ByteSlice.copyString(scan.b.from(langStart), langStr);
					scan.b.set(langStart + langStr.length, '-'.code);
					scan.start = langStart + langStr.length + 1;
				}
				scan.gobble(r2.err);
			}
			end = scan.scan();
		}
		if (scan.tokenLen() == 4 && isAlpha(scan.token.get(0))) {
			final r3 = getScriptID(script, scan.token);
			t.ScriptID = r3.value;
			if (t.ScriptID == 0)
				scan.gobble(r3.err);
			end = scan.scan();
		}
		final n = scan.tokenLen();
		if (n >= 2 && n <= 3) {
			final r4 = getRegionID(scan.token);
			t.RegionID = r4.value;
			if (t.RegionID == 0) {
				scan.gobble(r4.err);
			} else {
				scan.replace(t.RegionID.String());
			}
			end = scan.scan();
		}
		scan.toLower(scan.start, scan.b.len);
		t.pVariant = end & 0xff;
		end = parseVariants(scan, end, t);
		t.pExt = end & 0xffff;
		return new Pair(t, end);
	}

	// parseVariants scans tokens as long as each token is a valid variant string.
	// Duplicate variants are removed.
	static function parseVariants(scan:Scanner, end:Int, t:Tag):Int {
		final start = scan.start;
		final varID:Array<Int> = [];
		final variant:Array<ByteSlice> = [];
		var last = -1;
		var needSort = false;
		while (scan.tokenLen() >= 4) {
			// TODO: measure the impact of needing this conversion and redesign
			// the data structure if there is an issue.
			final key = scan.token.toString();
			final idx = variantIndexMap();
			if (!idx.exists(key)) {
				// unknown variant
				// TODO: allow user-defined variants?
				scan.gobble(NewValueError(scan.token));
				scan.scan();
				continue;
			}
			final v = idx.get(key);
			varID.push(v);
			variant.push(scan.token);
			if (!needSort) {
				if (last < v) {
					last = v;
				} else {
					needSort = true;
					// There is no legal combinations of more than 7 variants
					// (and this is by no means a useful sequence).
					final maxVariants = 8;
					if (varID.length > maxVariants)
						break;
				}
			}
			end = scan.end;
			scan.scan();
		}
		if (needSort) {
			// sort.Sort(variantsSort{varID, variant})
			final pairs = [for (i in 0...varID.length) new Pair(varID[i], variant[i])];
			go.Slices.SortFunc(pairs, (x, y) -> x.a < y.a ? -1 : (x.a > y.a ? 1 : 0));
			for (i in 0...pairs.length) {
				varID[i] = pairs[i].a;
				variant[i] = pairs[i].b;
			}
			var k = 0;
			var l = -1;
			for (i in 0...varID.length) {
				final w = varID[i];
				if (l == w) {
					// Remove duplicates.
					continue;
				}
				varID[k] = varID[i];
				variant[k] = variant[i];
				k++;
				l = w;
			}
			final str = ByteSlice.join(variant.slice(0, k), '-'.code);
			if (str.len == 0) {
				end = start - 1;
			} else {
				scan.resizeRange(start, end, str.len);
				ByteSlice.copy(scan.b.from(scan.start), str);
				end = scan.end;
			}
		}
		return end;
	}

	// bytesSort.Less as a comparison over the first n bytes.
	static function bytesSortCmp(n:Int):(ByteSlice, ByteSlice) -> Int {
		return (x, y) -> {
			for (k in 0...n) {
				if (x.get(k) == y.get(k))
					continue;
				return x.get(k) < y.get(k) ? -1 : 1;
			}
			return 0;
		};
	}

	// parseExtensions parses and normalizes the extensions in the buffer.
	// It returns the last position of scan.b that is part of any extension.
	// It also trims scan.b to remove excess parts accordingly.
	static function parseExtensions(scan:Scanner):Int {
		final start = scan.start;
		final exts:Array<ByteSlice> = [];
		var private_:ByteSlice = ByteSlice.make(0);
		var end = scan.end;
		while (scan.tokenLen() == 1) {
			final extStart = scan.start;
			final ext = scan.token.get(0);
			end = parseExtension(scan);
			final extension = scan.b.slice(extStart, end);
			if (extension.len < 3 || (ext != 'x'.code && extension.len < 4)) {
				scan.setError(ErrSyntax);
				end = extStart;
				continue;
			} else if (start == extStart && (ext == 'x'.code || scan.start == scan.b.len)) {
				scan.b = scan.b.to(end);
				return end;
			} else if (ext == 'x'.code) {
				private_ = extension;
				break;
			}
			exts.push(extension);
		}
		go.Slices.SortFunc(exts, bytesSortCmp(1));
		if (private_.len > 0)
			exts.push(private_);
		scan.b = scan.b.to(start);
		if (exts.length > 0) {
			scan.b = ByteSlice.append(scan.b, ByteSlice.join(exts, '-'.code));
		} else if (start > 0) {
			// Strip trailing '-'.
			scan.b = scan.b.to(start - 1);
		}
		return end;
	}

	// parseExtension parses a single extension and returns the position of
	// the extension end.
	static function parseExtension(scan:Scanner):Int {
		final start = scan.start;
		var end = scan.end;
		switch (scan.token.get(0)) {
			case 'u'.code: // https://www.ietf.org/rfc/rfc6067.txt
				final attrStart = end;
				scan.scan();
				var last:ByteSlice = ByteSlice.make(0);
				while (scan.tokenLen() > 2) {
					if (ByteSlice.compare(scan.token, last) != -1) {
						// Attributes are unsorted. Start over from scratch.
						final p = attrStart + 1;
						scan.next = p;
						final attrs:Array<ByteSlice> = [];
						scan.scan();
						while (scan.tokenLen() > 2) {
							attrs.push(scan.token);
							end = scan.end;
							scan.scan();
						}
						go.Slices.SortFunc(attrs, bytesSortCmp(3));
						ByteSlice.copy(scan.b.from(p), ByteSlice.join(attrs, '-'.code));
						break;
					}
					last = scan.token;
					end = scan.end;
					scan.scan();
				}
				// Scan key-type sequences. A key is of length 2 and may be followed
				// by 0 or more "type" subtags from 3 to the maximum of 8 letters.
				var lastKey:Null<ByteSlice> = null;
				var key:Null<ByteSlice> = null;
				final attrEnd = end;
				while (scan.tokenLen() == 2) {
					key = scan.token;
					end = scan.end;
					scan.scan();
					while (end < scan.end && scan.tokenLen() > 2) {
						end = scan.end;
						scan.scan();
					}
					// TODO: check key value validity
					if (ByteSlice.compare(key, lastKey) != 1 || scan.err != null) {
						// We have an invalid key or the keys are not sorted.
						// Start scanning keys from scratch and reorder.
						final p = attrEnd + 1;
						scan.next = p;
						var keys:Array<ByteSlice> = [];
						scan.scan();
						while (scan.tokenLen() == 2) {
							final keyStart = scan.start;
							end = scan.end;
							scan.scan();
							while (end < scan.end && scan.tokenLen() > 2) {
								end = scan.end;
								scan.scan();
							}
							keys.push(scan.b.slice(keyStart, end));
						}
						go.Slices.SortStableFunc(keys, bytesSortCmp(2));
						final n = keys.length;
						if (n > 0) {
							var k = 0;
							for (i in 1...n) {
								if (!ByteSlice.equal(keys[k].to(2), keys[i].to(2))) {
									k++;
									keys[k] = keys[i];
								} else if (!ByteSlice.equal(keys[k], keys[i])) {
									scan.setError(ErrDuplicateKey);
								}
							}
							keys = keys.slice(0, k + 1);
						}
						final reordered = ByteSlice.join(keys, '-'.code);
						final e = p + reordered.len;
						if (e < end) {
							scan.deleteRange(e, end);
							end = e;
						}
						ByteSlice.copy(scan.b.from(p), reordered);
						break;
					}
					lastKey = key;
				}
			case 't'.code: // https://www.ietf.org/rfc/rfc6497.txt
				scan.scan();
				final n = scan.tokenLen();
				if (n >= 2 && n <= 3 && isAlpha(scan.token.get(1))) {
					end = parseTag(scan, false).b;
					scan.toLower(start, end);
				}
				while (scan.tokenLen() == 2 && !isAlpha(scan.token.get(1)))
					end = scan.acceptMinSize(3);
			case 'x'.code:
				end = scan.acceptMinSize(1);
			default:
				end = scan.acceptMinSize(2);
		}
		return end;
	}

	// getExtension returns the name, body and end position of the extension.
	@:allow(go.text.internal.language)
	static function getExtension(s:String, p:Int):Pair<Int, String> {
		if (byteAt(s, p) == '-'.code)
			p++;
		if (byteAt(s, p) == 'x'.code)
			return new Pair(s.length, s.substr(p));
		final end = nextExtension(s, p);
		return new Pair(end, s.substring(p, end));
	}

	// nextExtension finds the next extension within the string, searching
	// for the -<char>- pattern from position p.
	// In the fast majority of cases, language tags will have at most
	// one extension and extensions tend to be small.
	@:allow(go.text.internal.language)
	static function nextExtension(s:String, p:Int):Int {
		final n = s.length - 3;
		while (p < n) {
			if (byteAt(s, p) == '-'.code) {
				if (byteAt(s, p + 2) == '-'.code)
					return p;
				p += 3;
			} else {
				p++;
			}
		}
		return s.length;
	}

	// Go s[i] on a string (panics out of range).
	@:allow(go.text.internal.language)
	static function byteAt(s:String, i:Int):Int {
		if (i < 0 || i >= s.length)
			throw "index out of range";
		return StringTools.fastCodeAt(s, i);
	}

	@:allow(go.text.internal.language)
	static final errPrivateUse:Error = Errors.New("cannot set a key on a private use tag");

	@:allow(go.text.internal.language)
	static final errInvalidArguments:Error = Errors.New("invalid key or type");

	// ParseRegion parses a 2- or 3-letter ISO 3166-1 or a UN M.49 code.
	// It returns a ValueError if s is a well-formed but unknown region identifier
	// or another error if another error occurred.
	public static function ParseRegion(s:String):VE<Region> {
		try {
			final b = ByteSlice.ofString(s);
			final n = b.len;
			if (n < 2 || 3 < n)
				return new VE((0 : Region), ErrSyntax);
			final buf = ByteSlice.make(3);
			return getRegionID(buf.to(ByteSlice.copy(buf, b)));
		} catch (e:Dynamic) {
			return new VE((0 : Region), ErrSyntax);
		}
	}

	@:allow(go.text.internal.language)
	static function scanForSetTypeForKey(b:ByteSlice):Null<Error> {
		final scan = makeScanner(b);
		parseExtensions(scan);
		return scan.err;
	}

	// --- compact.go ---

	// GetCompactCore generates a uint32 value that is guaranteed to be unique for
	// different language, region, and script values.
	// PORT: CompactCoreInfo is an Int (the values fit in 31 bits).
	public static function GetCompactCore(t:Tag):go.Tuple.ValueOk<Int> {
		if ((t.LangID : Int) > langNoIndexOffset)
			return new go.Tuple.ValueOk(0, false);
		var cci = 0;
		cci |= (t.LangID : Int) << (8 + 12);
		cci |= (t.ScriptID : Int) << 12;
		cci |= (t.RegionID : Int);
		return new go.Tuple.ValueOk(cci, true);
	}

	// CompactCoreInfo.Tag generates a tag from c.
	public static function CompactCoreInfoTag(c:Int):Tag {
		final t = new Tag();
		t.LangID = c >>> 20;
		t.RegionID = c & 0x3ff;
		t.ScriptID = (c >>> 12) & 0xff;
		return t;
	}

	// --- language.go ---

	// maxCoreSize is the maximum size of a BCP 47 tag without variants and
	// extensions. Equals max lang (3) + script (4) + max reg (3) + 2 dashes.
	static inline final maxCoreSize = 12;

	// max99thPercentileSize is a somewhat arbitrary buffer size that presumably
	// is large enough to hold at least 99% of the BCP 47 tags.
	static inline final max99thPercentileSize = 32;

	// Make is a convenience wrapper for Parse that omits the error.
	// In case of an error, a sensible default is returned.
	public static function Make(s:String):Tag {
		return Parse(s).value;
	}

	// --- lookup.go ---

	// findIndex tries to find the given tag in idx and returns a standardized error
	// if it could not be found.
	static function findIndex(idx:Array<Int>, key:ByteSlice, form:String):VE<Int> {
		if (!FixCase(form, key))
			return new VE(0, ErrSyntax);
		final i = indexIndex(idx, key);
		if (i == -1)
			return new VE(0, NewValueError(key));
		return new VE(i, null);
	}

	// getLangID returns the langID of s if s is a canonical subtag
	// or langUnknown if s is not a canonical subtag.
	static function getLangID(s:ByteSlice):VE<Language_> {
		if (s.len == 2)
			return getLangISO2(s);
		return getLangISO3(s);
	}

	// normLang returns the mapped langID of id according to mapping m.
	public static function normLang(id:Language_):Pair<Language_, AliasType> {
		final k = search(Std.int(AliasMap.length / AliasMap_STRIDE), i -> AliasMap[i * AliasMap_STRIDE] >= (id : Int));
		if (k < Std.int(AliasMap.length / AliasMap_STRIDE) && AliasMap[k * AliasMap_STRIDE] == (id : Int))
			return new Pair((AliasMap[k * AliasMap_STRIDE + 1] : Language_), (AliasTypes[k] : AliasType));
		return new Pair(id, AliasTypeUnknown);
	}

	// getLangISO2 returns the langID for the given 2-letter ISO language code
	// or unknownLang if this does not exist.
	static function getLangISO2(s:ByteSlice):VE<Language_> {
		if (!FixCase("zz", s))
			return new VE((0 : Language_), ErrSyntax);
		final i = indexIndex(lang, s);
		if (i != -1 && lang[i * 4 + 3] != 0)
			return new VE((i : Language_), null);
		return new VE((0 : Language_), NewValueError(s));
	}

	static inline final base = 'z'.code - 'a'.code + 1;

	static function strToInt(s:ByteSlice):Int {
		var v = 0;
		for (i in 0...s.len) {
			v *= base;
			v += (s.get(i) - 'a'.code) & 0xff;
		}
		return v;
	}

	// converts the given integer to the original ASCII string passed to strToInt.
	// len(s) must match the number of characters obtained.
	static function intToStr(v:Int, n:Int):String {
		final s = [for (_ in 0...n) 0];
		var i = n - 1;
		while (i >= 0) {
			s[i] = (v % base) + 'a'.code;
			v = Std.int(v / base);
			i--;
		}
		return [for (c in s) String.fromCharCode(c)].join("");
	}

	// getLangISO3 returns the langID for the given 3-letter ISO language code
	// or unknownLang if this does not exist.
	static function getLangISO3(s:ByteSlice):VE<Language_> {
		if (FixCase("und", s)) {
			// first try to match canonical 3-letter entries
			var i = indexIndex(lang, s.to(2));
			while (i != -1) {
				if (lang[i * 4 + 3] == 0 && lang[i * 4 + 2] == s.get(2)) {
					// We treat "und" as special and always translate it to "unspecified".
					// Note that ZZ and Zzzz are private use and are not treated as
					// unspecified by default.
					final id:Language_ = i;
					if (id == nonCanonicalUnd)
						return new VE((0 : Language_), null);
					return new VE(id, null);
				}
				i = indexNext(lang, s.to(2), i);
			}
			final j = indexIndex(altLangISO3, s);
			if (j != -1)
				return new VE((altLangIndex[altLangISO3[j * 4 + 3]] : Language_), null);
			final n = strToInt(s);
			if ((langNoIndex[n >> 3] & (1 << (n % 8))) != 0)
				return new VE(((n + langNoIndexOffset) : Language_), null);
			// Check for non-canonical uses of ISO3.
			var k = indexIndex(lang, s.to(1));
			while (k != -1) {
				if (lang[k * 4 + 2] == s.get(1) && lang[k * 4 + 3] == s.get(2))
					return new VE((k : Language_), null);
				k = indexNext(lang, s.to(1), k);
			}
			return new VE((0 : Language_), NewValueError(s));
		}
		return new VE((0 : Language_), ErrSyntax);
	}

	// getRegionID returns the region id for s if s is a valid 2-letter region code
	// or unknownRegion.
	static function getRegionID(s:ByteSlice):VE<Region> {
		if (s.len == 3) {
			if (isAlpha(s.get(0)))
				return getRegionISO3(s);
			// strconv.ParseUint(string(s), 10, 10)
			var ok = true;
			var v = 0;
			for (i in 0...3) {
				final c = s.get(i);
				if (c < '0'.code || c > '9'.code) {
					ok = false;
					break;
				}
				v = v * 10 + (c - '0'.code);
			}
			if (ok && v < 1024)
				return getRegionM49(v);
		}
		return getRegionISO2(s);
	}

	// getRegionISO2 returns the regionID for the given 2-letter ISO country code
	// or unknownRegion if this does not exist.
	static function getRegionISO2(s:ByteSlice):VE<Region> {
		final r = findIndex(regionISO, s, "ZZ");
		if (r.err != null)
			return new VE((0 : Region), r.err);
		return new VE(((r.value + isoRegionOffset) : Region), null);
	}

	// getRegionISO3 returns the regionID for the given 3-letter ISO country code
	// or unknownRegion if this does not exist.
	static function getRegionISO3(s:ByteSlice):VE<Region> {
		if (FixCase("ZZZ", s)) {
			var i = indexIndex(regionISO, s.to(1));
			while (i != -1) {
				if (regionISO[i * 4 + 2] == s.get(1) && regionISO[i * 4 + 3] == s.get(2))
					return new VE(((i + isoRegionOffset) : Region), null);
				i = indexNext(regionISO, s.to(1), i);
			}
			var i = 0;
			while (i < altRegionISO3.length) {
				if (cmpIndex(altRegionISO3, i, i + 3, s) == 0)
					return new VE((altRegionIDs[Std.int(i / 3)] : Region), null);
				i += 3;
			}
			return new VE((0 : Region), NewValueError(s));
		}
		return new VE((0 : Region), ErrSyntax);
	}

	static function getRegionM49(n:Int):VE<Region> {
		if (0 < n && n <= 999) {
			final searchBits = 7;
			final regionBits = 9;
			final regionMask = (1 << regionBits) - 1;
			final idx = n >> searchBits;
			final lo = m49Index[idx];
			final hi = m49Index[idx + 1];
			if (lo > hi || hi > fromM49.length)
				throw "slice bounds out of range";
			final val = (n << regionBits) & 0xffff; // we rely on bits shifting out
			final i = search(hi - lo, i -> fromM49[lo + i] >= val);
			final at = lo + i;
			if (at >= fromM49.length)
				throw "index out of range";
			final r = fromM49[at];
			if ((r & ~regionMask) == val)
				return new VE(((r & regionMask) : Region), null);
		}
		// PORT: Go writes n into a buffer that does not alias e.v; the error carries no subtag.
		return new VE((0 : Region), new ValueError());
	}

	// normRegion returns a region if r is deprecated or 0 otherwise.
	static function normRegion(r:Region):Region {
		final n = Std.int(regionOldMap.length / regionOldMap_STRIDE);
		final k = search(n, i -> regionOldMap[i * regionOldMap_STRIDE] >= (r : Int));
		if (k < n && regionOldMap[k * regionOldMap_STRIDE] == (r : Int))
			return regionOldMap[k * regionOldMap_STRIDE + 1];
		return 0;
	}

	// getScriptID returns the script id for string s. It assumes that s
	// is of the format [A-Z][a-z]{3}.
	static function getScriptID(idx:Array<Int>, s:ByteSlice):VE<Script> {
		final r = findIndex(idx, s, "Zzzz");
		return new VE((r.value : Script), r.err);
	}

	static inline final maxAltTaglen = 11; // len("en-US-POSIX")

	static var grandfatheredMap_:Map<String, Int> = null;

	// grandfatheredMap holds a mapping from legacy and grandfathered tags to
	// their base language or index to more elaborate tag.
	// PORT: Go's [maxLen]byte key is encoded as a string of its byte values.
	static function grandfatheredMap():Map<String, Int> {
		if (grandfatheredMap_ == null) {
			final m = new Map<String, Int>();
			final names:Array<String> = [
				"art-lojban", "i-ami", "i-bnn", "i-hak", "i-klingon", "i-lux", "i-navajo", "i-pwn", "i-tao", "i-tay", "i-tsu", "no-bok",
				"no-nyn", "sgn-be-fr", "sgn-be-nl", "sgn-ch-de", "zh-guoyu", "zh-hakka", "zh-min-nan", "zh-xiang",
				// Grandfathered tags with no modern replacement will be converted as
				// follows:
				"cel-gaulish", "en-gb-oed", "i-default", "i-enochian", "i-mingo", "zh-min",
				// CLDR-specific tag.
				"root", "en-us-posix",
			];
			final values:Array<Int> = [
				_jbo, _ami, _bnn, _hak, _tlh, _lb, _nv, _pwn, _tao, _tay, _tsu, _nb, _nn, _sfb, _vgt, _sgg, _cmn, _hak, _nan, _hsn,
				-1, -2, -3, -4, -5, -6,
				0, -7,
			];
			for (k in 0...names.length) {
				final name = names[k];
				final b = [for (_ in 0...maxAltTaglen) 0];
				for (i in 0...name.length)
					b[i] = StringTools.fastCodeAt(name, i);
				m.set(b.join(","), values[k]);
			}
			grandfatheredMap_ = m;
		}
		return grandfatheredMap_;
	}

	static final altTagIndex = [0, 17, 31, 45, 61, 74, 86, 102];

	static inline final altTags = "xtg-x-cel-gaulishen-GB-oxendicten-x-i-defaultund-x-i-enochiansee-x-i-mingonan-x-zh-minen-US-u-va-posix";

	static function grandfathered(s:Array<Int>):go.Tuple.ValueOk<Tag> {
		final key = s.join(",");
		final m = grandfatheredMap();
		if (m.exists(key)) {
			final v = m.get(key);
			if (v < 0)
				return new go.Tuple.ValueOk(Make(altTags.substring(altTagIndex[-v - 1], altTagIndex[-v])), true);
			final t = new Tag();
			t.LangID = v;
			return new go.Tuple.ValueOk(t, true);
		}
		return new go.Tuple.ValueOk(new Tag(), false);
	}

	static var variantIndexMap_:Map<String, Int> = null;

	static function variantIndexMap():Map<String, Int> {
		if (variantIndexMap_ == null) {
			variantIndexMap_ = new Map();
			for (i in 0...variantIndex_keys.length)
				variantIndexMap_.set(variantIndex_keys[i], variantIndex_vals[i]);
		}
		return variantIndexMap_;
	}

	// sort.Search
	public static function search(n:Int, f:Int->Bool):Int {
		var i = 0;
		var j = n;
		while (i < j) {
			final h = (i + j) >>> 1;
			if (!f(h)) {
				i = h + 1;
			} else {
				j = h;
			}
		}
		return i;
	}

	// --- match.go ---

	// addLikelySubtags sets subtags to their most likely value, given the locale.
	static inline final isList = 1;
	static inline final scriptInFrom = 2;
	static inline final regionInFrom = 4;

	// specializeRegion attempts to specialize a group region.
	static function specializeRegion(t:Tag):Bool {
		final i = regionInclusion[t.RegionID];
		if (i < nRegionGroups) {
			final x = i * likelyRegionGroup_STRIDE; // {lang, region, script}
			if (likelyRegionGroup[x] == (t.LangID : Int) && likelyRegionGroup[x + 2] == (t.ScriptID : Int))
				t.RegionID = likelyRegionGroup[x + 1];
			return true;
		}
		return false;
	}

	public static final ErrMissingLikelyTagsData:Error = Errors.New("missing likely tags data");

	public static function addTags(t0:Tag):VE<Tag> {
		final t = t0.copy();
		// We leave private use identifiers alone.
		if (t.IsPrivateUse())
			return new VE(t, null);
		if (t.ScriptID != 0 && t.RegionID != 0) {
			if (t.LangID != 0) {
				// already fully specified
				specializeRegion(t);
				return new VE(t, null);
			}
			// Search matches for und-script-region. Note that for these cases
			// region will never be a group so there is no need to check for this.
			var tab = likelyRegion; // {lang, script, flags}
			var from:Int = t.RegionID;
			var to = from + 1;
			final x0 = from * 3;
			if ((likelyRegion[x0 + 2] & isList) != 0) {
				tab = likelyRegionList;
				from = likelyRegion[x0];
				to = from + likelyRegion[x0 + 1];
			}
			for (k in from...to) {
				// Deviating from the spec. See match_test.go for details.
				if (tab[k * 3 + 1] == (t.ScriptID : Int)) {
					t.setUndefinedLang(tab[k * 3]);
					return new VE(t, null);
				}
			}
		}
		if (t.LangID != 0) {
			// Search matches for lang-script and lang-region, where lang != und.
			if ((t.LangID : Int) < langNoIndexOffset) {
				final x = (t.LangID : Int) * 3; // likelyLang {region, script, flags}
				if ((likelyLang[x + 2] & isList) != 0) {
					final from = likelyLang[x];
					final to = from + likelyLang[x + 1];
					if (t.ScriptID != 0) {
						for (k in from...to) {
							if (likelyLangList[k * 3 + 1] == (t.ScriptID : Int) && (likelyLangList[k * 3 + 2] & scriptInFrom) != 0) {
								t.setUndefinedRegion(likelyLangList[k * 3]);
								return new VE(t, null);
							}
						}
					} else if (t.RegionID != 0) {
						var count = 0;
						var goodScript = true;
						final tt = t.copy();
						for (k in from...to) {
							// We visit all entries for which the script was not
							// defined, including the ones where the region was not
							// defined. This allows for proper disambiguation within
							// regions.
							if ((likelyLangList[k * 3 + 2] & scriptInFrom) == 0 && t.RegionID.Contains(likelyLangList[k * 3])) {
								tt.RegionID = likelyLangList[k * 3];
								tt.setUndefinedScript(likelyLangList[k * 3 + 1]);
								goodScript = goodScript && tt.ScriptID == likelyLangList[k * 3 + 1];
								count++;
							}
						}
						if (count == 1)
							return new VE(tt, null);
						// Even if we fail to find a unique Region, we might have
						// an unambiguous script.
						if (goodScript)
							t.ScriptID = tt.ScriptID;
					}
				}
			}
		} else {
			// Search matches for und-script.
			if (t.ScriptID != 0) {
				final x = (t.ScriptID : Int) * likelyScript_STRIDE; // {lang, region}
				if (likelyScript[x + 1] != 0) {
					t.setUndefinedRegion(likelyScript[x + 1]);
					t.setUndefinedLang(likelyScript[x]);
					return new VE(t, null);
				}
			}
			// Search matches for und-region. If und-script-region exists, it would
			// have been found earlier.
			if (t.RegionID != 0) {
				final i = regionInclusion[t.RegionID];
				if (i < nRegionGroups) {
					final x = i * likelyRegionGroup_STRIDE; // {lang, region, script}
					if (likelyRegionGroup[x + 1] != 0) {
						t.setUndefinedLang(likelyRegionGroup[x]);
						t.setUndefinedScript(likelyRegionGroup[x + 2]);
						t.RegionID = likelyRegionGroup[x + 1];
					}
				} else {
					var tab = likelyRegion; // {lang, script, flags}
					var x = (t.RegionID : Int) * 3;
					if ((tab[x + 2] & isList) != 0) {
						x = tab[x] * 3;
						tab = likelyRegionList;
					}
					if (tab[x + 1] != 0 && tab[x + 2] != scriptInFrom) {
						t.setUndefinedLang(tab[x]);
						t.setUndefinedScript(tab[x + 1]);
						return new VE(t, null);
					}
				}
			}
		}

		// Search matches for lang.
		if ((t.LangID : Int) < langNoIndexOffset) {
			var tab = likelyLang; // {region, script, flags}
			var x = (t.LangID : Int) * 3;
			if ((tab[x + 2] & isList) != 0) {
				x = tab[x] * 3;
				tab = likelyLangList;
			}
			if (tab[x] != 0) {
				t.setUndefinedScript(tab[x + 1]);
				t.setUndefinedRegion(tab[x]);
			}
			specializeRegion(t);
			if (t.LangID == 0)
				t.LangID = _en; // default language
			return new VE(t, null);
		}
		return new VE(t, ErrMissingLikelyTagsData);
	}

	// --- tags.go ---

	// MustParse is like Parse, but panics if the given BCP 47 tag cannot be parsed.
	// It simplifies safe initialization of Tag values.
	public static function MustParse(s:String):Tag {
		final r = Parse(s);
		if (r.err != null)
			throw r.err;
		return r.value;
	}

	// Und is the root language.
	// PORT: Go zero value; a new Tag per use because Tag is mutable here.
	public static inline function Und():Tag {
		return new Tag();
	}

	// --- golang.org/x/text/internal/tag (tag.go) ---
	// An Index is a string of 4-byte elements; here the byte values as Array<Int>.

	// Index reports the index of the given key or -1 if it could not be found.
	// Only the first len(key) bytes from the start of the 4-byte entries will be
	// considered for the search and the first match in Index will be returned.
	static function indexIndex(s:Array<Int>, key:ByteSlice):Int {
		final n = key.len;
		// search the index of the first entry with an equal or higher value than
		// key in s.
		final index = search(Std.int(s.length / 4), i -> cmpIndex(s, i * 4, i * 4 + n, key) != -1);
		final i = index * 4;
		if (cmpIndex(s, i, i + key.len, key) != 0)
			return -1;
		return index;
	}

	// Next finds the next occurrence of key after index x, which must have been
	// obtained from a call to Index using the same key. It returns x+1 or -1.
	static function indexNext(s:Array<Int>, key:ByteSlice, x:Int):Int {
		x++;
		if (x * 4 < s.length && cmpIndex(s, x * 4, x * 4 + key.len, key) == 0)
			return x;
		return -1;
	}

	// cmp returns an integer comparing a (= s[lo:hi]) and b lexicographically.
	static function cmpIndex(s:Array<Int>, lo:Int, hi:Int, b:ByteSlice):Int {
		if (lo < 0 || hi < lo || hi > s.length)
			throw "slice bounds out of range";
		final alen = hi - lo;
		var n = alen;
		if (b.len < n)
			n = b.len;
		for (i in 0...n) {
			final c = b.get(i);
			final a = s[lo + i];
			if (a > c)
				return 1;
			if (a < c)
				return -1;
		}
		if (alen < b.len)
			return -1;
		if (alen > b.len)
			return 1;
		return 0;
	}

	// FixCase reformats b to the same pattern of cases as form.
	// If returns false if string b is malformed.
	static function FixCase(form:String, b:ByteSlice):Bool {
		if (form.length != b.len)
			return false;
		for (i in 0...b.len) {
			var c = b.get(i);
			if (StringTools.fastCodeAt(form, i) <= 'Z'.code) {
				if (c >= 'a'.code)
					c = (c - ('z'.code - 'Z'.code)) & 0xff;
				if (c < 'A'.code || 'Z'.code < c)
					return false;
			} else {
				if (c <= 'Z'.code)
					c = (c + ('z'.code - 'Z'.code)) & 0xff;
				if (c < 'a'.code || 'z'.code < c)
					return false;
			}
			b.set(i, c);
		}
		return true;
	}

	// Index.Elem
	static function elem(s:Array<Int>, x:Int):String {
		final b = new StringBuf();
		for (i in x * 4...x * 4 + 4)
			b.addChar(s[i]);
		return b.toString();
	}

	@:allow(go.text.internal.language)
	static function langString(b:Int):String {
		if (b == 0) {
			return "und";
		} else if (b >= langNoIndexOffset) {
			return intToStr(b - langNoIndexOffset, 3);
		}
		if (lang[b * 4 + 3] == 0)
			return elem(lang, b).substr(0, 3);
		return elem(lang, b).substr(0, 2);
	}

	@:allow(go.text.internal.language)
	static function regionString(r:Int):String {
		if (r < isoRegionOffset) {
			if (r == 0)
				return "ZZ";
			return StringTools.lpad(Std.string(m49[r]), "0", 3);
		}
		r -= isoRegionOffset;
		return elem(regionISO, r).substr(0, 2);
	}

	@:allow(go.text.internal.language)
	static function scriptString(s:Int):String {
		if (s == 0)
			return "Zzzz";
		return elem(script, s);
	}

	@:allow(go.text.internal.language)
	static function regionContains(r:Int, c:Int):Bool {
		if (r == c)
			return true;
		final g = regionInclusion[r];
		if (g >= nRegionGroups)
			return false;
		final mHi = regionContainment_hi[g];
		final mLo = regionContainment_lo[g];

		final d = regionInclusion[c];
		final bHi = regionInclusionBits_hi[d];
		final bLo = regionInclusionBits_lo[d];

		// A contained country may belong to multiple disjoint groups. Matching any
		// of these indicates containment. If the contained region is a group, it
		// must strictly be a subset.
		if (d >= nRegionGroups)
			return (bHi & mHi) != 0 || (bLo & mLo) != 0;
		return (bHi & ~mHi) == 0 && (bLo & ~mLo) == 0;
	}

	@:allow(go.text.internal.language)
	static function regionIsGroup(r:Int):Bool {
		if (r == 0)
			return false;
		return regionInclusion[r] < regionContainment_hi.length;
	}

	@:allow(go.text.internal.language)
	static function regionCanonicalize(r:Int):Int {
		final cr = normRegion(r);
		if (cr != 0)
			return cr;
		return r;
	}

	@:allow(go.text.internal.language)
	static function langSuppressScript(b:Int):Int {
		if (b < langNoIndexOffset)
			return suppressScript[b];
		return 0;
	}
}

// AliasType is the type of an alias in AliasMap.
enum abstract AliasType(Int) to Int from Int {
	var Deprecated = 0;
	var Macro = 1;
	var Legacy = 2;
	var AliasTypeUnknown = -1;
}

// PORT: Go type Language (uint16); `_` because the package class is named Language.
abstract Language_(Int) from Int to Int {
	public inline function String():std.String {
		return Language.langString(this);
	}

	// Canonicalize returns the replacement of a deprecated, legacy or macro language.
	public inline function Canonicalize():Pair<Language_, AliasType> {
		return Language.normLang(this);
	}

	// SuppressScript returns the script marked as SuppressScript in the IANA
	// language tag repository, or 0 if there is no such script.
	public inline function SuppressScript():Script {
		return Language.langSuppressScript(this);
	}

	// IsPrivateUse reports whether this language code is reserved for private use.
	public inline function IsPrivateUse():Bool {
		return Tables.langPrivateStart <= this && this <= Tables.langPrivateEnd;
	}
}

// Go type Region (uint16).
abstract Region(Int) from Int to Int {
	public inline function String():std.String {
		return Language.regionString(this);
	}

	// IsGroup returns whether this region defines a collection of regions.
	public inline function IsGroup():Bool {
		return Language.regionIsGroup(this);
	}

	// Contains returns whether Region c is contained by Region r. It returns true
	// if c == r.
	public inline function Contains(c:Region):Bool {
		return Language.regionContains(this, c);
	}

	// Canonicalize returns the region or a possible replacement if the region is
	// deprecated.
	public inline function Canonicalize():Region {
		return Language.regionCanonicalize(this);
	}

	public inline function M49():Int {
		return Tables.m49[this];
	}
}

// Go type Script (uint16).
abstract Script(Int) from Int to Int {
	public inline function String():std.String {
		return Language.scriptString(this);
	}

	// IsPrivateUse reports whether this script code is reserved for private use.
	public inline function IsPrivateUse():Bool {
		return Tables._Qaaa <= this && this <= Tables._Qabx;
	}
}

// ValueError is returned by any of the parsing functions when the
// input is well-formed but the respective subtag is not recognized
// as a valid value.
class ValueError implements Error {
	public final v:Array<Int> = [for (_ in 0...8) 0];

	public function new() {}

	function tag():std.String {
		final b = new StringBuf();
		for (c in v) {
			if (c == 0)
				break;
			b.addChar(c);
		}
		return b.toString();
	}

	// Error implements the error interface.
	public function Error():std.String {
		return 'language: subtag "${tag()}" is well-formed but unknown';
	}

	// Subtag returns the subtag for which the error occurred.
	public function Subtag():std.String {
		return tag();
	}
}

// Tag represents a BCP 47 language tag. It is used to specify an instance of a
// specific language or locale. All language tag values are guaranteed to be
// well-formed. The zero value of Tag is Und.
// PORT: Go value type; copy() where Go copies a Tag that is later mutated.
class Tag {
	public var LangID:Language_ = 0;
	public var RegionID:Region = 0;
	public var ScriptID:Script = 0;
	public var pVariant:Int = 0; // offset in str, includes preceding '-'
	public var pExt:Int = 0; // offset of first extension, includes preceding '-'

	// str is the string representation of the Tag. It will only be used if the
	// tag has variants or extensions.
	public var str:std.String = "";

	public function new() {}

	public function copy():Tag {
		final t = new Tag();
		t.LangID = LangID;
		t.RegionID = RegionID;
		t.ScriptID = ScriptID;
		t.pVariant = pVariant;
		t.pExt = pExt;
		t.str = str;
		return t;
	}

	// Go struct ==
	public function equals(o:Tag):Bool {
		return LangID == o.LangID && RegionID == o.RegionID && ScriptID == o.ScriptID && pVariant == o.pVariant && pExt == o.pExt
			&& str == o.str;
	}

	// equalTags compares language, script and region subtags only.
	public function equalTags(a:Tag):Bool {
		return LangID == a.LangID && ScriptID == a.ScriptID && RegionID == a.RegionID;
	}

	// IsRoot returns true if t is equal to language "und".
	public function IsRoot():Bool {
		if (pVariant < str.length)
			return false;
		return equalTags(Language.Und());
	}

	// IsPrivateUse reports whether the Tag consists solely of an IsPrivateUse use
	// tag.
	public function IsPrivateUse():Bool {
		return str != "" && pVariant == 0;
	}

	// RemakeString is used to update t.str in case lang, script or region changed.
	// It is assumed that pExt and pVariant still point to the start of the
	// respective parts.
	public function RemakeString():Void {
		if (str == "")
			return;
		var extra = goSlice(str, pVariant, str.length);
		if (pVariant > 0)
			extra = goSlice(extra, 1, extra.length);
		if (equalTags(Language.Und()) && StringTools.startsWith(extra, "x-")) {
			str = extra;
			pVariant = 0;
			pExt = 0;
			return;
		}
		var b = genCoreBytes();
		if (extra != "") {
			final diff = b.length - pVariant;
			b = b + "-" + extra;
			pVariant = (pVariant + diff) & 0xff;
			pExt = (pExt + diff) & 0xffff;
		} else {
			pVariant = b.length & 0xff;
			pExt = b.length & 0xffff;
		}
		str = b;
	}

	// genCoreBytes writes a string for the base languages, script and region tags.
	@:allow(go.text.internal.language)
	function genCoreBytes():std.String {
		var s = LangID.String();
		if (ScriptID != 0)
			s += "-" + ScriptID.String();
		if (RegionID != 0)
			s += "-" + RegionID.String();
		return s;
	}

	// String returns the canonical string representation of the language tag.
	public function String():std.String {
		if (str != "")
			return str;
		if (ScriptID == 0 && RegionID == 0)
			return LangID.String();
		return genCoreBytes();
	}

	public function toString():std.String {
		return String();
	}

	// Maximize returns a new tag with missing tags filled in.
	public function Maximize():VE<Tag> {
		return Language.addTags(this);
	}

	// Variants returns the part of the tag holding all variants or the empty string
	// if there are no variants defined.
	public function Variants():std.String {
		if (pVariant == 0)
			return "";
		return goSlice(str, pVariant, pExt);
	}

	// VariantOrPrivateUseTags returns variants or private use tags.
	public function VariantOrPrivateUseTags():std.String {
		if (pExt > 0)
			return goSlice(str, pVariant, pExt);
		return goSlice(str, pVariant, str.length);
	}

	// HasString reports whether this tag defines more than just the raw
	// components.
	public function HasString():Bool {
		return str != "";
	}

	// HasVariants reports whether t has variants.
	public function HasVariants():Bool {
		return pVariant < pExt;
	}

	// HasExtensions reports whether t has extensions.
	public function HasExtensions():Bool {
		return pExt < str.length;
	}

	// Extension returns the extension of type x for tag t. It will return
	// false for ok if t does not have the requested extension. The returned
	// extension will be invalid in this case.
	public function Extension(x:Int):go.Tuple.ValueOk<std.String> {
		var i = pExt;
		while (i < str.length - 1) {
			final r = Language.getExtension(str, i);
			i = r.a;
			final ext = r.b;
			if (Language.byteAt(ext, 0) == x)
				return new go.Tuple.ValueOk(ext, true);
		}
		return new go.Tuple.ValueOk("", false);
	}

	// Extensions returns all extensions of t.
	public function Extensions():Array<std.String> {
		final e:Array<std.String> = [];
		var i = pExt;
		while (i < str.length - 1) {
			final r = Language.getExtension(str, i);
			i = r.a;
			e.push(r.b);
		}
		return e;
	}

	// TypeForKey returns the type associated with the given key, where key and type
	// are of the allowed values defined for the Unicode locale extension ('u') in
	// https://www.unicode.org/reports/tr35/#Unicode_Language_and_Locale_Identifiers.
	// TypeForKey will traverse the inheritance chain to get the correct value.
	//
	// If there are multiple types associated with a key, only the first will be
	// returned. If there is no type associated with a key, it returns the empty
	// string.
	public function TypeForKey(key:std.String):std.String {
		final f = findTypeForKey(key);
		final start = f.sep;
		final end = f.end;
		if (end != start) {
			var s = goSlice(str, start, end);
			final p = s.indexOf("-");
			if (p >= 0)
				s = s.substr(0, p);
			return s;
		}
		return "";
	}

	// SetTypeForKey returns a new Tag with the key set to type, where key and type
	// are of the allowed values defined for the Unicode locale extension ('u') in
	// https://www.unicode.org/reports/tr35/#Unicode_Language_and_Locale_Identifiers.
	// An empty value removes an existing pair with the same key.
	public function SetTypeForKey(key:std.String, value:std.String):VE<Tag> {
		final t = copy();
		if (t.IsPrivateUse())
			return new VE(t, Language.errPrivateUse);
		if (key.length != 2)
			return new VE(t, Language.errInvalidArguments);

		// Remove the setting if value is "".
		if (value == "") {
			final f = t.findTypeForKey(key);
			var start = f.start;
			final sep = f.sep;
			final end = f.end;
			if (start != sep) {
				// Remove a possible empty extension.
				if (Language.byteAt(t.str, start - 2) != '-'.code) {
					// has previous elements.
				} else if (end == t.str.length || end + 2 < t.str.length && Language.byteAt(t.str, end + 2) == '-'.code) {
					start -= 2;
				}
				if (start == t.pVariant && end == t.str.length) {
					t.str = "";
					t.pVariant = 0;
					t.pExt = 0;
				} else {
					t.str = goSlice(t.str, 0, start) + goSlice(t.str, end, t.str.length);
				}
			}
			return new VE(t, null);
		}

		if (value.length < 3 || value.length > 8)
			return new VE(t, Language.errInvalidArguments);

		final buf = ByteSlice.make(12 + 14); // maxCoreSize + maxSimpleUExtensionSize
		var uStart = 0; // start of the -u extension.

		// Generate the tag string if needed.
		if (t.str == "") {
			uStart = ByteSlice.copyString(buf, t.genCoreBytes());
			buf.set(uStart, '-'.code);
			uStart++;
		}

		// Create new key-type pair and parse it to verify.
		var b = buf.from(uStart);
		ByteSlice.copyString(b, "u-");
		ByteSlice.copyString(b.from(2), key);
		b.set(4, '-'.code);
		b = b.to(5 + ByteSlice.copy(b.from(5), ByteSlice.ofString(value)));
		final err = Language.scanForSetTypeForKey(b);
		if (err != null)
			return new VE(t, err);

		// Assemble the replacement string.
		if (t.str == "") {
			t.pVariant = (uStart - 1) & 0xff;
			t.pExt = (uStart - 1) & 0xffff;
			t.str = buf.to(uStart + b.len).toString();
		} else {
			final s = t.str;
			final f = t.findTypeForKey(key);
			if (f.start == f.sep) {
				if (f.hasExt)
					b = b.from(2);
				t.str = goSlice(s, 0, f.sep) + "-" + b.toString() + goSlice(s, f.end, s.length);
			} else {
				t.str = goSlice(s, 0, f.start + 3) + "-" + value + goSlice(s, f.end, s.length);
			}
		}
		return new VE(t, null);
	}

	// findTypeForKey returns the start and end position for the type corresponding
	// to key or the point at which to insert the key-value pair if the type
	// wasn't found. The hasExt return value reports whether an -u extension was present.
	// Note: the extensions are typically very small and are likely to contain
	// only one key-type pair.
	function findTypeForKey(key:std.String):FindTypeResult {
		var p = pExt;
		if (key.length != 2 || p == str.length || p == 0)
			return new FindTypeResult(p, p, p, false);
		final s = str;

		// Find the correct extension.
		p++;
		while (Language.byteAt(s, p) != 'u'.code) {
			if (Language.byteAt(s, p) > 'u'.code) {
				p--;
				return new FindTypeResult(p, p, p, false);
			}
			p = Language.nextExtension(s, p);
			if (p == s.length)
				return new FindTypeResult(s.length, s.length, s.length, false);
			p++;
		}
		// Proceed to the hyphen following the extension name.
		p++;

		// curKey is the key currently being processed.
		var curKey = "";
		var start = 0;
		var sep = 0;
		var end = 0;

		// Iterate over keys until we get the end of a section.
		while (true) {
			end = p;
			p++;
			while (p < s.length && Language.byteAt(s, p) != '-'.code)
				p++;
			final n = p - end - 1;
			if (n <= 2 && curKey == key) {
				if (sep < end)
					sep++;
				return new FindTypeResult(start, sep, end, true);
			}
			switch (n) {
				case 0, // invalid string
					1: // next extension
					return new FindTypeResult(end, end, end, true);
				case 2:
					// next key
					curKey = goSlice(s, end + 1, p);
					if (curKey > key)
						return new FindTypeResult(end, end, end, true);
					start = end;
					sep = p;
				default:
			}
		}
	}

	@:allow(go.text.internal.language)
	function setUndefinedLang(id:Language_):Void {
		if (LangID == 0)
			LangID = id;
	}

	@:allow(go.text.internal.language)
	function setUndefinedScript(id:Script):Void {
		if (ScriptID == 0)
			ScriptID = id;
	}

	@:allow(go.text.internal.language)
	function setUndefinedRegion(id:Region):Void {
		if (RegionID == 0 || RegionID.Contains(id))
			RegionID = id;
	}

	// Go string slicing s[lo:hi] (panics out of range).
	static function goSlice(s:std.String, lo:Int, hi:Int):std.String {
		if (lo < 0 || hi < lo || hi > s.length)
			throw "slice bounds out of range";
		return s.substring(lo, hi);
	}
}

// scanner is used to scan BCP 47 tokens, which are separated by _ or -.
// PORT: Go type scanner.
class Scanner {
	public var b:ByteSlice = null;
	public var token:Null<ByteSlice> = null;
	public var start:Int = 0; // start position of the current token
	public var end:Int = 0; // end position of the current token
	public var next:Int = 0; // next point for scan
	public var err:Null<Error> = null;
	public var done:Bool = false;

	public function new() {}

	public inline function tokenLen():Int {
		return token == null ? 0 : token.len;
	}

	public function init():Void {
		for (i in 0...b.len) {
			if (b.get(i) == '_'.code)
				b.set(i, '-'.code);
		}
		scan();
	}

	// restToLower converts the string between start and end to lower case.
	public function toLower(start:Int, end:Int):Void {
		for (i in start...end) {
			final c = b.get(i);
			if ('A'.code <= c && c <= 'Z'.code)
				b.set(i, c + ('a'.code - 'A'.code));
		}
	}

	public function setError(e:Null<Error>):Void {
		if (err == null || (e == Language.ErrSyntax && err != Language.ErrSyntax))
			err = e;
	}

	// resizeRange shrinks or grows the array at position oldStart such that
	// a new string of size newSize can fit between oldStart and oldEnd.
	// Sets the scan point to after the resized range.
	public function resizeRange(oldStart:Int, oldEnd:Int, newSize:Int):Void {
		start = oldStart;
		final end = oldStart + newSize;
		if (end != oldEnd) {
			final diff = end - oldEnd;
			var nb:ByteSlice;
			final n = b.len + diff;
			if (n > b.cap) {
				nb = ByteSlice.make(n);
				ByteSlice.copy(nb, b.to(oldStart));
			} else {
				nb = b.to(n);
			}
			ByteSlice.copy(nb.from(end), b.from(oldEnd));
			b = nb;
			next = end + (next - this.end);
			this.end = end;
		}
	}

	// replace replaces the current token with repl.
	public function replace(repl:std.String):Void {
		resizeRange(start, end, repl.length);
		ByteSlice.copyString(b.from(start), repl);
	}

	// gobble removes the current token from the input.
	// Caller must call scan after calling gobble.
	public function gobble(e:Null<Error>):Void {
		setError(e);
		if (start == 0) {
			b = b.to(ByteSlice.copy(b, b.from(next)));
			end = 0;
		} else {
			b = b.to(start - 1 + ByteSlice.copy(b.from(start - 1), b.from(end)));
			end = start - 1;
		}
		next = start;
	}

	// deleteRange removes the given range from s.b before the current token.
	public function deleteRange(start:Int, end:Int):Void {
		b = b.to(start + ByteSlice.copy(b.from(start), b.from(end)));
		final diff = end - start;
		next -= diff;
		this.start -= diff;
		this.end -= diff;
	}

	// scan parses the next token of a BCP 47 string.  Tokens that are larger
	// than 8 characters or include non-alphanumeric characters result in an error
	// and are gobbled and removed from the output.
	// It returns the end position of the last token consumed.
	public function scan():Int {
		final end = this.end;
		token = null;
		start = next;
		while (next < b.len) {
			var i = b.from(next).indexByte('-'.code);
			if (i == -1) {
				this.end = b.len;
				next = b.len;
				i = this.end - start;
			} else {
				this.end = next + i;
				next = this.end + 1;
			}
			final token = b.slice(start, this.end);
			if (i < 1 || i > 8 || !isAlphaNum(token)) {
				gobble(Language.ErrSyntax);
				continue;
			}
			this.token = token;
			return end;
		}
		final n = b.len;
		if (n > 0 && b.get(n - 1) == '-'.code) {
			setError(Language.ErrSyntax);
			b = b.to(b.len - 1);
		}
		done = true;
		return end;
	}

	static function isAlphaNum(s:ByteSlice):Bool {
		for (i in 0...s.len) {
			final c = s.get(i);
			if (!('a'.code <= c && c <= 'z'.code || 'A'.code <= c && c <= 'Z'.code || '0'.code <= c && c <= '9'.code))
				return false;
		}
		return true;
	}

	// acceptMinSize parses multiple tokens of the given size or greater.
	// It returns the end position of the last token consumed.
	public function acceptMinSize(min:Int):Int {
		var end = this.end;
		scan();
		while (tokenLen() >= min) {
			end = this.end;
			scan();
		}
		return end;
	}
}

// Results of Tag.findTypeForKey: (start, sep, end int, hasExt bool).
class FindTypeResult {
	public final start:Int;
	public final sep:Int;
	public final end:Int;
	public final hasExt:Bool;

	public function new(start:Int, sep:Int, end:Int, hasExt:Bool) {
		this.start = start;
		this.sep = sep;
		this.end = end;
		this.hasExt = hasExt;
	}
}
