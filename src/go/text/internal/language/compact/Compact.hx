package go.text.internal.language.compact;

import go.text.internal.language.Language as L;
import go.text.internal.language.Language.Tag as LTag;
import go.text.internal.language.compact.Tables.*;

// Port of golang.org/x/text/internal/language/compact (v0.38.0): Make, Tag.Tag, FromTag and
// the ID lookup. Tables (tables.go) are generated by tools/gen/diagnostics/GenLanguageTables.hx.
// PORT: not ported (unused by tsc): Parent, LanguageTag, RegionalTag, LanguageID, RegionalID,
// parents table.
class Compact {
	// --- compact.go ---

	static function getCoreIndex(t:LTag):go.Tuple.ValueOk<Int> {
		final r = L.GetCompactCore(t);
		if (!r.ok)
			return new go.Tuple.ValueOk(0, false);
		final cci = r.value;
		final i = L.search(coreTags.length, i -> cci <= coreTags[i]);
		if (i == coreTags.length || coreTags[i] != cci)
			return new go.Tuple.ValueOk(0, false);
		return new go.Tuple.ValueOk(i, true);
	}

	// ID.Tag
	public static function IDTag(id:Int):LTag {
		if (id >= coreTags.length)
			return specialTags()[id - coreTags.length].copy();
		return L.CompactCoreInfoTag(coreTags[id]);
	}

	static var specialTags_:Array<LTag> = null;

	// PORT: Go package init(); built on first use.
	static function specialTags():Array<LTag> {
		if (specialTags_ == null) {
			final str = [for (c in specialTagsStr) String.fromCharCode(c)].join("");
			specialTags_ = [for (t in str.split(" ")) L.MustParse(t)];
		}
		return specialTags_;
	}

	// --- language.go ---

	// Make a compact Tag from a fully specified internal language Tag.
	public static function Make(t:LTag):Tag {
		final tag = new Tag();
		final region = t.TypeForKey("rg");
		if (region.length == 6 && region.substr(2) == "zzzz") {
			final r = L.ParseRegion(region.substr(0, 2));
			if (r.err == null) {
				final tFull = t;
				var t2 = t.SetTypeForKey("rg", "").value;
				// TODO: should we not consider "va" for the language tag?
				final f1 = FromTag(t2);
				tag.language = f1.value;
				t2 = t2.copy();
				t2.RegionID = r.value;
				final f2 = FromTag(t2);
				tag.locale = f2.value;
				if (!f1.ok || !f2.ok)
					tag.full = tFull;
				return tag;
			}
		}
		final f = FromTag(t);
		tag.language = f.value;
		tag.locale = f.value;
		if (!f.ok)
			tag.full = t;
		return tag;
	}

	// FromTag reports closest matching ID for an internal language Tag.
	// PORT: when the tag is not exact, Go keeps searching for the closest ID (Builder for
	// variants with extensions, Maximize, Parent). Make stores the full tag in that case and never
	// reads the ID, so the search is not ported; the ID is 0 then.
	public static function FromTag(t:LTag):go.Tuple.ValueOk<Int> {
		var exact = true;

		final b = t.LangID;
		final s = t.ScriptID;
		final r = t.RegionID;
		if (t.HasString()) {
			if (t.IsPrivateUse()) {
				// We have no entries for user-defined tags.
				return new go.Tuple.ValueOk(0, false);
			}
			var hasExtra = false;
			if (t.HasVariants()) {
				if (t.HasExtensions()) {
					// PORT: Builder (core + variants) not ported; the result is not exact.
					return new go.Tuple.ValueOk(0, false);
				}
				hasExtra = true;
			} else if (t.Extension('u'.code).ok) {
				// TODO: va may mean something else. Consider not considering it.
				// Strip all but the 'va' entry.
				final old = t;
				final variant = t.TypeForKey("va");
				t = L.Und();
				t.LangID = b;
				t.ScriptID = s;
				t.RegionID = r;
				if (variant != "") {
					t = t.SetTypeForKey("va", variant).value;
					hasExtra = true;
				}
				exact = old.equals(t);
			} else {
				exact = false;
			}
			if (hasExtra) {
				// We have some variants.
				final special = specialTags();
				for (i in 0...special.length) {
					if (special[i].equals(t))
						return new go.Tuple.ValueOk(i + coreTags.length, exact);
				}
				exact = false;
			}
		}
		final x = getCoreIndex(t);
		if (x.ok)
			return new go.Tuple.ValueOk(x.value, exact);
		exact = false;
		// PORT: closest-ID search (Maximize, Parent) not ported, see above.
		return new go.Tuple.ValueOk(0, exact);
	}
}

// Tag represents a BCP 47 language tag. It is used to specify an instance of a
// specific language or locale. All language tag values are guaranteed to be
// well-formed.
class Tag {
	// NOTE: exported tags will become part of the public API.
	public var language:Int = 0; // ID
	public var locale:Int = 0; // ID
	public var full:Null<LTag> = null; // always a language.Tag for now.

	public function new() {}

	// Go struct == (full compares the language.Tag values).
	public function equals(o:Tag):Bool {
		if (language != o.language || locale != o.locale)
			return false;
		if (full == null || o.full == null)
			return full == null && o.full == null;
		return full.equals(o.full);
	}

	// Tag returns an internal language Tag version of this tag.
	public function Tag():LTag {
		if (full != null)
			return full.copy();
		var tag = Compact.IDTag(language);
		if (language != locale) {
			final loc = Compact.IDTag(locale);
			tag = tag.SetTypeForKey("rg", loc.RegionID.String().toLowerCase() + "zzzz").value;
		}
		return tag;
	}

	// IsCompact reports whether this tag is fully defined in terms of ID.
	public function IsCompact():Bool {
		return full == null;
	}

	// IsRoot returns true if t is equal to language "und".
	public function IsRoot():Bool {
		if (full != null)
			return full.IsRoot();
		return language == 0; // _und
	}
}
