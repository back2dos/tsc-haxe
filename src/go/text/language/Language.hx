package go.text.language;

import go.Errors.Error;
import go.Tuple.Pair;
import go.Tuple.Triple;
import go.Tuple.ValueError as VE;
import go.text.internal.language.Language as L;
import go.text.internal.language.Language.Tag as ITag;
import go.text.internal.language.compact.Compact;
import go.text.internal.language.compact.Compact.Tag as CTag;
import go.text.internal.language.Language.AliasType;
import go.text.internal.language.Language.Language_;
import go.text.internal.language.Language.Region;
import go.text.internal.language.Language.Script;
import go.text.language.Tables.*;

// Port of golang.org/x/text/language (v0.38.0, the version pinned by upstream go.mod): the parts
// that tsc uses (Parse, MustParse, English, Und, NewMatcher, Matcher.Match, Tag.Script/String).
// Tables (tables.go) are generated by tools/gen/diagnostics/GenLanguageTables.hx.
// PORT: not ported (unused by tsc): Compose, ParseAcceptLanguage, MatchStrings, Comprehends,
// Base/Region/Variant types, Extensions, Parent, coverage, CompactIndex.
class Language {
	// --- language.go ---

	@:allow(go.text.language)
	static function makeTag(t:ITag):Tag {
		return new Tag(Compact.Make(t));
	}

	// Make is a convenience wrapper for Parse that omits the error.
	// In case of an error, a sensible default is returned.
	public static function Make(s:String):Tag {
		return Parse(s).value;
	}

	// CanonType can be used to enable or disable various types of canonicalization.
	public static inline final DeprecatedBase = 1;
	public static inline final DeprecatedScript = 2;
	public static inline final DeprecatedRegion = 4;
	public static inline final SuppressScript = 8;
	public static inline final Legacy = 16;
	public static inline final Macro = 32;
	public static inline final CLDR = 64;
	public static inline final Raw = 0;
	public static inline final Deprecated = DeprecatedBase | DeprecatedScript | DeprecatedRegion;
	public static inline final BCP47 = Deprecated | SuppressScript;
	public static inline final All = BCP47 | Legacy | Macro;
	public static inline final Default = Deprecated | Legacy;
	static inline final canonLang = DeprecatedBase | Legacy | Macro;

	// canonicalize returns the canonicalized equivalent of the tag and
	// whether there was any change.
	static function canonicalize(c:Int, t0:ITag):Pair<ITag, Bool> {
		if (c == Raw)
			return new Pair(t0, false);
		final t = t0.copy();
		var changed = false;
		if ((c & SuppressScript) != 0) {
			if (t.LangID.SuppressScript() == t.ScriptID) {
				t.ScriptID = 0;
				changed = true;
			}
		}
		if ((c & canonLang) != 0) {
			while (true) {
				final r = t.LangID.Canonicalize();
				final l = r.a;
				final aliasType = r.b;
				if (l != t.LangID) {
					if (aliasType == AliasType.Legacy) {
						if ((c & Legacy) != 0) {
							if (t.LangID == _sh && t.ScriptID == 0)
								t.ScriptID = _Latn;
							t.LangID = l;
							changed = true;
						}
					} else if (aliasType == AliasType.Macro) {
						if ((c & Macro) != 0) {
							// We deviate here from CLDR. The mapping "nb" -> "no"
							// qualifies as a typical Macro language mapping.  However,
							// for legacy reasons, CLDR maps "no", the macro language
							// code for Norwegian, to the dominant variant "nb".
							if ((c & CLDR) == 0 || t.LangID != _nb) {
								changed = true;
								t.LangID = l;
							}
						}
					} else if (aliasType == AliasType.Deprecated) {
						if ((c & DeprecatedBase) != 0) {
							if (t.LangID == _mo && t.RegionID == 0)
								t.RegionID = _MD;
							t.LangID = l;
							changed = true;
							// Other canonicalization types may still apply.
							continue;
						}
					}
				} else if ((c & Legacy) != 0 && t.LangID == _no && (c & CLDR) != 0) {
					t.LangID = _nb;
					changed = true;
				}
				break;
			}
		}
		if ((c & DeprecatedScript) != 0) {
			if (t.ScriptID == _Qaai) {
				changed = true;
				t.ScriptID = _Zinh;
			}
		}
		if ((c & DeprecatedRegion) != 0) {
			final r = t.RegionID.Canonicalize();
			if (r != t.RegionID) {
				changed = true;
				t.RegionID = r;
			}
		}
		return new Pair(t, changed);
	}

	// --- parse.go ---

	// Parse parses the given BCP 47 string and returns a valid Tag. If parsing
	// failed it returns an error and any part of the tag that could be parsed.
	// If parsing succeeded but an unknown value was found, it returns
	// ValueError. The Tag returned in this case is just stripped of the unknown
	// value. All other values are preserved.
	// The resulting tag is canonicalized using the default canonicalization type.
	public static function Parse(s:String):VE<Tag> {
		return CanonParse(Default, s);
	}

	// (c CanonType) Parse
	public static function CanonParse(c:Int, s:String):VE<Tag> {
		try {
			final r = L.Parse(s);
			var tt = r.value;
			if (r.err != null)
				return new VE(makeTag(tt), r.err);
			final cr = canonicalize(c, tt);
			tt = cr.a;
			if (cr.b)
				tt.RemakeString();
			return new VE(makeTag(tt), null);
		} catch (e:Dynamic) {
			// defer recover(): t = Tag{}, err = language.ErrSyntax
			return new VE(makeTag(L.Und()), L.ErrSyntax);
		}
	}

	// --- tags.go ---

	// MustParse is like Parse, but panics if the given BCP 47 tag cannot be parsed.
	// It simplifies safe initialization of Tag values.
	public static function MustParse(s:String):Tag {
		final r = Parse(s);
		if (r.err != null)
			throw r.err;
		return r.value;
	}

	// PORT: Go package vars; Tag values are immutable here, so one instance each.
	public static var Und(get, never):Tag;
	public static var English(get, never):Tag;

	static var und_:Tag = null;
	static var english_:Tag = null;

	static function get_Und():Tag {
		if (und_ == null)
			und_ = new Tag(new CTag());
		return und_;
	}

	static function get_English():Tag {
		if (english_ == null) {
			// Go: Tag(compact.English), the compact tag "en".
			final t = L.Und();
			t.LangID = _en;
			english_ = makeTag(t);
			if (english_.t.full != null)
				throw "compact.English is not compact";
		}
		return english_;
	}

	// --- match.go ---

	// NewMatcher returns a Matcher that matches an ordered list of preferred tags
	// against a list of supported tags based on written intelligibility, closeness
	// of dialect, equivalence of subtags and various other rules. It is initialized
	// with the list of supported tags. The first element is used as the default
	// value in case no match is found.
	// PORT: MatchOption (PreferSameScript) is not ported; Go's default (true) applies.
	public static function NewMatcher(t:Array<Tag>):Matcher {
		return newMatcher(t);
	}

	static function makeHaveTag(tag:ITag, index:Int):Pair<HaveTag, Language_> {
		var max = tag;
		if (tag.LangID != 0 || tag.RegionID != 0 || tag.ScriptID != 0) {
			max = canonicalize(All, max).a;
			max = max.Maximize().value.copy();
			max.RemakeString();
		}
		final h = new HaveTag();
		h.tag = tag;
		h.index = index;
		h.conf = Confidence.Exact;
		h.maxRegion = max.RegionID;
		h.maxScript = max.ScriptID;
		h.altScript = altScript(max.LangID, max.ScriptID);
		h.nextMax = 0;
		return new Pair(h, max.LangID);
	}

	// altScript returns an alternative script that may match the given script with
	// a low confidence.  At the moment, the langMatch data allows for at most one
	// script to map to another and we rely on this to keep the code simple.
	static function altScript(l:Language_, s:Script):Script {
		var i = 0;
		while (i < matchScript.length) {
			// {wantLang, haveLang, wantScript, haveScript, distance}
			// TODO: also match cases where language is not the same.
			if ((matchScript[i] == (l : Int) || matchScript[i + 1] == (l : Int)) && matchScript[i + 3] == (s : Int))
				return matchScript[i + 2];
			i += matchScript_STRIDE;
		}
		return 0;
	}

	@:allow(go.text.language)
	static function toConf(d:Int):Confidence {
		if (d <= 10)
			return Confidence.High;
		if (d < 30)
			return Confidence.Low;
		return Confidence.No;
	}

	// newMatcher builds an index for the given supported tags and returns it as
	// a matcher. It also expands the index by considering various equivalence classes
	// for a given tag.
	static function newMatcher(supported:Array<Tag>):Matcher_ {
		init();
		final m = new Matcher_();
		m.preferSameScript = true;
		if (supported == null || supported.length == 0) {
			m.default_ = new HaveTag();
			return m;
		}
		// Add supported languages to the index. Add exact matches first to give
		// them precedence.
		for (i in 0...supported.length) {
			final tt = supported[i].tag();
			final pair = makeHaveTag(tt, i).a;
			m.header(tt.LangID).addIfNew(pair, true);
			m.supported.push(pair);
		}
		m.default_ = m.header(supported[0].lang()).haveTags[0];
		// Keep these in two different loops to support the case that two equivalent
		// languages are distinguished, such as iw and he.
		for (i in 0...supported.length) {
			final tt = supported[i].tag();
			final r = makeHaveTag(tt, i);
			if (r.b != tt.LangID)
				m.header(r.b).addIfNew(r.a, true);
		}

		// update is used to add indexes in the map for equivalent languages.
		// update will only add entries to original indexes, thus not computing any
		// transitive relations.
		final update = (want:Int, have:Int, conf:Confidence) -> {
			final hh = m.index.get(have);
			if (hh != null) {
				if (!hh.original)
					return;
				final hw = m.header(want);
				for (ht in hh.haveTags) {
					final v = ht.copy();
					if (conf < v.conf)
						v.conf = conf;
					v.nextMax = 0; // this value needs to be recomputed
					if (v.altScript != 0)
						v.altScript = altScript(want, v.maxScript);
					hw.addIfNew(v, conf == Confidence.Exact && hh.original);
				}
			}
		};

		// Add entries for languages with mutual intelligibility as defined by CLDR's
		// languageMatch data.
		var i = 0;
		while (i < matchLang.length) {
			// {want, have, distance, oneway}
			final want = matchLang[i];
			final have = matchLang[i + 1];
			final distance = matchLang[i + 2];
			final oneway = matchLang[i + 3] != 0;
			update(want, have, toConf(distance));
			if (!oneway)
				update(have, want, toConf(distance));
			i += matchLang_STRIDE;
		}

		// Add entries for possible canonicalizations. This is an optimization to
		// ensure that only one map lookup needs to be done at runtime per desired tag.
		// First we match deprecated equivalents. If they are perfect equivalents
		// (their canonicalization simply substitutes a different language code, but
		// nothing else), the match confidence is Exact, otherwise it is High.
		final aliasMap = go.text.internal.language.Tables.AliasMap;
		final stride = go.text.internal.language.Tables.AliasMap_STRIDE;
		for (k in 0...Std.int(aliasMap.length / stride)) {
			final from = aliasMap[k * stride];
			final to = aliasMap[k * stride + 1];
			// If deprecated codes match and there is no fiddling with the script
			// or region, we consider it an exact match.
			var conf = Confidence.Exact;
			if ((go.text.internal.language.Tables.AliasTypes[k] : AliasType) != AliasType.Macro) {
				if (!isExactEquivalent(from))
					conf = Confidence.High;
				update(to, from, conf);
			}
			update(from, to, conf);
		}
		return m;
	}

	@:allow(go.text.language)
	static function isParadigmLocale(lang:Language_, r:Region):Bool {
		var i = 0;
		while (i < paradigmLocales.length) {
			if (paradigmLocales[i] == (lang : Int) && ((r : Int) == paradigmLocales[i + 1] || (r : Int) == paradigmLocales[i + 2]))
				return true;
			i += paradigmLocales_STRIDE;
		}
		return false;
	}

	// regionGroupDist computes the distance between two regions based on their
	// CLDR grouping.
	@:allow(go.text.language)
	static function regionGroupDist(a:Region, b:Region, script:Script, lang:Language_):Pair<Int, Bool> {
		final defaultDistance = 4;

		final aGroup = regionToGroups[a] << 1;
		final bGroup = regionToGroups[b] << 1;
		var i = 0;
		while (i < matchRegion.length) {
			// {lang, script, group, distance}
			final riLang = matchRegion[i];
			final riScript = matchRegion[i + 1];
			final riGroup = matchRegion[i + 2];
			final riDistance = matchRegion[i + 3];
			if (riLang == (lang : Int) && (riScript == 0 || riScript == (script : Int))) {
				final group = 1 << (riGroup & ~0x80);
				if ((0x80 & riGroup) == 0) {
					if ((aGroup & bGroup & group) != 0) // Both regions are in the group.
						return new Pair(riDistance, riDistance == defaultDistance);
				} else {
					if (((aGroup | bGroup) & group) == 0) // Both regions are not in the group.
						return new Pair(riDistance, riDistance == defaultDistance);
				}
			}
			i += matchRegion_STRIDE;
		}
		return new Pair(defaultDistance, true);
	}

	// equalsRest compares everything except the language.
	@:allow(go.text.language)
	static function equalsRest(a:ITag, b:ITag):Bool {
		// TODO: don't include extensions in this comparison. To do this efficiently,
		// though, we should handle private tags separately.
		return a.ScriptID == b.ScriptID && a.RegionID == b.RegionID && a.VariantOrPrivateUseTags() == b.VariantOrPrivateUseTags();
	}

	// isExactEquivalent returns true if canonicalizing the language will not alter
	// the script or region of a tag.
	static function isExactEquivalent(l:Language_):Bool {
		for (o in notEquivalent)
			if (o == l)
				return false;
		return true;
	}

	static var notEquivalent:Array<Language_> = [];

	static var initDone = false;

	// PORT: Go package init(), run on first use (NewMatcher).
	static function init():Void {
		if (initDone)
			return;
		initDone = true;
		// Create a list of all languages for which canonicalization may alter the
		// script or region.
		final aliasMap = go.text.internal.language.Tables.AliasMap;
		final stride = go.text.internal.language.Tables.AliasMap_STRIDE;
		for (k in 0...Std.int(aliasMap.length / stride)) {
			final tag = L.Und();
			tag.LangID = aliasMap[k * stride];
			final c = canonicalize(All, tag).a;
			if (c.ScriptID != 0 || c.RegionID != 0)
				notEquivalent.push(aliasMap[k * stride]);
		}
		// Maximize undefined regions of paradigm locales.
		var i = 0;
		while (i < paradigmLocales.length) {
			final t = L.Und();
			t.LangID = paradigmLocales[i];
			final max = t.Maximize().value;
			if (paradigmLocales[i + 1] == 0)
				paradigmLocales[i + 1] = max.RegionID;
			if (paradigmLocales[i + 2] == 0)
				paradigmLocales[i + 2] = max.RegionID;
			i += paradigmLocales_STRIDE;
		}
	}

	@:allow(go.text.language)
	static function canonicalizeForMatch(c:Int, t:ITag):ITag {
		return canonicalize(c, t).a;
	}
}

// Tag represents a BCP 47 language tag. It is used to specify an instance of a
// specific language or locale. All language tag values are guaranteed to be
// well-formed.
// Go: type Tag compact.Tag. Immutable.
class Tag {
	@:allow(go.text.language)
	final t:CTag;

	public function new(t:CTag) {
		this.t = t;
	}

	public function tag():ITag {
		return t.Tag();
	}

	public function isCompact():Bool {
		return t.IsCompact();
	}

	// TODO: improve performance.
	public function lang():Language_ {
		return tag().LangID;
	}

	public function region():Region {
		return tag().RegionID;
	}

	public function script():Script {
		return tag().ScriptID;
	}

	// IsRoot returns true if t is equal to language "und".
	public function IsRoot():Bool {
		return t.IsRoot();
	}

	// Go Tag == (compact.Tag struct equality).
	public function equals(o:Tag):Bool {
		return t.equals(o.t);
	}

	// String returns the canonical string representation of the language tag.
	public function String():std.String {
		return tag().String();
	}

	public function toString():std.String {
		return String();
	}

	// Script infers the script for the language tag. If it was not explicitly given, it will infer
	// a most likely candidate.
	// PORT: returns the internal Script id (Go: Script{scriptID}).
	public function Script():Pair<Script, Confidence> {
		final scr = script();
		if (scr != 0)
			return new Pair(scr, Confidence.Exact);
		var tt = tag();
		var sc:Script = Tables._Zzzz;
		var c = Confidence.No;
		final scr2 = tt.LangID.SuppressScript();
		if (scr2 != 0) {
			// Note: it is not always the case that a language with a suppress
			// script value is only written in one script (e.g. kk, ms, pa).
			if (tt.RegionID == 0)
				return new Pair(scr2, Confidence.High);
			sc = scr2;
			c = Confidence.High;
		}
		final r = tt.Maximize();
		if (r.err == null) {
			if (r.value.ScriptID != sc) {
				sc = r.value.ScriptID;
				c = Confidence.Low;
			}
		} else {
			tt = Language.canonicalizeForMatch(Language.Deprecated | Language.Macro, tt);
			final r2 = tt.Maximize();
			if (r2.err == null && r2.value.ScriptID != sc) {
				sc = r2.value.ScriptID;
				c = Confidence.Low;
			}
		}
		return new Pair(sc, c);
	}
}

// Confidence indicates the level of certainty for a given return value.
enum abstract Confidence(Int) {
	var No = 0; // full confidence that there was no match
	var Low = 1; // most likely value picked out of a set of alternatives
	var High = 2; // value is generally assumed to be the correct match
	var Exact = 3; // exact match or explicitly specified value

	@:op(A < B) static function lt(a:Confidence, b:Confidence):Bool;

	@:op(A > B) static function gt(a:Confidence, b:Confidence):Bool;

	@:op(A <= B) static function le(a:Confidence, b:Confidence):Bool;

	@:op(A >= B) static function ge(a:Confidence, b:Confidence):Bool;

	public function String():std.String {
		return ["No", "Low", "High", "Exact"][this];
	}
}

// Matcher is the interface that wraps the Match method.
//
// Match returns the best match for any of the given tags, along with
// a unique index associated with the returned tag and a confidence
// score.
interface Matcher {
	function Match(want:Array<Tag>):Triple<Tag, Int, Confidence>;
}

// matcher keeps a set of supported language tags, indexed by language.
// PORT: Go type matcher.
class Matcher_ implements Matcher {
	public var default_:HaveTag = null;
	public var supported:Array<HaveTag> = [];
	public var index:haxe.ds.IntMap<MatchHeader> = new haxe.ds.IntMap();
	public var passSettings:Bool = false;
	public var preferSameScript:Bool = false;

	public function new() {}

	// header returns the matchHeader for the given language. It creates one if
	// it doesn't already exist.
	public function header(l:Language_):MatchHeader {
		final h = index.get(l);
		if (h != null)
			return h;
		final h = new MatchHeader();
		index.set(l, h);
		return h;
	}

	// PORT: Go's Match(want ...Tag) also adjusts the returned tag (region from the desired tag,
	// -u-rg- and the desired tag's extensions). tsc only uses the index and the confidence, so
	// the returned tag is the matched supported tag without these adjustments.
	public function Match(want:Array<Tag>):Triple<Tag, Int, Confidence> {
		var tt:ITag;
		var index = 0;
		final best = getBest(want);
		final match = best.a;
		final c = best.c;
		if (match != null) {
			tt = match.tag;
			index = match.index;
		} else {
			// TODO: this should be an option
			tt = default_.tag;
			if (preferSameScript) {
				var found = false; // PORT: label (break outer)
				for (w in want) {
					final script = w.Script().a;
					if (script == 0) {
						// Don't do anything if there is no script, such as with
						// private subtags.
						continue;
					}
					for (i in 0...supported.length) {
						final h = supported[i];
						if (script == h.maxScript) {
							tt = h.tag;
							index = i;
							found = true;
							break;
						}
					}
					if (found)
						break;
				}
			}
			// TODO: select first language tag based on script.
		}
		return new Triple(Language.makeTag(tt), index, c);
	}

	// getBest gets the best matching tag in m for any of the given tags, taking into
	// account the order of preference of the given tags.
	function getBest(want:Array<Tag>):Triple<Null<HaveTag>, ITag, Confidence> {
		final best = new BestMatch();
		for (i in 0...want.length) {
			final w = want[i].tag();
			var max:ITag;
			// Check for exact match first.
			var h = index.get(w.LangID);
			if (w.LangID != 0) {
				if (h == null)
					continue;
				// Base language is defined.
				max = Language.canonicalizeForMatch(Language.Legacy | Language.Deprecated | Language.Macro, w);
				// A region that is added through canonicalization is stronger than
				// a maximized region: set it in the original (e.g. mo -> ro-MD).
				if (w.RegionID != max.RegionID)
					w.RegionID = max.RegionID;
				// TODO: should we do the same for scripts?
				// See test case: en, sr, nl ; sh ; sr
				max = max.Maximize().value;
			} else {
				// Base language is not defined.
				if (h != null) {
					for (have in h.haveTags) {
						if (Language.equalsRest(have.tag, w))
							return new Triple(have, w, Confidence.Exact);
					}
				}
				if (w.ScriptID == 0 && w.RegionID == 0) {
					// We skip all tags matching und for approximate matching, including
					// private tags.
					continue;
				}
				max = w.Maximize().value;
				h = index.get(max.LangID);
				if (h == null)
					continue;
			}
			var pin = true;
			for (t in want.slice(i + 1)) {
				if (w.LangID == t.lang()) {
					pin = false;
					break;
				}
			}
			// Check for match based on maximized tag.
			for (k in 0...h.haveTags.length) {
				var have = h.haveTags[k];
				best.update(have, w, max.ScriptID, max.RegionID, pin);
				if (best.conf == Confidence.Exact) {
					while (have.nextMax != 0) {
						have = h.haveTags[have.nextMax];
						best.update(have, w, max.ScriptID, max.RegionID, pin);
					}
					return new Triple(best.have, best.want, best.conf);
				}
			}
		}
		if (best.conf <= Confidence.No) {
			if (want.length != 0)
				return new Triple(null, want[0].tag(), Confidence.No);
			return new Triple(null, L.Und(), Confidence.No);
		}
		return new Triple(best.have, best.want, best.conf);
	}
}

// matchHeader has the lists of tags for exact matches and matches based on
// maximized and canonicalized tags for a given language.
class MatchHeader {
	public var haveTags:Array<HaveTag> = [];
	public var original:Bool = false;

	public function new() {}

	// addIfNew adds a haveTag to the list of tags only if it is a unique tag.
	// Tags that have the same maximized values are linked by index.
	public function addIfNew(n:HaveTag, exact:Bool):Void {
		original = original || exact;
		// Don't add new exact matches.
		for (v in haveTags) {
			if (Language.equalsRest(v.tag, n.tag))
				return;
		}
		// Allow duplicate maximized tags, but create a linked list to allow quickly
		// comparing the equivalents and bail out.
		for (i0 in 0...haveTags.length) {
			final v = haveTags[i0];
			if (v.maxScript == n.maxScript && v.maxRegion == n.maxRegion && v.tag.VariantOrPrivateUseTags() == n.tag.VariantOrPrivateUseTags()) {
				var i = i0;
				while (haveTags[i].nextMax != 0)
					i = haveTags[i].nextMax;
				haveTags[i].nextMax = haveTags.length & 0xffff;
				break;
			}
		}
		haveTags.push(n.copy()); // Go: &n of the by-value parameter
	}
}

// haveTag holds a supported Tag and its maximized script and region. The maximized
// or canonicalized language is not stored as it is not needed during matching.
class HaveTag {
	public var tag:ITag = L.Und();

	// index of this tag in the original list of supported tags.
	public var index:Int = 0;

	// conf is the maximum confidence that can result from matching this haveTag.
	// When conf < Exact this means it was inserted after applying a CLDR equivalence rule.
	public var conf:Confidence = Confidence.No;

	// Maximized region and script.
	public var maxRegion:Region = 0;
	public var maxScript:Script = 0;

	// altScript may be checked as an alternative match to maxScript. If altScript
	// matches, the confidence level for this match is Low. Theoretically there
	// could be multiple alternative scripts. This does not occur in practice.
	public var altScript:Script = 0;

	// nextMax is the index of the next haveTag with the same maximized tags.
	public var nextMax:Int = 0;

	public function new() {}

	public function copy():HaveTag {
		final h = new HaveTag();
		h.tag = tag;
		h.index = index;
		h.conf = conf;
		h.maxRegion = maxRegion;
		h.maxScript = maxScript;
		h.altScript = altScript;
		h.nextMax = nextMax;
		return h;
	}
}

// bestMatch accumulates the best match so far.
class BestMatch {
	public var have:Null<HaveTag> = null;
	public var want:ITag = L.Und();
	public var conf:Confidence = Confidence.No;
	public var pinnedRegion:Region = 0;
	public var pinLanguage:Bool = false;
	public var sameRegionGroup:Bool = false;
	// Cached results from applying tie-breaking rules.
	public var origLang:Bool = false;
	public var origReg:Bool = false;
	public var paradigmReg:Bool = false;
	public var regGroupDist:Int = 0;
	public var origScript:Bool = false;

	public function new() {}

	// update updates the existing best match if the new pair is considered to be a
	// better match. To determine if the given pair is a better match, it first
	// computes the rough confidence level. If this surpasses the current match, it
	// will replace it and update the tie-breaker rule cache. If there is a tie, it
	// proceeds with applying a series of tie-breaker rules. If there is no
	// conclusive winner after applying the tie-breaker rules, it leaves the current
	// match as the preferred match.
	public function update(have:HaveTag, tag:ITag, maxScript:Script, maxRegion:Region, pin:Bool):Void {
		// Bail if the maximum attainable confidence is below that of the current best match.
		var c = have.conf;
		if (c < conf)
			return;
		// Don't change the language once we already have found an exact match.
		if (pinLanguage && tag.LangID != want.LangID)
			return;
		// Pin the region group if we are comparing tags for the same language.
		if (tag.LangID == want.LangID && sameRegionGroup) {
			final sameGroup = Language.regionGroupDist(pinnedRegion, have.maxRegion, have.maxScript, want.LangID).b;
			if (!sameGroup)
				return;
		}
		if (c == Confidence.Exact && have.maxScript == maxScript) {
			// If there is another language and then another entry of this language,
			// don't pin anything, otherwise pin the language.
			pinLanguage = pin;
		}
		if (Language.equalsRest(have.tag, tag)) {} else if (have.maxScript != maxScript) {
			// There is usually very little comprehension between different scripts.
			// In a few cases there may still be Low comprehension. This possibility
			// is pre-computed and stored in have.altScript.
			if (Confidence.Low < conf || have.altScript != maxScript)
				return;
			c = Confidence.Low;
		} else if (have.maxRegion != maxRegion) {
			if (Confidence.High < c) {
				// There is usually a small difference between languages across regions.
				c = Confidence.High;
			}
		}

		// We store the results of the computations of the tie-breaker rules along
		// with the best match. There is no need to do the checks once we determine
		// we have a winner, but we do still need to do the tie-breaker computations.
		// We use "beaten" to keep track if we still need to do the checks.
		var beaten = false; // true if the new pair defeats the current one.
		if (c != conf) {
			if (c < conf)
				return;
			beaten = true;
		}

		// Tie-breaker rules:
		// We prefer if the pre-maximized language was specified and identical.
		final origLang = have.tag.LangID == tag.LangID && tag.LangID != 0;
		if (!beaten && this.origLang != origLang) {
			if (this.origLang)
				return;
			beaten = true;
		}

		// We prefer if the pre-maximized region was specified and identical.
		final origReg = have.tag.RegionID == tag.RegionID && tag.RegionID != 0;
		if (!beaten && this.origReg != origReg) {
			if (this.origReg)
				return;
			beaten = true;
		}

		final rg = Language.regionGroupDist(have.maxRegion, maxRegion, maxScript, tag.LangID);
		final regGroupDist = rg.a;
		final sameGroup = rg.b;
		if (!beaten && this.regGroupDist != regGroupDist) {
			if (regGroupDist > this.regGroupDist)
				return;
			beaten = true;
		}

		final paradigmReg = Language.isParadigmLocale(tag.LangID, have.maxRegion);
		if (!beaten && this.paradigmReg != paradigmReg) {
			if (!paradigmReg)
				return;
			beaten = true;
		}

		// Next we prefer if the pre-maximized script was specified and identical.
		final origScript = have.tag.ScriptID == tag.ScriptID && tag.ScriptID != 0;
		if (!beaten && this.origScript != origScript) {
			if (this.origScript)
				return;
			beaten = true;
		}

		// Update m to the newly found best match.
		if (beaten) {
			this.have = have;
			this.want = tag;
			this.conf = c;
			this.pinnedRegion = maxRegion;
			this.sameRegionGroup = sameGroup;
			this.origLang = origLang;
			this.origReg = origReg;
			this.paradigmReg = paradigmReg;
			this.origScript = origScript;
			this.regGroupDist = regGroupDist;
		}
	}
}
