package go;

#if macro
import haxe.io.Bytes;
import haxe.io.BytesBuffer;
import haxe.macro.Compiler;
import haxe.macro.Context;

// PORT: python — build setup of the Python target, applied by go.NilRange.apply() (tools/haxe) when
// the target is Python (docs/PORTING.md §7b):
// 1. Class path std-py/ and std-py/shared/: copies of a few Haxe std modules that keep strings in
//    UTF-16 form (see std-py/python/U16.hx), give IEEE 754 results in Math, and exit at once
//    (Sys.exit).
// 2. After generation, rewrites the .py file:
//    - every character above U+FFFF in the output (only string literals have them) becomes the
//      Python escapes of its UTF-16 surrogate pair (backslash, u, 4 hex digits; twice), so
//      literals are in UTF-16 form too;
//    - the final `<Main>.main()` call runs main() in a thread with a 512 MB stack and a high
//      recursion limit (deeply nested inputs recurse deeply, like on the other targets);
//    - the program moves to <name>-body.py, and <name>.py becomes a stub that imports it with a
//      bytecode cache (see the end of postProcess).
class PyTarget {
	public static function apply():Void {
		// std-py/ (python.* modules: StringImpl must be on the class path before String loads) comes
		// from hx_build (`-cp std-py`, tools/targets.sh). std-py/shared/ holds std modules that the macro
		// context loads too (Math, Sys, sys.io.File, ...): added here, for the target context only.
		final u16 = Context.resolvePath("python/U16.hx");
		if (u16 == null)
			Context.fatalError("Python builds need -cp std-py (see tools/targets.sh)", Context.currentPos());
		final dir = haxe.io.Path.directory(haxe.io.Path.directory(sys.FileSystem.absolutePath(u16)));
		Compiler.addClassPath(dir + "/shared");
		Context.onAfterGenerate(postProcess);
	}

	static final boot = "
def _hx_go_run(main):
    import sys, threading, traceback
    sys.setrecursionlimit(2000000)
    threading.stack_size(512 * 1024 * 1024)
    status = [0]
    def run():
        try:
            main()
        except SystemExit as e:
            status[0] = e.code if isinstance(e.code, int) else (0 if e.code is None else 1)
        except BaseException:
            traceback.print_exc()
            status[0] = 1
    t = threading.Thread(target=run)
    t.start()
    t.join()
    sys.stdout.flush()
    sys.stderr.flush()
    sys.exit(status[0])
";

	static function postProcess():Void {
		final out = Compiler.getOutput();
		if (!sys.FileSystem.exists(out))
			return;
		final b = sys.io.File.getBytes(out);
		final buf = new BytesBuffer();
		var i = 0;
		while (i < b.length) {
			final c = b.get(i);
			if (c >= 0xF0 && c <= 0xF4 && i + 3 < b.length) {
				final cp = ((c & 0x07) << 18) | ((b.get(i + 1) & 0x3F) << 12) | ((b.get(i + 2) & 0x3F) << 6) | (b.get(i + 3) & 0x3F);
				final v = cp - 0x10000;
				buf.addString("\\u" + StringTools.hex(0xD800 + (v >> 10), 4).toLowerCase() + "\\u" + StringTools.hex(0xDC00 + (v & 0x3FF), 4).toLowerCase());
				i += 4;
				continue;
			}
			buf.addByte(c);
			i++;
		}
		var text = buf.getBytes().toString();
		// The main call is the last top-level statement, or the one before Haxe's event loop
		// (`sys_thread__Thread_Thread_Impl_.processEvents()`, which then runs after main).
		final main = ~/\n([A-Za-z0-9_]+)\.main\(\)\n((?:sys_thread__Thread_Thread_Impl_\.processEvents\(\)\n)?)\n*$/;
		if (main.match(text)) {
			text = main.matchedLeft() + "\n" + boot + "\n_hx_go_run(" + main.matched(1) + ".main)\n" + main.matched(2);
		} else {
			Context.fatalError("go.PyTarget: main call not found in " + out, Context.currentPos());
		}
		// The program goes to <name>-body.py; <name>.py becomes a stub that imports it through
		// importlib, which caches the bytecode in __pycache__/. Python never caches the script it
		// runs, and compiling the ~11 MB module costs about 2.8 s and 900 MB on every start.
		// The body sees the stub's __file__, so Haxe's resource files (<name>.py.<resource>) are found.
		final base = haxe.io.Path.withoutDirectory(out);
		final bodyName = (StringTools.endsWith(base, ".py") ? base.substr(0, base.length - 3) : base) + "-body.py";
		final body = haxe.io.Path.join([haxe.io.Path.directory(out), bodyName]);
		sys.io.File.saveContent(body, text);
		// Compile the cache now: parallel gate processes would otherwise all compile it at once.
		final python = Sys.getEnv("PYTHON") != null ? Sys.getEnv("PYTHON") : "python3";
		if (Sys.command(python, ["-c", "import py_compile, sys; py_compile.compile(sys.argv[1], doraise=True)", body]) != 0)
			Context.fatalError("go.PyTarget: py_compile failed for " + body, Context.currentPos());
		sys.io.File.saveContent(out, '# Generated by go.PyTarget: runs $bodyName with a bytecode cache.
import importlib.util, os, sys
_hx_spec = importlib.util.spec_from_file_location("_hx_main", os.path.join(os.path.dirname(os.path.abspath(__file__)), "$bodyName"))
_hx_module = importlib.util.module_from_spec(_hx_spec)
_hx_module.__file__ = os.path.abspath(__file__)
sys.modules["_hx_main"] = _hx_module
_hx_spec.loader.exec_module(_hx_module)
');
	}
}
#end
